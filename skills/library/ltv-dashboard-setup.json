    "formulas": [
      {
        "denominator": "队列起点冻结的去重合格用户数。",
        "expression": "ltv_{c,t} = cumulative_net_revenue_{c,t} / fixed_eligible_users_c",
        "formula_id": "dashboard-ltv-metric",
        "interpretation": "这是看板指标合同，不证明看板已创建，也不允许用动态活跃人数替代固定队列。",
        "numerator": "队列 c 截至观察龄 t 的已封账累计净收入。",
        "requires_project_calibration": [
          "ltv-metric-definition",
          "ltv-view-contract",
          "ltv-alert-design"
