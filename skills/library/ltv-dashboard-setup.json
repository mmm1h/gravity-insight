            "definition": "支付成功减批准退款的同币种累计收入。",
            "distinct_by": "transaction-id",
            "symbol": "cumulative_net_revenue"
          },
          {
            "aggregation": "用户去重计数",
            "definition": "队列起点冻结的合格用户集合。",
            "distinct_by": "stable-user-id",
            "symbol": "fixed_eligible_users"
          }
        ],
        "window": "每个展示节点按相同观察龄和封账状态计算。"
