    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "upstream-empty",
          "checks": [
            "核对数据源可用性与允许延迟。",
            "核对指标绑定和时间范围是否有效。"
          ],
          "condition": "最小控制查询也无返回。",
          "leaves": [
            {
              "conclusion": "确认数据未成熟并给出可复验时间。",
              "condition": "窗口尚未达到项目封账或延迟边界。",
              "exclusions": [
                "不得称为采集故障。"
              ],
              "leaf_id": "source-not-mature"
            },
            {
              "conclusion": "确认绑定缺口。",
              "condition": "指标或数据源绑定缺失、失效或超出生效期。",
              "exclusions": [
                "不得从相似字段自动替代。"
              ],
              "leaf_id": "binding-unresolved"
            }
          ]
        },
        {
          "branch_id": "constraint-eliminates-result",
          "checks": [
            "按时间、过滤、分组和可见性顺序逐项加入。",
            "比较配置引用与当前合同版本。"
          ],
          "condition": "控制查询有返回，但增加某约束后为空。",
          "leaves": [
            {
              "conclusion": "确认过滤组合消除返回。",
              "condition": "某过滤值不在当前返回域或与其他过滤冲突。",
              "exclusions": [
                "不自动删除过滤条件。"
              ],
              "leaf_id": "filter-domain-empty"
            },
            {
              "conclusion": "确认展示链路缺口。",
              "condition": "查询有数据但组件引用或可见性证据不满足。",
              "exclusions": [
                "不得静默推断成员权限或浏览器状态。"
              ],
              "leaf_id": "visibility-or-reference-gap"
            }
          ]
        }
      ],
      "root_question": "最小控制查询是否返回数据，若返回，哪个新增约束首先消除了结果？"
    },
    "dimension_scan": {
      "baseline": "使用同一组件定义的最小无筛选控制查询作基准，不跨组件比较行数。",
      "contribution_formula": "loss_k = rows_before_stage_k - rows_after_stage_k; contribution_k = loss_k / rows_at_control",
