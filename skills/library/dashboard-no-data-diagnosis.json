  "description": "通过核对已注册查询结果与确切的仪表盘定义和时间范围，诊断无数据显示。",
  "effects": [
    "read"
  ],
  "guide": {
    "applicability": "当项目能够提供版本化的仪表盘定义及其底层受治理分析身份时使用。",
    "context_boundary": "布局和 UI 状态不是 Runtime 事实；缺少仪表盘配置时，不得断言页面为何为空。",
    "steps": [
      "解析仪表盘定义、来源分析、筛选条件、时区和预期数据时间窗。",
      "将受治理来源的状态、完整性和质量与已配置的筛选及绑定预期进行比较。",
      "对有证据支持的空数据、数据过期、权限、绑定或契约缺口进行分类；仅涉及 UI 的原因仍标为未验证。"
    ],
    "title": "仪表盘证据缺口诊断"
  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "按最早失败阶段归类候选根因；后续故障不重复计入主要断点。"
      ],
      "cohort": [
        "筛选人群、成员权限和行级范围分别记录，不把不可见推断为无数据。"
      ],
      "inputs": [
        "输入包含看板或组件稳定 ID、版本、数据源、指标、分组、过滤、时间范围和调用者可见性证据。"
      ],
      "requires_project_calibration": [
        {
          "calibration_id": "dashboard-definition",
          "subject": "组件、查询、过滤和数据源的权威版本。"
        },
        {
          "calibration_id": "data-latency-sla",
          "subject": "各数据源允许延迟和封账规则。"
        }
      ],
      "time": [
        "时间范围按看板业务时区解析，并与数据延迟和封账窗口比较。"
      ],
      "unit": [
        "诊断只比较返回行数、过滤存活率和配置覆盖，不改变原指标单位。"
      ]
    },
    "business_question": "看板或组件无返回是由上游数据为空、时间与过滤条件、字段绑定、权限可见性还是配置引用失效造成，最早可证实的断点在哪里？",
    "data_checks": {
      "completeness": [
        "看板定义和数据源引用来自同一版本快照。",
        "最小控制查询与逐层约束结果都有返回范围证据。"
      ],
      "data_quality": [
        "过滤类型、枚举、时区和字段绑定符合合同。",
        "诊断期间配置快照未变化且同一查询可重复。"
      ],
      "failure_behavior": "任一必需检查失败时停止诊断和建议，按 Empty、Partial、Error 或 Gap 输出空结论、原因码与精确补救动作。"
    },
    "dependency_status": [
