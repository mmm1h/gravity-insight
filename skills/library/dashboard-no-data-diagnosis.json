    "formulas": [
      {
        "denominator": "增加该约束前同一查询范围的返回行数。",
        "expression": "survival_k = rows_after_stage_k / rows_before_stage_k",
        "formula_id": "filter-survival-rate",
        "interpretation": "存活率归零定位最早消除返回的阶段，不单独证明该阶段配置错误。",
        "numerator": "增加第 k 个时间、过滤、分组或绑定约束后明确返回的行数。",
        "requires_project_calibration": [
