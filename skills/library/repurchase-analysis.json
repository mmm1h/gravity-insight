    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "maturity-or-opportunity-gap",
          "checks": [
            "逐队列验证完整观察机会。",
            "核对商品可售和到期状态。"
          ],
          "condition": "下降与未成熟队列、到期结构或无可比复购机会重合。",
          "leaves": [
            {
              "conclusion": "移出正式分母并标记未成熟。",
              "condition": "部分首购用户尚未走完复购窗。",
              "exclusions": [
                "不得把尚未复购计为最终不复购。"
              ],
              "leaf_id": "right-censoring"
            },
            {
              "conclusion": "报告机会缺口。",
              "condition": "商品下架、库存或资格使用户无可比机会。",
              "exclusions": [
                "不得解释为用户拒绝。"
              ],
              "leaf_id": "missing-repeat-opportunity"
            }
          ]
        },
        {
          "branch_id": "returned-repurchase-structure-gap",
          "checks": [
            "比较间隔分布和商品迁移。",
            "核对触达与支付链路。"
          ],
          "condition": "成熟且机会可比，差异集中于商品、价格带、间隔或分层。",
          "leaves": [
            {
              "conclusion": "报告节奏变化。",
              "condition": "复购仍发生但间隔整体右移。",
              "exclusions": [
                "不得按固定截止日夸大流失。"
              ],
              "leaf_id": "interval-or-timing-shift"
            },
            {
              "conclusion": "提出供给、价格或触达假设。",
              "condition": "差异集中于特定返回商品或分层。",
              "exclusions": [
                "需要实验或独立证据验证原因。"
              ],
              "leaf_id": "product-or-segment-association"
            }
          ]
        }
      ],
      "root_question": "复购变化在排除右删失和机会差异后，主要集中于哪些返回商品、间隔或分层？"
