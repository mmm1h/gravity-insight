    "formulas": [
      {
        "denominator": "候选版本采集方案中全部必需事件和属性项。",
        "expression": "conformance = conforming_contract_items / required_contract_items",
        "formula_id": "contract-conformance-rate",
        "interpretation": "符合率为一只表示观察到的候选样本满足方案，不证明生产环境或所有业务路径已经完成。",
        "numerator": "在命名、类型、来源、触发时机和必填性上均通过的必需事件或属性项。",
        "requires_project_calibration": [
          "tracking-plan-version",
          "critical-field-threshold",
          "release-blocking-policy"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "按合同项去重计数",
            "definition": "所有合同检查均通过的必需项。",
            "distinct_by": "contract-item-id",
            "symbol": "conforming_contract_items"
          },
          {
            "aggregation": "按合同项去重计数",
            "definition": "方案声明的全部必需项。",
            "distinct_by": "contract-item-id",
            "symbol": "required_contract_items"
          }
