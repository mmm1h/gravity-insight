        ],
        "instruction": "按相同范围收集测试返回、方案清单、组件配置、来源日志和验证回读，保留请求或产物摘要、时间窗、返回范围和来源证据。",
        "on_failure": "METHOD_QUERY_ERROR",
        "step_id": "collect-evidence"
      },
