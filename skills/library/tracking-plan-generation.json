  "description": "适用于新功能或新产品在开发前形成可评审的埋点合同，覆盖业务目标、核心循环、事件、属性、公共属性、用户属性、类型、隐私与验收用例。",
  "effects": [
    "read"
  ],
  "guide": {
    "applicability": "适用于新功能或新产品在开发前形成可评审的埋点合同，覆盖业务目标、核心循环、事件、属性、公共属性、用户属性、类型、隐私与验收用例。",
    "context_boundary": "项目口径、物理字段、真实事件和授权边界必须来自版本化项目契约；缺失时只报告 Gap，不猜值、不改线上配置。",
    "steps": [
      "从项目需求锁定业务目标、核心流程、实体、状态和分析问题。",
      "把每个可观测状态变化映射为事件、属性和唯一触发时机。",
      "校验命名、类型、枚举、来源、隐私、去重和版本演进规则。",
      "输出可评审方案与验收用例，不上传平台或生成生产代码。"
    ],
    "title": "埋点方案生成"
  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "来源端选择基于事实所有权和防篡改要求；方案不声明未来分析效果或数据完整性。"
      ],
      "cohort": [
        "用户、账号、设备、订单、会话等实体身份明确，游客和登录后行为的归并规则由项目定义。"
      ],
      "inputs": [
        "输入包含业务目标、用户流程、实体状态、收入或核心循环、分析问题、来源端和隐私分类。"
      ],
      "requires_project_calibration": [
        {
          "calibration_id": "business-question-set",
          "subject": "方案必须支持的获批分析问题。"
        },
        {
          "calibration_id": "naming-and-type-policy",
          "subject": "事件属性命名、类型、单位和枚举演进规则。"
        },
        {
          "calibration_id": "privacy-classification",
          "subject": "字段隐私级别、最小化和禁止采集项。"
        },
        {
          "calibration_id": "source-of-truth-policy",
          "subject": "客户端、服务端或离线来源责任。"
        }
      ],
      "time": [
        "触发时机使用业务动作完成或状态确认点，客户端意图时间与服务端确认时间分开。"
      ],
      "unit": [
        "金额、时长、数量、比例和枚举的类型与单位在方案阶段锁定，不能用字符串占位。"
      ]
    },
    "business_question": "获批产品流程中的哪些可观测状态变化必须形成事件合同，事件、属性、来源、触发时机、类型、隐私和验收规则能否完整支撑明确分析问题？",
    "data_checks": {
      "completeness": [
        "每个获批分析问题映射到事件、属性、实体、时间和验收用例。",
        "关键流程的成功、失败、取消和退出路径均有明确状态。"
      ],
      "data_quality": [
        "命名、类型、单位、枚举、幂等和来源责任无冲突。",
        "隐私分类、数据最小化和禁止采集规则逐字段通过。"
      ],
      "failure_behavior": "任一必需检查失败时停止诊断和建议，按 Empty、Partial、Error 或 Gap 输出空结论、原因码与精确补救动作。"
    },
    "dependency_status": [
      {
        "evidence": "该 URI 的定义、物理绑定、生效窗口与负责人由调用项目提供；Runtime 不从字段名推断。",
        "identity": "schema://project/tracking-plan@1",
        "kind": "semantic",
        "reason_code": "SEMANTIC_DEFINITION_MISSING",
        "status": "requires_project_binding"
      },
      {
        "evidence": "该业务事实由调用项目的版本化 Context Provider 提供，缺失时在查询前返回 Gap。",
        "identity": "context://project/product-requirements@1",
        "kind": "context",
        "reason_code": "CONTEXT_REQUIRED_MISSING",
        "status": "requires_project_context"
      },
      {
        "evidence": "该业务事实由调用项目的版本化 Context Provider 提供，缺失时在查询前返回 Gap。",
        "identity": "context://project/privacy-classification@1",
        "kind": "context",
        "reason_code": "CONTEXT_REQUIRED_MISSING",
        "status": "requires_project_context"
      }
    ],
    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "observability-gap",
          "checks": [
            "从业务问题反推实体与状态变化。",
            "检查入口、成功、失败和退出路径。"
          ],
          "condition": "业务问题或关键状态转移没有可观测事件路径。",
          "leaves": [
            {
              "conclusion": "提出事件合同候选。",
              "condition": "关键状态变化没有唯一事件。",
              "exclusions": [
                "不得用页面曝光代替业务成功。"
              ],
              "leaf_id": "missing-state-transition"
            },
            {
              "conclusion": "提出最小属性候选。",
              "condition": "问题所需分组或关联实体没有合规属性。",
              "exclusions": [
                "不得采集超出问题需要的个人信息。"
              ],
              "leaf_id": "missing-analysis-dimension"
            }
          ]
        },
        {
          "branch_id": "contract-quality-gap",
          "checks": [
            "验证命名类型和枚举演进。",
            "核对事实所有权、幂等和隐私最小化。"
          ],
          "condition": "事件存在但命名、类型、来源、触发或隐私合同不完整。",
          "leaves": [
            {
              "conclusion": "要求在开发前锁定类型和确认点。",
              "condition": "属性类型或事件触发时机不唯一。",
              "exclusions": [
                "不得用首次上报决定权威类型。"
              ],
              "leaf_id": "type-or-trigger-ambiguity"
            },
            {
              "conclusion": "报告来源或隐私冲突并阻止交付。",
              "condition": "来源端不拥有事实或字段违反隐私分类。",
              "exclusions": [
                "不得通过换名保留禁止字段。"
              ],
              "leaf_id": "source-or-privacy-conflict"
            }
          ]
        }
      ],
      "root_question": "每个获批分析问题是否能追溯到一组最小、明确且合规的事件与属性合同？"
    },
    "dimension_scan": {
      "baseline": "以获批分析问题和完整业务流程为基准，每个事件对应一个不可歧义的状态变化。",
      "contribution_formula": "gap_share_s = unsupported_questions_or_conflicts_s / total_unsupported_questions_or_conflicts",
      "dimensions": [
        {
          "dimension_id": "business-module",
          "label": "业务模块"
        },
        {
          "dimension_id": "lifecycle-stage",
          "label": "生命周期阶段"
        },
        {
          "dimension_id": "contract-kind",
          "label": "合同类型"
        },
        {
          "dimension_id": "source-end",
          "label": "来源端"
        }
      ],
      "minimum_volume_rule": "没有明确业务问题或触发时机的候选事件不进入正式方案，只保留待澄清项。",
      "ranking_rule": "先排核心业务问题和不可恢复类型或隐私冲突，再排命名、枚举和便利性缺口。",
      "residual_policy": "未决需求、项目专属枚举、真实活动名和来源责任保留为待填模板，不猜值。"
    },
