    ],
    "formulas": [
      {
        "denominator": "返回计划中所有可比较节点的同类成本之和。",
        "expression": "cost_share_n = node_cost_n / sum(node_cost_returned)",
        "formula_id": "plan-cost-share",
        "interpretation": "占比用于定位计划热点，不等同实际运行时间，也不保证候选改写提速。",
        "numerator": "执行计划中节点 n 的同类估算成本或有界观测成本。",
        "requires_project_calibration": [
          "sql-dialect",
          "partition-contract",
          "equivalence-policy"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "计划值读取",
            "definition": "目标计划节点的成本值。",
            "distinct_by": "plan-node-id",
            "symbol": "node_cost"
          },
          {
            "aggregation": "同类成本求和",
            "definition": "所有可比较返回节点成本总和。",
            "distinct_by": "plan-node-id",
            "symbol": "total_returned_node_cost"
          }
        ],
        "window": "同一计划快照、参数集和统计版本。"
      }
    ],
    "handoff": {
