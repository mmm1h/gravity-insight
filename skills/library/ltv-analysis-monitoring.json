    "formulas": [
      {
        "denominator": "队列起点固定的去重合格用户数。",
        "expression": "ltv_{c,t} = cumulative_net_revenue_{c,t} / fixed_eligible_users_c",
        "formula_id": "observed-cumulative-ltv",
        "interpretation": "该值是指定观察龄的已实现价值，不是未观测终身价值或未来保证。",
        "numerator": "队列 c 从起点到观察龄 t 已封账的累计净收入。",
        "requires_project_calibration": [
          "ltv-contract",
          "cohort-maturity",
          "ltv-alert-policy"
        ],
        "unit": "项目币种/用户",
        "variables": [
          {
            "aggregation": "金额求和",
            "definition": "支付成功减批准退款后的同币种累计收入。",
            "distinct_by": "transaction-id",
            "symbol": "cumulative_net_revenue"
          },
          {
            "aggregation": "用户去重计数",
            "definition": "队列起点的固定合格用户集合。",
            "distinct_by": "stable-user-id",
            "symbol": "fixed_eligible_users"
          }
        ],
        "window": "按队列年龄 t 对齐，收入迟到和退款按项目封账。"
      }
    ],
