    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "maturity-or-accounting-gap",
          "checks": [
            "逐队列核对成熟状态。",
            "重算净收入和固定分母。"
          ],
          "condition": "异常与队列年龄、支付封账、退款或币种处理差异重合。",
          "leaves": [
            {
              "conclusion": "降级为未成熟观察。",
              "condition": "当前队列尚未达到比较观察龄。",
              "exclusions": [
                "不得拿短龄值与成熟历史直接比较。"
              ],
              "leaf_id": "immature-cohort"
            },
            {
              "conclusion": "报告收入合同缺口。",
              "condition": "支付、退款或币种无法回算。",
              "exclusions": [
                "不得把未封账金额补零。"
              ],
              "leaf_id": "revenue-reconciliation-gap"
            }
          ]
        },
        {
          "branch_id": "returned-value-structure-change",
          "checks": [
            "分解付费结构。",
            "比较来源、版本和分层贡献。"
          ],
          "condition": "口径稳定且付费人数、频次、客单或退款解释主要变化。",
          "leaves": [
            {
              "conclusion": "报告返回结构变化。",
              "condition": "付费人数或频次贡献占主导。",
              "exclusions": [
                "不得声称某动作导致。"
              ],
              "leaf_id": "payer-base-or-frequency"
            },
            {
              "conclusion": "定位返回商品或分层。",
              "condition": "客单或退款贡献占主导。",
              "exclusions": [
                "不得由均值直接给定价结论。"
              ],
              "leaf_id": "ticket-or-refund-shift"
            }
          ]
        }
      ],
      "root_question": "LTV 变化能否由固定队列分母与净收入组件完整回算，且越过项目持续告警门槛？"
    },
    "dimension_scan": {
      "baseline": "以相同观察龄、封账和队列资格的历史带作为基线。",
      "contribution_formula": "contribution_k = component_change_k / returned_total_ltv_change",
