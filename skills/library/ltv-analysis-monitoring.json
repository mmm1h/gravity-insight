  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "队列 LTV 变化是观测事实，驱动因素是分解贡献而非因果归因。"
      ],
      "cohort": [
        "自然量、再营销、回流、测试账号和跨端身份按项目规则处理。"
      ],
      "inputs": [
        "输入含队列资格、稳定用户键、支付、退款、币种、观察龄和允许分层。"
      ],
      "requires_project_calibration": [
