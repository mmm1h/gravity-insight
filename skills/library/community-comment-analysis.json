    "exclusions": [
      "不得生成、润色或拼接用户语录。",
      "不得推断个人心理、身份或意图。",
      "单一评论区不代表完整社区人口。",
      "过滤规则变化必须伴随版本和敏感性报告。"
    ],
    "formulas": [
      {
        "denominator": "按批准过滤和分类规则保留的有效去重评论总数。",
        "expression": "share_k = valid_comments_k / valid_comments",
        "formula_id": "comment-theme-share",
        "interpretation": "份额只描述该目标评论区的返回内容。",
        "numerator": "归入观点簇 k 的有效去重评论数。",
        "requires_project_calibration": [
          "comment-filter-policy",
          "sentiment-taxonomy",
          "theme-taxonomy"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "去重计数",
            "definition": "指定观点簇的有效评论。",
            "distinct_by": "comment-id",
            "symbol": "valid_comments_theme"
          },
          {
            "aggregation": "去重计数",
            "definition": "所有有效且可分类评论。",
            "distinct_by": "comment-id",
            "symbol": "valid_comments"
          }
        ],
        "window": "同一目标内容和闭合观察窗。"
      }
    ],
