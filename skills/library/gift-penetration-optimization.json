            {
              "conclusion": "列为内容适配候选。",
              "condition": "价格可比但内容与进度需求不匹配。",
              "exclusions": [
                "没有商品实验不得声称改版有效。"
              ],
              "leaf_id": "content-fit-gap"
            }
          ]
