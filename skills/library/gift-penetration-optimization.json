            "比较同价位内容和有效期。"
          ],
          "condition": "触达充分但购买渗透仍低。",
          "leaves": [
            {
              "conclusion": "列为价格档位候选。",
              "condition": "目标层历史购买集中于不同价格带。",
              "exclusions": [
                "不得称最优定价。"
              ],
              "leaf_id": "price-band-gap"
