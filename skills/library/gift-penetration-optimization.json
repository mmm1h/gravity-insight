    "formulas": [
      {
        "denominator": "同窗同分层内满足项目资格的去重用户数。",
        "expression": "penetration_s = distinct_buyers_s / distinct_eligible_users_s",
        "formula_id": "gift-penetration",
        "interpretation": "分层加权可回算大盘，但不证明候选设计会提升渗透。",
        "numerator": "分层 s 内至少购买一次目标礼包的去重用户数。",
        "requires_project_calibration": [
          "gift-eligibility",
          "payment-segments",
          "penetration-threshold"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "用户去重计数",
            "definition": "购买目标礼包且满足资格的用户集合。",
            "distinct_by": "stable-user-id",
            "symbol": "distinct_buyers"
          },
          {
            "aggregation": "用户去重计数",
            "definition": "目标人群中未命中排除的用户集合。",
            "distinct_by": "stable-user-id",
            "symbol": "distinct_eligible_users"
          }
        ],
        "window": "商品有效且数据封账的当前窗与基准窗。"
