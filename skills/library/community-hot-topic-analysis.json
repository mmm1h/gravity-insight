    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "volume-trigger",
          "checks": [
            "定位首个越阈时间桶与主要渠道。",
            "核对重复转发和单一账号放大。"
          ],
          "condition": "讨论量显著越过渠道基线并形成峰值。",
          "leaves": [
            {
              "conclusion": "确认跨渠道扩散的观测事实。",
              "condition": "多个独立渠道在相邻时间段同向增长。",
              "exclusions": [
                "同步增长不证明共同外部事件导致。"
              ],
              "leaf_id": "broad-spread"
            },
            {
              "conclusion": "确认渠道集中并限制外推范围。",
              "condition": "增量主要来自一个渠道或少数内容源。",
              "exclusions": [
                "未覆盖渠道不得视为无讨论。"
              ],
              "leaf_id": "channel-concentrated"
            }
          ]
        },
        {
          "branch_id": "sentiment-reversal",
          "checks": [
            "比较转折前后同渠道同分类器结果。",
            "追溯代表内容和项目 Context 节点。"
          ],
          "condition": "情感占比或观点结构跨过项目转折门槛。",
          "leaves": [
            {
              "conclusion": "确认观点组合转移。",
              "condition": "观点簇份额变化解释情感结构变化。",
              "exclusions": [
                "分类器或话题检索版本变化时结论无效。"
              ],
              "leaf_id": "viewpoint-mix-shift"
            },
            {
              "conclusion": "报告与回应相邻的观测变化。",
              "condition": "项目回应后情感结构变化且时间证据相邻。",
              "exclusions": [
                "没有对照或反事实时不得声称回应产生效果。"
              ],
              "leaf_id": "response-associated-shift"
            }
          ]
        }
      ],
      "root_question": "话题的量和情感结构在何时发生可重复识别的变化？"
    },
    "dimension_scan": {
      "baseline": "以话题出现前的同渠道常态量和分类结构为基准，跨渠道绝对量仅在采集覆盖可比时比较。",
      "contribution_formula": "volume_contribution_s = (items_s - baseline_items_s) / sum(items_returned - baseline_items_returned)",
