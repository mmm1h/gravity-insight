            "aggregation": "时间戳",
            "definition": "事件 i 经时间政策归一后的时间戳。",
            "distinct_by": "event-id",
            "symbol": "event_time_current"
          },
          {
            "aggregation": "时间戳",
            "definition": "前一去重事件经归一后的时间戳。",
            "distinct_by": "event-id",
            "symbol": "event_time_previous"
          }
