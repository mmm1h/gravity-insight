    "formulas": [
      {
        "denominator": "公式无数值分母；从当前时间戳减去前一去重事件时间戳。",
        "expression": "gap_i = event_time_i - event_time_{i-1}",
        "formula_id": "ordered-event-gap",
        "interpretation": "间隔可用于标记会话或序列断点，但不能证明用户离开原因或缺失事件不存在。",
        "numerator": "当前返回事件 i 的项目标准时间戳。",
        "requires_project_calibration": [
          "subject-access",
          "identity-timeline",
          "sessionization"
        ],
        "unit": "时间单位",
        "variables": [
