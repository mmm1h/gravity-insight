    "formulas": [
      {
        "denominator": "项目业务问题要求覆盖的标签槽位总数。",
        "expression": "coverage = governed_tag_slots / required_tag_slots",
        "formula_id": "governed-tag-coverage",
        "interpretation": "覆盖率衡量设计完整性，不代表标签准确率、业务效果或可直接投产。",
        "numerator": "同时具备定义、来源、计算、刷新、责任和授权边界的标签槽位数。",
        "requires_project_calibration": [
          "tag-purpose",
          "tag-taxonomy",
          "tag-refresh"
