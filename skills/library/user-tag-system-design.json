    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "taxonomy-conflict",
          "checks": [
            "比较定义与取值域。",
            "验证继承、冲突和未知值规则。"
          ],
          "condition": "多个标签重复表达、边界交叉或无法形成互斥分层。",
          "leaves": [
            {
              "conclusion": "合并或重画边界并保留版本迁移说明。",
              "condition": "标签定义或人群范围高度重叠。",
              "exclusions": [
                "不得仅按名称相似判定重复。"
              ],
              "leaf_id": "duplicate-or-overlap"
            },
            {
              "conclusion": "增加显式残差并重新验证互斥完备性。",
              "condition": "分层无法覆盖未知或其他状态。",
              "exclusions": [
                "不得把未知值并入最接近业务类别。"
              ],
              "leaf_id": "missing-residual"
            }
          ]
        },
        {
          "branch_id": "implementation-governance-gap",
          "checks": [
            "追溯物理来源和有效期。",
            "核对责任人、用途和删除政策。"
          ],
          "condition": "业务含义成立，但来源、刷新、责任或授权字段不完整。",
          "leaves": [
            {
              "conclusion": "报告项目绑定缺口。",
              "condition": "必需事实或实体绑定缺失。",
              "exclusions": [
                "不得从字段名猜计算式。"
              ],
              "leaf_id": "uncomputable-tag"
            },
            {
              "conclusion": "阻止进入可发布目录。",
              "condition": "无责任人、用途越界或涉及禁止推断。",
              "exclusions": [
                "不得用业务价值覆盖治理要求。"
              ],
              "leaf_id": "unowned-or-unauthorized"
            }
          ]
        }
      ],
      "root_question": "候选标签是否同时具备明确用途、可计算定义、稳定来源、刷新责任和授权边界？"
    },
