    "formulas": [
      {
        "denominator": "队列 C 内按稳定用户键去重的合格获客用户数；一个用户只进入一个获客队列。",
        "expression": "cac(C) = attributable_acquisition_spend(C) / distinct_acquired_users(C)",
        "formula_id": "customer-acquisition-cost",
        "interpretation": "CAC 是指定队列的观测每用户获客成本；分母为零时未定义，未归因成本必须作为残差。",
        "numerator": "按项目成本范围和归因规则计入队列 C 的获客支出净额，统一换算到批准币种。",
        "requires_project_calibration": [
          "acquisition-cost-scope",
          "acquisition-attribution",
          "currency-policy"
        ],
        "unit": "批准币种每获客用户",
        "variables": [
          {
            "aggregation": "按队列求和",
            "definition": "项目批准范围内、归因到队列的获客支出。",
            "distinct_by": null,
            "symbol": "attributable_acquisition_spend"
          },
          {
            "aggregation": "按队列去重计数",
            "definition": "首次满足项目获客条件并归入队列的用户。",
            "distinct_by": "stable-user-id",
            "symbol": "distinct_acquired_users"
          }
        ],
        "window": "成本窗必须覆盖项目定义的完整获客归因期，并达到财务或投放账期封账条件。"
      },
      {
        "denominator": "队列 C 的去重获客用户数，整个队列年龄序列保持固定。",
        "expression": "cumulative_net_ltv(C,d) = (recognized_revenue_to_d - refunds_to_d - platform_fees_to_d - taxes_to_d - variable_service_cost_to_d) / distinct_acquired_users(C)",
        "formula_id": "cumulative-net-ltv",
        "interpretation": "该值是截至队列年龄 d 的累计净价值；扣减项由项目校准，观测值和模型预测值必须分栏。",
        "numerator": "截至队列年龄 d 的已确认收入，减去项目批准的退款、平台分成、税费和可变服务成本。",
        "requires_project_calibration": [
          "net-value-scope",
          "currency-policy"
        ],
        "unit": "批准币种每获客用户",
        "variables": [
          {
            "aggregation": "按队列与年龄累计求和",
            "definition": "收入扣除所有项目批准扣减项后的累计净价值。",
            "distinct_by": null,
            "symbol": "cumulative_net_value"
          },
          {
            "aggregation": "按队列去重计数",
            "definition": "队列入组时固定的去重获客用户数。",
            "distinct_by": "stable-user-id",
            "symbol": "distinct_acquired_users"
          }
        ],
        "window": "d 是从队列入组开始的完整年龄单位；观测截止与预测起点必须连续且不重叠。"
      },
      {
        "denominator": "同一队列、币种和成本范围下的 CAC 阈值。",
        "expression": "payback_age(C) = min(d in approved_horizon where projected_cumulative_net_ltv(C,d) >= cac(C))",
        "formula_id": "payback-age",
        "interpretation": "若已观测曲线交叉则报告最早观测年龄；否则仅在获批 Model 和 safe horizon 内报告情景区间，找不到交叉不等于永不回收。",
        "numerator": "按观测曲线或获批 Model 生成的队列累计净 LTV 序列。",
        "requires_project_calibration": [
          "ltv-safe-horizon",
          "payback-confidence-policy"
