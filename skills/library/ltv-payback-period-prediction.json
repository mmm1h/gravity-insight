    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "model-evidence-ready",
          "checks": [
            "确认成本与净价值 Semantic 已绑定且单位、队列、时间和归因兼容。",
            "确认 Model artifact 可信、已评估和批准，输入窗口及请求周期在安全域内。"
          ],
          "condition": "所有必需数据检查通过，Operator 可执行，Model 在请求日期与预测周期内获批。",
          "leaves": [
            {
              "conclusion": "累计净 LTV 已在成熟观测窗内覆盖 CAC，可报告最早观测回收年龄而非预测日期。",
              "condition": "存在最小队列年龄 d，使已观测 cumulative_net_ltv(d) >= cac，且此前所有年龄均未覆盖。",
              "exclusions": [
                "若成本账期未闭合或后续退款可显著改变累计净值，不得称已回收。",
                "若队列人数或币种在年龄序列中改变，不得使用该交叉点。"
              ],
              "leaf_id": "observed-crossing"
            },
            {
              "conclusion": "观测窗尚未回收，但获批 Model 在安全周期内给出交叉，可报告情景回收区间。",
              "condition": "观测年龄内 cumulative_net_ltv < cac，且获批预测分布在安全周期内首次覆盖 CAC。",
              "exclusions": [
                "若请求周期超过 Model safe horizon 或输入队列超出评估分布，不得报告预测交叉。",
                "若只得到单点预测且项目要求误差带，不得把单点写成确定日期。"
              ],
              "leaf_id": "projected-crossing"
            }
          ]
        },
        {
          "branch_id": "model-evidence-blocked",
          "checks": [
            "列出 Semantic、Operator、Model、Context、样本量和成熟度的逐项缺口。",
            "保留 CAC 与累计净 LTV 的可验证观测部分，不进行未批准外推。"
          ],
          "condition": "任一必需依赖、数据检查、模型审批、有效期或安全周期未满足。",
          "leaves": [
            {
              "conclusion": "在批准周期内没有得到可信交叉，只能报告未回收情景和剩余价值缺口。",
              "condition": "数据与模型可用，但所有获批情景在 safe horizon 内均有 cumulative_net_ltv < cac。",
              "exclusions": [
                "不得外推到安全周期之外并声称最终不会回收。",
                "若未来成本或净值口径预计改变，当前价值缺口不能代表未来策略结果。"
              ],
              "leaf_id": "no-crossing-in-horizon"
            },
            {
              "conclusion": "证据不足，返回 Gap 或 Partial，不提供回收年龄。",
              "condition": "Semantic、Context、Operator、Model、成本覆盖或价值成熟度至少一项缺失。",
              "exclusions": [
                "不得用收入趋势线、行业倍数或字段名替代缺失的项目口径和 Model。",
                "不得从其他队列的回收时间直接推断当前队列。"
              ],
              "leaf_id": "prediction-not-authorized"
            }
          ]
        }
      ],
      "root_question": "CAC 与累计净 LTV 是否使用兼容项目口径，且获批 Model 足以在安全预测周期内判断最早交叉？"
    },
