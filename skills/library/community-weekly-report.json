    "exclusions": [
      "不得把七份日报机械拼接成周报。",
      "不得虚构事件连接或用户语录。",
      "一周变化不等于长期趋势或因果。",
      "产品预警和合规风险必须分表。"
    ],
    "formulas": [
      {
        "denominator": "七个业务日全部可分类有效内容数。",
        "expression": "weekly_share_k = sum(classified_items_{d,k}) / sum(classified_items_d)",
        "formula_id": "weekly-weighted-share",
        "interpretation": "加权周份额避免低量日与高量日等权，不代表完整社区。",
        "numerator": "七个业务日中属于主题或情感 k 的有效内容总数。",
        "requires_project_calibration": [
          "weekly-window",
          "narrative-threshold",
          "community-risk-policy"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "跨日去重求和",
            "definition": "指定主题或情感的逐日有效内容。",
            "distinct_by": "content-id",
            "symbol": "classified_items_category"
          },
          {
            "aggregation": "跨日去重求和",
            "definition": "全部逐日有效分类内容。",
            "distinct_by": "content-id",
            "symbol": "classified_items_total"
          }
        ],
        "window": "连续七个已封账日，与可比上周对齐。"
      }
    ],
    "handoff": {
      "authorization_boundary": "本方法只生成分析结果或候选方案，不自动修改配置、数据、代码、受众、消息或生产系统。",
