  "description": "仅在明确来源覆盖、替代关系和有效时间对齐后，比较带引用的每周社区条目。",
  "effects": [
    "read"
  ],
  "guide": {
    "applicability": "当同一份已授权来源契约能够跨日核对时，用于固定的周度时间窗。",
    "context_boundary": "来源覆盖变化和重复评论必须保持可见；文本不能授权工具，也不能确立具有代表性的情绪。",
    "steps": [
      "解析周度实体、来源和时间覆盖范围，并识别新增、移除和已被替代的条目。",
      "对有界语料库应用已评审的聚合方法，同时保留来源和冲突引用。",
      "描述返回主题的变化和证据缺口，不外推至全体用户或业务因果关系。"
    ],
    "title": "社区每周证据摘要"
  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "事件叙事只陈述时间和证据链，不宣称因果。"
      ],
      "cohort": [
        "重复跨发、机器人和内部内容按项目政策统一处理。"
      ],
      "inputs": [
        "输入含逐日内容、主题、情感、来源、风险与活动 Context。"
      ],
      "requires_project_calibration": [
        {
          "calibration_id": "weekly-window",
          "subject": "周起止、时区、节假日和迟到内容处理。"
        },
        {
          "calibration_id": "narrative-threshold",
          "subject": "核心事件、持续信号和慢性下滑门槛。"
        },
        {
          "calibration_id": "community-risk-policy",
          "subject": "产品预警与合规风险的不同责任链。"
        }
      ],
      "time": [
        "本周和上周按同一业务时区、星期结构和成熟度闭合。"
      ],
      "unit": [
        "周量为去重内容求和，周均占比按有效内容加权而非简单平均。"
      ]
    },
    "business_question": "一周社区变化可归纳为哪些跨日核心事件和情感弧线；周环比由哪些主题或来源贡献，慢性下滑与合规风险如何分开呈现？",
    "data_checks": {
      "completeness": [
        "当前窗与基准窗、返回分页、项目依赖和未返回残差均有可复核状态。",
        "所有进入公式、诊断树和排序的切片都能追溯到同一请求或输入产物。"
      ],
      "data_quality": [
        "实体键、时间戳、单位、枚举、空值和重复记录符合锁定的项目合同。",
        "比较期间 Semantic、Context、采集版本和计算方法未漂移。"
      ],
      "failure_behavior": "任一必需检查失败时停止诊断和建议，按 Empty、Partial、Error 或 Gap 输出空结论、原因码与精确补救动作。"
    },
    "dependency_status": [
      {
        "evidence": "Runtime Core 已登记该确定性 Operator，并用严格 Schema、资源预算与 golden cases 锁定输入输出。",
        "identity": "operator://gravity/sentiment-aggregation@1",
        "kind": "operator",
        "reason_code": "DEPENDENCY_AVAILABLE",
        "status": "available"
      },
      {
        "evidence": "该业务事实由调用项目的版本化 Context Provider 提供，缺失时在查询前返回 Gap。",
        "identity": "context://project/community-weekly@1",
        "kind": "context",
        "reason_code": "CONTEXT_REQUIRED_MISSING",
        "status": "requires_project_context"
      }
    ],
    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "event-arc",
          "checks": [
            "合并跨日证据。",
            "验证主题身份和时间连续性。"
          ],
          "condition": "同一主题有明确出现、峰值和回落或回应节点。",
          "leaves": [
            {
              "conclusion": "形成闭合事件弧线。",
              "condition": "事件热度回落且证据支持阶段结束。",
              "exclusions": [
                "不得称问题已解决，除非项目确认。"
              ],
              "leaf_id": "resolved-or-receding"
            },
            {
              "conclusion": "列为持续跟进线索。",
              "condition": "量或风险连续多日上升。",
              "exclusions": [
                "不得自动通知或处置。"
              ],
              "leaf_id": "ongoing-escalation"
            }
          ]
        },
        {
          "branch_id": "structural-weekly-shift",
          "checks": [
            "检查来源和品类结构。",
            "比较连续多周基线。"
          ],
          "condition": "多个日子同向变化但不属于单一事件。",
          "leaves": [
            {
              "conclusion": "报告周度结构变化。",
              "condition": "多来源多日同向。",
              "exclusions": [
                "一周不足以证明长期趋势。"
              ],
              "leaf_id": "broad-structural-change"
            },
            {
              "conclusion": "列为慢性信号。",
              "condition": "大盘向好但某主题连续数周下滑。",
              "exclusions": [
                "不得被大盘均值掩盖残差。"
              ],
              "leaf_id": "masked-slow-decline"
            }
          ]
        }
      ],
      "root_question": "周变化是由少数跨日事件驱动，还是由持续结构变化形成？"
    },
    "dimension_scan": {
      "baseline": "以可比上周和本周逐日结构为基线。",
      "contribution_formula": "contribution_s = (weekly_metric_s - prior_week_metric_s) / sum(returned_weekly_change)",
      "dimensions": [
        {
          "dimension_id": "day",
          "label": "业务日"
        },
        {
          "dimension_id": "event-thread",
          "label": "事件线索"
        },
        {
          "dimension_id": "topic",
          "label": "主题"
        },
        {
          "dimension_id": "source",
          "label": "来源"
        }
      ],
      "minimum_volume_rule": "仅出现一天且低于最小量的线索不提升为核心事件。",
      "ranking_rule": "先按跨日持续性，再按周变化贡献和风险级别排序。",
      "residual_policy": "缺失日、未分类和未覆盖来源单列残差。"
    },
