  "description": "将项目数据需求与已注册能力、所有权和访问契约进行匹配，资源开通仍由外部完成。",
  "effects": [
    "read"
  ],
  "guide": {
    "applicability": "当所需数据集、负责人和预期分析均已明确时，用于记录访问缺口。",
    "context_boundary": "项目文档仅作为证据；不能授予凭证、杜撰路由，也不能放宽隐私和投影策略。",
    "steps": [
      "定义所需数据集、业务目的、访问主体范围和最小字段集。",
      "将需求与当前已注册能力、Trust、投影、隐私及权限证据进行比较。",
      "返回确切的现有路径，或返回有界的能力/访问缺口及下一步所需的负责人证据。"
    ],
    "title": "受治理的数据访问就绪性评审"
  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "配置与故障只在有日志或验证回读时关联；相似案例不作为项目根因。"
      ],
      "cohort": [
        "客户端、服务端、批处理和调试流量分开评估，测试环境证据不外推生产。"
      ],
      "inputs": [
        "输入包含平台、SDK 或传输组件版本、运行环境、上报模式、身份策略和项目批准的文档引用。"
      ],
      "requires_project_calibration": [
        {
          "calibration_id": "integration-version",
          "subject": "项目批准的 SDK、组件和文档版本。"
        },
        {
          "calibration_id": "delivery-reliability",
          "subject": "缓存、重试、落盘和关闭时的可靠性要求。"
        },
        {
          "calibration_id": "production-red-lines",
          "subject": "调试模式、凭据、日志和数据保留的生产红线。"
        }
      ],
      "time": [
        "文档版本和组件支持窗口在实施日期有效，废弃 API 不作为当前建议。"
      ],
      "unit": [
        "覆盖率以必需合同检查项为单位，代码片段数量或文档页数不代表完成度。"
      ]
    },
    "business_question": "给定平台、环境和可靠性要求，项目应采用哪份已批准接入合同，当前配置覆盖了哪些必需步骤和生产红线？",
    "data_checks": {
      "completeness": [
        "平台、版本、环境和模式对应的必需检查集完整。",
        "每个已通过检查都有配置或验证回读证据。"
      ],
      "data_quality": [
        "示例字段类型、身份键和时间格式符合锁定合同。",
        "文档引用、组件版本和配置快照未发生漂移。"
      ],
      "failure_behavior": "任一必需检查失败时停止诊断和建议，按 Empty、Partial、Error 或 Gap 输出空结论、原因码与精确补救动作。"
    },
    "dependency_status": [
      {
        "evidence": "该业务事实由调用项目的版本化 Context Provider 提供，缺失时在查询前返回 Gap。",
        "identity": "context://project/data-access-contracts@1",
        "kind": "context",
        "reason_code": "CONTEXT_REQUIRED_MISSING",
        "status": "requires_project_context"
      }
    ],
    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "contract-selection",
          "checks": [
            "核对组件版本和运行环境。",
            "区分客户端、服务端与批处理责任。"
          ],
          "condition": "平台或版本合同尚未唯一解析。",
          "leaves": [
            {
              "conclusion": "要求项目锁定版本后再给步骤。",
              "condition": "多个文档版本可匹配且 API 不同。",
              "exclusions": [
                "不得拼接不同版本代码片段。"
              ],
              "leaf_id": "version-ambiguous"
            },
            {
              "conclusion": "报告模式合同不兼容。",
              "condition": "所选上报模式不满足可靠性或环境要求。",
              "exclusions": [
                "不得仅凭相似项目替换模式。"
              ],
              "leaf_id": "mode-incompatible"
            }
          ]
        },
        {
          "branch_id": "implementation-verification",
          "checks": [
            "按初始化、身份、缓冲、发送、关闭逐项回读。",
            "核对生产红线和测试回执。"
          ],
          "condition": "合同唯一，但当前配置或验证结果未通过。",
          "leaves": [
            {
              "conclusion": "输出精确配置缺口和验证步骤。",
              "condition": "必需参数、路径或身份字段缺失。",
              "exclusions": [
                "不得代填凭据或真实地址。"
              ],
              "leaf_id": "configuration-gap"
            },
            {
              "conclusion": "报告验证证据缺失。",
              "condition": "配置看似完整但没有端到端接收回读。",
              "exclusions": [
                "不得宣称接入完成或零丢失。"
              ],
              "leaf_id": "delivery-evidence-gap"
            }
          ]
        }
      ],
      "root_question": "项目是否已选择一个与平台、版本、环境和可靠性要求相符的接入合同？"
    },
    "dimension_scan": {
      "baseline": "以项目选定版本的官方合同检查集为基准，不混用其他版本或平台步骤。",
      "contribution_formula": "gap_share_s = missing_required_checks_s / total_missing_required_checks",
      "dimensions": [
        {
          "dimension_id": "platform",
          "label": "平台"
