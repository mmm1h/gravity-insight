      "本方法不安装组件、不发送事件、不更改生产配置。"
    ],
    "formulas": [
      {
        "denominator": "所选平台、环境和可靠性等级要求的全部必需检查数。",
        "expression": "coverage = passed_required_checks / required_checks",
        "formula_id": "integration-check-coverage",
        "interpretation": "覆盖率为一表示清单证据齐全，不代表生产数据质量或部署已完成。",
        "numerator": "有版本化证据且验证通过的必需接入检查数。",
        "requires_project_calibration": [
          "integration-version",
          "delivery-reliability",
          "production-red-lines"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "检查项计数",
            "definition": "验证通过且有证据引用的必需检查。",
            "distinct_by": "check-id",
            "symbol": "passed_required_checks"
          },
          {
            "aggregation": "检查项计数",
            "definition": "项目合同声明的全部必需检查。",
            "distinct_by": "check-id",
            "symbol": "required_checks"
          }
        ],
        "window": "同一组件版本与部署候选快照内评估。"
      }
    ],
