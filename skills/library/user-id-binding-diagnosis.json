          "checks": [
            "按来源端和登录状态定位缺失。",
            "用合法聚合配对检查序列断裂。"
          ],
          "condition": "排除合法路径后，关键来源仍低于身份覆盖阈值。",
          "leaves": [
            {
              "conclusion": "列为客户端绑定时点候选。",
              "condition": "客户端登录后关键事件仍缺账号绑定。",
              "exclusions": [
