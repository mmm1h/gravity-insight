  "description": "将已评审的项目目标和触达策略转化为提案，并明确进入、退出和衡量规则。",
  "effects": [
    "read"
  ],
  "guide": {
    "applicability": "当项目拥有受众语义、渠道策略、触达节奏和护栏定义时使用。",
    "context_boundary": "策略文档不能授权更改受众、发送消息或在外部系统中排期。",
    "steps": [
      "解析目标、资格条件、排除项、触达策略、触达节奏、退出标准和护栏指标。",
      "将旅程建模为不含具体取值的提案，并包含衡量和冲突检查。",
      "每次变更都必须另行获得受治理的连接器预览、明确的用户授权并完成回读。"
    ],
    "title": "受治理的运营旅程提案"
  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "旅程草案不声明动作会产生业务效果；效果只能由后续获批实验或评估验证。"
      ],
      "cohort": [
        "入口队列、排除人群、重复入组和退出条件必须由项目 Semantic 定义。"
      ],
      "inputs": [
        "输入包含业务目标、入口事件或队列、条件、等待、候选动作、退出目标和项目联系政策。"
      ],
      "requires_project_calibration": [
        {
          "calibration_id": "journey-node-vocabulary",
          "subject": "允许的入口、判断、分流、等待、动作和结束节点。"
