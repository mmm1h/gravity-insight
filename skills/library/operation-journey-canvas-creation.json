    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "graph-structure-gap",
          "checks": [
            "检查入口、可达性、环和终点。",
            "检查判断与分流的分支覆盖。"
          ],
          "condition": "节点边图不闭合、不可达或条件不互斥。",
          "leaves": [
            {
              "conclusion": "确认图结构缺口并列出节点。",
              "condition": "存在悬空或不可达节点。",
              "exclusions": [
                "不得把不可达动作算作有效路径。"
              ],
              "leaf_id": "dangling-or-unreachable"
            },
            {
              "conclusion": "确认分支歧义。",
              "condition": "条件重叠、遗漏 else 或顺序决定结果。",
              "exclusions": [
                "不得擅自选择优先级。"
              ],
              "leaf_id": "ambiguous-branch"
            }
          ]
        },
        {
          "branch_id": "project-contract-gap",
          "checks": [
            "解析 Semantic 队列与事件。",
            "核对联系政策、频控和授权。"
          ],
          "condition": "结构闭合但受众、时间、渠道或动作未绑定。",
          "leaves": [
            {
              "conclusion": "报告受众绑定缺口。",
              "condition": "入口或条件无法解析为版本化项目 Semantic。",
              "exclusions": [
                "不得从自然语言生成真实活动名。"
              ],
              "leaf_id": "audience-binding-missing"
            },
            {
              "conclusion": "保留候选动作但阻止发布。",
              "condition": "动作候选无渠道政策或执行授权。",
              "exclusions": [
                "本方法不得发送消息或创建线上旅程。"
              ],
              "leaf_id": "action-authorization-missing"
            }
          ]
        }
      ],
      "root_question": "生成图是否有唯一入口、所有分支可达且每条路径合法终止？"
    },
    "dimension_scan": {
      "baseline": "以唯一入口和所有可达路径为基准，每条边只属于一个来源节点分支。",
      "contribution_formula": "gap_share_s = invalid_or_missing_constraints_s / total_invalid_or_missing_constraints",
      "dimensions": [
        {
          "dimension_id": "node-kind",
          "label": "节点类型"
        },
        {
          "dimension_id": "branch-path",
          "label": "分支路径"
