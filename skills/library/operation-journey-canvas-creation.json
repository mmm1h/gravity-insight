        {
          "dimension_id": "audience-condition",
          "label": "受众条件"
        },
        {
          "dimension_id": "channel-policy",
          "label": "渠道政策"
        }
      ],
      "minimum_volume_rule": "没有至少一个入口和一个合法结束节点时不计算路径覆盖，直接返回 Gap。",
      "ranking_rule": "先排导致路径不可达或无限循环的结构缺口，再排受众、时间、频控和动作授权缺口。",
      "residual_policy": "无法绑定的自然语言条件和未授权动作保留为显式占位符，不自动删除或猜值。"
    },
