        {
          "calibration_id": "contact-policy",
          "subject": "渠道同意、频控、静默期和排除规则。"
        },
        {
          "calibration_id": "reentry-policy",
          "subject": "重复入组、并发旅程和退出优先级。"
        }
      ],
      "time": [
        "等待时长、观察窗口、频控和旅程有效期使用项目业务时区并显式上限。"
      ],
      "unit": [
        "节点数、边数和路径覆盖是结构单位；预估人数和转化目标不作为已实现效果。"
      ]
    },
    "business_question": "一段运营意图能否被无歧义地转换为有入口、条件、等待、动作候选和结束节点的完整有向图；哪些项目值和授权仍待补齐？",
    "data_checks": {
      "completeness": [
        "所有可达节点和边均有稳定 ID、类型和来源条件。",
        "每条路径都终止且所有项目占位符有缺口清单。"
      ],
      "data_quality": [
        "条件表达式类型、单位和时间边界一致。",
        "受众、渠道和退出引用无冲突或重复执行。"
      ],
      "failure_behavior": "任一必需检查失败时停止诊断和建议，按 Empty、Partial、Error 或 Gap 输出空结论、原因码与精确补救动作。"
    },
    "dependency_status": [
      {
        "evidence": "该 URI 的定义、物理绑定、生效窗口与负责人由调用项目提供；Runtime 不从字段名推断。",
        "identity": "cohort://project/operations-journey-entry@1",
        "kind": "semantic",
