    "formulas": [
      {
        "denominator": "从入口可达的全部分支路径数。",
        "expression": "coverage = valid_entry_to_terminal_paths / reachable_entry_paths",
        "formula_id": "terminal-path-coverage",
        "interpretation": "覆盖率为一表示图结构闭合，不表示受众、动作授权或业务效果有效。",
        "numerator": "从入口出发、条件有定义且以合法结束节点收束的可达路径数。",
        "requires_project_calibration": [
          "journey-node-vocabulary",
          "contact-policy",
          "reentry-policy"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "图路径计数",
            "definition": "无悬空、无未定义条件且以结束节点收束的路径。",
            "distinct_by": "path-id",
            "symbol": "valid_entry_to_terminal_paths"
          },
          {
            "aggregation": "图路径计数",
            "definition": "从唯一入口可达的全部路径。",
            "distinct_by": "path-id",
            "symbol": "reachable_entry_paths"
          }
        ],
        "window": "同一旅程草案版本内静态计算，不模拟线上执行。"
      }
    ],
    "handoff": {
      "authorization_boundary": "本方法只生成可评审草案；创建、发布、发送和受众写入必须由独立受治理 Action 在调用方明确授权后执行。",
