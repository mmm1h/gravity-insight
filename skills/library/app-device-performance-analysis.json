  "method": {
    "assumptions": {
      "attribution": [
        "性能事件只归于同一会话内最近页面与版本，跨会话或缺失页面不强行归因。"
      ],
      "cohort": [
        "设备或会话队列采用相同活跃门槛，重装、模拟器和测试设备按项目规则排除。"
      ],
      "inputs": [
        "输入至少包含会话或设备去重键、性能事件、发生时间、设备型号、系统版本、应用版本和页面。"
      ],
      "requires_project_calibration": [
        {
          "calibration_id": "performance-thresholds",
          "subject": "各指标告警阈值、最小会话量和连续窗口规则。"
        },
        {
          "calibration_id": "device-tier-map",
          "subject": "设备档位、内存档位和系统支持范围。"
        }
      ],
      "time": [
        "当前版本窗与基准版本窗按同一发布阶段和业务时区闭合，灰度占比单独记录。"
      ],
      "unit": [
        "崩溃率按受影响会话除以合格会话；时长使用同一时间单位，帧率使用每秒帧数。"
      ]
    },
    "business_question": "性能异常是否集中于特定设备、系统、版本或页面组合；影响范围多大，哪些堆栈或资源证据支持候选机制？",
    "data_checks": {
      "completeness": [
        "当前与基准窗覆盖同一发布阶段且分页完整。",
        "设备、系统、版本和页面字段缺失率已报告。"
      ],
      "data_quality": [
        "会话键、版本号和时间戳有效且无跨窗重复。",
        "性能事件定义与采集版本在比较窗内未漂移。"
      ],
      "failure_behavior": "任一必需检查失败时停止诊断和建议，按 Empty、Partial、Error 或 Gap 输出空结论、原因码与精确补救动作。"
