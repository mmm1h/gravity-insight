    "formulas": [
      {
        "denominator": "同切片、同窗口内满足活跃与版本条件的去重合格会话数。",
        "expression": "rate_s = distinct_affected_sessions_s / distinct_eligible_sessions_s",
        "formula_id": "affected-session-rate",
        "interpretation": "比例描述返回会话内的观测异常率，不代表全部设备人口，也不证明候选机制导致异常。",
        "numerator": "切片内至少发生一次目标性能事件的去重会话数。",
        "requires_project_calibration": [
          "performance-thresholds",
          "device-tier-map"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "按会话去重计数",
            "definition": "发生目标性能异常的会话集合。",
            "distinct_by": "session-id",
            "symbol": "distinct_affected_sessions"
          },
          {
            "aggregation": "按会话去重计数",
            "definition": "进入可观测页面且满足项目排除规则的会话集合。",
            "distinct_by": "session-id",
            "symbol": "distinct_eligible_sessions"
          }
        ],
        "window": "版本当前窗与可比基准窗，灰度和全量阶段不混合。"
      }
