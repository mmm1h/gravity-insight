    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "compatibility-concentration",
          "checks": [
            "核对组合会话量与灰度覆盖。",
            "聚类错误签名并检查资源档位。"
          ],
          "condition": "超额异常主要集中于少数设备或系统组合。",
          "leaves": [
            {
              "conclusion": "列为资源压力候选并设计降级验证。",
              "condition": "低资源档位与特定页面同时显著。",
              "exclusions": [
                "没有内存或资源证据时不得认定资源溢出。"
              ],
              "leaf_id": "resource-pressure"
            },
            {
              "conclusion": "列为系统兼容候选。",
              "condition": "特定系统版本集中且错误签名指向平台 API。",
              "exclusions": [
                "若应用版本或页面分布不同，先控制混杂。"
              ],
              "leaf_id": "platform-api-mismatch"
            }
          ]
        },
        {
          "branch_id": "application-wide-regression",
          "checks": [
            "比较新旧应用版本和页面发布变更。",
            "检查性能事件采集版本是否漂移。"
          ],
          "condition": "多个设备档位同向上升，集中度不足以解释大盘。",
          "leaves": [
            {
              "conclusion": "列为页面级回归候选。",
              "condition": "异常集中于同一新增或改版页面。",
              "exclusions": [
                "没有同页面旧版本对照时不得声称回归。"
              ],
              "leaf_id": "page-regression"
            },
            {
              "conclusion": "列为采集口径漂移。",
              "condition": "异常与采集版本切换同步且独立日志不支持性能恶化。",
              "exclusions": [
                "独立日志实体或窗口不可比时不得据此排除真实异常。"
              ],
              "leaf_id": "instrumentation-shift"
            }
          ]
        }
      ],
      "root_question": "异常率是否越过项目阈值，且集中度足以从大盘收窄到稳定组合？"
    },
    "dimension_scan": {
      "baseline": "每个切片使用相同事件、会话队列和版本窗口；跨维度贡献不相加。",
      "contribution_formula": "impact_s = affected_sessions_s - baseline_rate_s * eligible_sessions_s; contribution_s = impact_s / sum(impact_returned_s)",
