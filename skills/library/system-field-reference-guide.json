  "guide": {
    "applicability": "当项目 Context Provider 能够返回当前已评审的字段定义和血缘时使用。",
    "context_boundary": "字段名和示例不构成定义；缺失、过期或冲突的条目必须保留为明确缺口。",
    "steps": [
      "解析所请求的实体、事件或属性范围，以及当前项目权威修订版。",
      "仅收集已经评审且带引用的定义、绑定、单位、敏感性和生效范围。",
      "返回包含冲突和缺口的有界指南；不推断未记录的含义或权限。"
    ],
    "title": "项目字段契约指南"
  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "字段不可见按合同阶段定位，不把界面状态或权限猜测为原因。"
      ],
      "cohort": [
        "事件实体和用户实体分别处理，跨表字段必须先由项目确认归属。"
      ],
      "inputs": [
        "输入包含字段稳定身份、目录版本、实体归属、类型、物理绑定、分析面和当前连接状态。"
      ],
