    "exclusions": [
      "不得连接或探测生产 Trino。",
      "不得执行查询、EXPLAIN ANALYZE 或任何写语句。",
      "未返回元数据不等于对象不存在。",
      "计划估算不等于实际行数、耗时或资源消耗。"
    ],
    "formulas": [
      {
        "denominator": "调用方请求且位于 allowlist 内的对象总数。",
        "expression": "coverage = resolved_requested_objects / requested_objects",
        "formula_id": "metadata-coverage",
        "interpretation": "覆盖率只描述所提供元数据快照，不证明无权或未返回对象不存在。",
        "numerator": "在允许元数据快照中唯一解析到的请求对象数。",
        "requires_project_calibration": [
          "trino-version",
          "metadata-allowlist",
          "read-only-policy"
        ],
        "unit": "无量纲比例",
        "variables": [
          {
            "aggregation": "对象计数",
            "definition": "唯一解析到 catalog、schema、表和列身份的对象。",
            "distinct_by": "fully-qualified-object",
            "symbol": "resolved_requested_objects"
          },
          {
            "aggregation": "对象计数",
            "definition": "请求检查的允许对象。",
            "distinct_by": "fully-qualified-object",
            "symbol": "requested_objects"
          }
        ],
        "window": "同一元数据快照和 Trino 版本。"
      }
    ],
    "handoff": {
      "authorization_boundary": "本方法只生成分析结果或候选方案，不自动修改配置、数据、代码、受众、消息或生产系统。",
      "automatic_execution": false,
      "conditions": [
        "只有证据完整、排除项通过且调用方另行授权时，才可把建议交给受治理的后续 Action 或 Experiment。"
      ],
      "kind": "none",
      "target": null
    },
    "method_revision": 1,
    "procedure": [
      {
        "depends_on": [],
        "instruction": "解析并锁定Trino 版本、catalog/schema allowlist、只读政策和元数据快照，记录版本、负责人、生效范围、单位和禁止推断项。",
        "on_failure": "METHOD_INPUT_GAP",
        "step_id": "resolve-contracts"
      },
      {
        "depends_on": [
          "resolve-contracts"
        ],
        "instruction": "按相同范围收集information_schema 返回、表列分区清单、查询 AST 和 EXPLAIN 计划，保留请求或产物摘要、时间窗、返回范围和来源证据。",
        "on_failure": "METHOD_QUERY_ERROR",
        "step_id": "collect-evidence"
      },
      {
        "depends_on": [
          "collect-evidence"
        ],
        "instruction": "执行完整性、口径一致性、实体去重、时间成熟度和数据质量检查；失败时停止业务结论。",
        "on_failure": "METHOD_DATA_INVALID",
        "step_id": "validate-evidence"
      },
      {
        "depends_on": [
          "validate-evidence"
        ],
        "instruction": "仅用已声明变量和项目校准参数计算元数据覆盖率、分区约束覆盖和计划风险占比，分母为零或单位冲突时不产出数值。",
        "on_failure": "METHOD_FORMULA_INVALID",
        "step_id": "compute-indicators"
      },
      {
        "depends_on": [
          "compute-indicators"
        ],
        "instruction": "沿对象解析缺口与查询结构或扫描边界风险两条路径逐层验证条件、反例和排除项，未通过的叶子不得进入结论。",
        "on_failure": "METHOD_DIAGNOSIS_INCONCLUSIVE",
        "step_id": "traverse-diagnostic-tree"
      },
      {
        "depends_on": [
          "traverse-diagnostic-tree"
        ],
        "instruction": "按互斥返回维度计算变化或覆盖贡献，应用最小样本门槛，并把未返回和无法归类部分保留为残差。",
        "on_failure": "METHOD_CONTRIBUTION_UNAVAILABLE",
        "step_id": "scan-dimensions"
      },
      {
        "depends_on": [
          "scan-dimensions"
        ],
        "instruction": "生成元数据事实、只读查询建议、计划风险和执行禁止边界，同时列出状态、证据、依赖快照、排除项、允许断言和禁止断言。",
        "on_failure": "METHOD_RESULT_INVALID",
        "step_id": "assemble-result"
      }
    ],
