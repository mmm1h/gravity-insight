  "covers_journeys": [],
  "description": "提出任何受治理的查询路径前，必须具备确切的 Trino 方言、只读身份和元数据允许列表。",
  "effects": [
    "read"
  ],
  "guide": {
    "applicability": "用于对指定 catalog、schema 和有界问题的元数据缺口进行分类。",
    "context_boundary": "SQLite Explorer 和通用 SQL 文本不能证明 Trino 的身份、事务、函数或资源控制。",
    "steps": [
      "定义 catalog、schema、元数据关系、字段和只读目的。",
      "检查是否存在确切的已注册 Trino 能力，并具备方言、身份、允许列表和资源预算。",
      "返回不受支持的缺口和所需证据；不得通过 SQLite 或任意 SQL 路由。"
    ],
    "title": "Trino 元数据就绪性评审"
  },
  "lifecycle": "reviewed",
  "method": {
    "assumptions": {
      "attribution": [
        "计划结构只支持查询风险候选，不把估算节点归因为实际生产耗时。"
      ],
      "cohort": [
        "catalog、schema、表和列范围按 allowlist 限定，隐藏或无权对象不解释为不存在。"
      ],
      "inputs": [
        "输入包含 Trino 版本、允许的 catalog/schema、元数据快照、目标问题、查询文本或计划产物。"
      ],
      "requires_project_calibration": [
        {
          "calibration_id": "trino-version",
          "subject": "Trino 方言版本、连接器能力和受支持语句。"
        },
        {
          "calibration_id": "metadata-allowlist",
          "subject": "允许检查的 catalog、schema 和对象范围。"
        },
        {
          "calibration_id": "read-only-policy",
          "subject": "只读语句、最大扫描范围和禁止函数或连接器。"
        }
      ],
      "time": [
        "元数据和计划只代表其采集快照；表结构或统计变化后必须重新验证。"
      ],
      "unit": [
        "表、列、分区和计划节点按稳定身份计数，统计估算与实际行数明确区分。"
      ]
    },
    "business_question": "在获批 catalog、schema 和只读边界内，哪些表、列、分区与执行计划事实可由元数据证明，候选查询是否满足方言、安全和有界扫描要求？",
    "data_checks": {
      "completeness": [
        "请求对象、allowlist 和元数据快照范围可逐项对账。",
        "查询引用和计划节点均在有界输出中完整解析。"
      ],
      "data_quality": [
        "限定名、类型、分区和统计单位内部一致。",
        "方言版本与 AST、函数和连接器能力匹配。"
      ],
      "failure_behavior": "任一必需检查失败时停止诊断和建议，按 Empty、Partial、Error 或 Gap 输出空结论、原因码与精确补救动作。"
    },
    "dependency_status": [
      {
        "evidence": "该业务事实由调用项目的版本化 Context Provider 提供，缺失时在查询前返回 Gap。",
        "identity": "context://project/trino-metadata-contract@1",
        "kind": "context",
        "reason_code": "CONTEXT_REQUIRED_MISSING",
        "status": "requires_project_context"
      }
    ],
    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "metadata-resolution",
          "checks": [
            "规范化 catalog.schema.object 身份。",
            "核对 allowlist、大小写和连接器能力。"
          ],
          "condition": "对象无法唯一解析或元数据覆盖不足。",
          "leaves": [
            {
              "conclusion": "报告对象解析缺口。",
              "condition": "对象未返回或同名身份不唯一。",
              "exclusions": [
                "不得把未返回解释为对象不存在。"
              ],
              "leaf_id": "object-missing-or-ambiguous"
            },
            {
              "conclusion": "报告连接器能力缺口。",
              "condition": "连接器不暴露所需列、分区或统计。",
              "exclusions": [
                "不得用其他连接器语义替代。"
              ],
              "leaf_id": "connector-metadata-gap"
            }
          ]
        },
        {
          "branch_id": "query-or-plan-risk",
          "checks": [
            "验证语句种类和引用范围。",
            "检查分区、连接、排序和计划统计。"
          ],
          "condition": "对象已解析，但查询 AST 或计划违反只读或有界扫描政策。",
          "leaves": [
            {
              "conclusion": "阻止查询并返回政策原因。",
              "condition": "存在写语句、越界对象或不允许函数。",
              "exclusions": [
                "不得执行或改写后自动重试。"
              ],
              "leaf_id": "read-boundary-violation"
            },
            {
              "conclusion": "报告扫描风险并给有界候选。",
              "condition": "缺分区、谓词或计划显示大范围扫描。",
              "exclusions": [
                "没有运行证据不得给性能保证。"
              ],
              "leaf_id": "unbounded-scan-risk"
            }
          ]
        }
      ],
      "root_question": "请求对象能否在允许快照中唯一解析，候选查询是否保持只读且有界？"
    },
    "dimension_scan": {
      "baseline": "以项目 allowlist 和同一元数据快照为基准，跨连接器的统计口径不直接相加。",
      "contribution_formula": "gap_share_s = unresolved_or_risky_objects_s / total_unresolved_or_risky_objects",
      "dimensions": [
        {
          "dimension_id": "catalog",
          "label": "Catalog"
        },
        {
          "dimension_id": "schema",
          "label": "Schema"
        },
        {
          "dimension_id": "object-kind",
          "label": "对象类型"
        },
        {
          "dimension_id": "plan-risk",
          "label": "计划风险"
        }
      ],
      "minimum_volume_rule": "没有完整限定名或不在 allowlist 的对象不进入覆盖分母，直接报告输入 Gap。",
      "ranking_rule": "先排越界或非只读风险，再排对象缺失、分区约束、基数放大和统计未知。",
      "residual_policy": "无权、未返回、连接器不支持和统计缺失分别保留，不解释为零或不存在。"
    },
