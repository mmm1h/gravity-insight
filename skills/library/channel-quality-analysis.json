              ],
              "leaf_id": "high-value-expensive"
            }
          ]
        },
        {
          "branch_id": "measurement-or-suspicious-signal",
          "checks": [
            "核对身份和事件覆盖。",
            "检查重复、单一行为和渠道重叠。"
          ],
          "condition": "新增量与行为、身份或留存结构明显背离。",
          "leaves": [
            {
              "conclusion": "报告测量缺口。",
              "condition": "异常集中于缺字段或采集版本。",
              "exclusions": [
                "不得给渠道质量结论。"
              ],
              "leaf_id": "instrumentation-gap"
            },
            {
              "conclusion": "报告可疑流量信号并要求独立核验。",
              "condition": "采集完整但重复、极低行为深度等信号同时出现。",
              "exclusions": [
                "不得认定刷量或欺诈。"
              ],
              "leaf_id": "suspicious-traffic-pattern"
            }
          ]
