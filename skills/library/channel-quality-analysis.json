    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "business-quality-difference",
          "checks": [
            "比较同龄队列。",
            "检查渠道受众和计划组合。"
          ],
          "condition": "留存、付费、价值和行为深度在成熟窗内共同偏低或偏高。",
          "leaves": [
            {
              "conclusion": "确认低意向组合假设。",
              "condition": "多项质量指标同向偏低且采集完整。",
