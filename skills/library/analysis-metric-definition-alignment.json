        },
        {
          "dimension_id": "effective-version",
          "label": "生效版本"
        }
      ],
      "minimum_volume_rule": "没有足够返回量或无法稳定复算的差异项只列为待验证，不给数值贡献。",
      "ranking_rule": "先按是否改变业务语义排序，再按已解释绝对差额和下游引用数降序。",
      "residual_policy": "未解释残差必须单列；残差不为零时不得宣称差异已完全闭环。"
    },
