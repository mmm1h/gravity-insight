            "distinct_by": null,
            "symbol": "explained_absolute_difference"
          },
          {
            "aggregation": "绝对差",
            "definition": "两份分析对象在共同范围下返回值的绝对差。",
            "distinct_by": null,
            "symbol": "observed_absolute_difference"
          }
        ],
        "window": "两侧使用同一闭合窗口、时区和数据成熟度，定义版本在该窗口有效。"
      }
