      "本方法不发布、删帖或发送升级消息。"
    ],
    "formulas": [
      {
        "denominator": "可比基线绝对值；为零时只报告绝对变化。",
        "expression": "change_m = (metric_today - metric_baseline) / abs(metric_baseline)",
        "formula_id": "daily-relative-change",
        "interpretation": "变化描述日度返回，不证明某事件导致。",
        "numerator": "当日指标与可比基线的带符号差。",
        "requires_project_calibration": [
          "daily-cutoff",
          "daily-alert-threshold",
          "community-risk-policy"
        ],
        "unit": "相对比例",
        "variables": [
          {
            "aggregation": "日聚合",
            "definition": "当日去重内容量或分类占比。",
            "distinct_by": null,
            "symbol": "metric_today"
          },
          {
            "aggregation": "日聚合",
            "definition": "可比基准日的同口径指标。",
            "distinct_by": null,
            "symbol": "metric_baseline"
          }
        ],
        "window": "一个已封账业务日与项目批准的可比日。"
      }
    ],
