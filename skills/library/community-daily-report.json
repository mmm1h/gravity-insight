        "kind": "context",
        "reason_code": "CONTEXT_REQUIRED_MISSING",
        "status": "requires_project_context"
      }
    ],
    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "qualified-daily-change",
          "checks": [
            "定位主要来源和主题贡献。",
            "核对可追溯内容证据。"
          ],
          "condition": "数据可比且量、情感或主题变化越过阈值。",
          "leaves": [
            {
              "conclusion": "报告当日热点及返回贡献。",
              "condition": "少数主题解释主要内容增量。",
              "exclusions": [
                "不得称全网趋势。"
              ],
              "leaf_id": "topic-surge"
            },
            {
              "conclusion": "报告日度预警候选。",
              "condition": "情感或风险结构显著变化。",
              "exclusions": [
                "不得自动升级或处置。"
              ],
              "leaf_id": "sentiment-or-risk-shift"
            }
          ]
        },
        {
          "branch_id": "coverage-or-calendar-effect",
          "checks": [
            "比较来源覆盖。",
            "核对活动、版本和星期结构。"
          ],
          "condition": "变化与来源缺失、封账或特殊日历重合。",
          "leaves": [
            {
              "conclusion": "降级为 Partial。",
              "condition": "主要来源分页或采集不完整。",
              "exclusions": [
                "不得输出完整排名。"
              ],
              "leaf_id": "source-coverage-gap"
            },
            {
              "conclusion": "更换或保留多个基准。",
              "condition": "基准日与当日事件或星期结构不可比。",
              "exclusions": [
                "不得按单日环比下结论。"
              ],
              "leaf_id": "noncomparable-day"
            }
          ]
        }
      ],
      "root_question": "日度变化是否越过项目门槛，且不是来源覆盖或封账差异造成？"
    },
    "dimension_scan": {
      "baseline": "以前一可比业务日或批准基准为基线。",
      "contribution_formula": "contribution_s = (metric_today_s - metric_baseline_s) / sum(returned_change)",
      "dimensions": [
        {
          "dimension_id": "source",
          "label": "来源"
        },
        {
          "dimension_id": "topic",
          "label": "主题"
        },
        {
          "dimension_id": "sentiment",
          "label": "情感"
        },
        {
          "dimension_id": "risk-class",
          "label": "风险类别"
        }
      ],
      "minimum_volume_rule": "低于最小内容量的主题只作观察，不触发预警。",
      "ranking_rule": "先按越阈程度，再按内容量、持续性和责任类别排序。",
      "residual_policy": "未封账、未分类、删除和未覆盖来源作为残差。"
    },
