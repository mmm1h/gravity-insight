          ]
        },
        {
          "branch_id": "mechanic-or-guidance-transition",
          "checks": [
            "核对机制版本。",
            "比较引导完成与未完成。"
          ],
          "condition": "异常集中于规则切换或引导未完成分群。",
          "leaves": [
            {
              "conclusion": "列为机制切换候选。",
              "condition": "首次出现新规则且流失同步集中。",
              "exclusions": [
                "时间相邻不等于因果。"
              ],
              "leaf_id": "mechanic-transition"
            },
            {
              "conclusion": "列为引导覆盖候选。",
              "condition": "引导未完成分群显著更差。",
              "exclusions": [
                "需实验验证引导改动效果。"
              ],
              "leaf_id": "guidance-gap"
            }
          ]
        }
      ],
      "root_question": "流失集中是否显著超过相邻和历史基准，并能在稳定分群中复现？"
