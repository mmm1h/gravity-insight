    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "difficulty-friction",
          "checks": [
            "比较相邻关卡。",
            "检查战力与尝试分布。"
          ],
          "condition": "多个分群均低通关、高尝试且失败后回访低。",
          "leaves": [
