    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "conversion-chain-gap",
          "checks": [
            "逐步核对曝光至付费漏斗。",
            "检查触点和事件口径漂移。"
          ],
          "condition": "点击或激活成本合理，但关键转化步骤显著低于可比基准。",
          "leaves": [
            {
              "conclusion": "列为素材承诺或落地链路不匹配候选。",
              "condition": "高点击后激活或注册骤降。",
