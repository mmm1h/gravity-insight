              ],
              "leaf_id": "payment-step-gap"
            }
          ]
        },
        {
          "branch_id": "downstream-quality-gap",
          "checks": [
            "比较同龄队列留存和价值。",
            "检查异常单一行为和归因完整性。"
          ],
          "condition": "获客成本低但留存、付费或价值持续偏低。",
          "leaves": [
            {
              "conclusion": "确认低意向流量假设。",
              "condition": "多项下游质量指标同向偏低。",
              "exclusions": [
                "不得称刷量或欺诈，除非有独立证据。"
              ],
              "leaf_id": "low-intent-traffic"
            },
            {
              "conclusion": "报告测量或成熟度缺口。",
              "condition": "价值低与数据未成熟或身份缺失重合。",
              "exclusions": [
                "不得按零值计算最终回收。"
              ],
              "leaf_id": "measurement-or-maturity-gap"
            }
          ]
        }
      ],
      "root_question": "计划的成本效率问题来自转化链路，还是来自激活后的用户质量？"
