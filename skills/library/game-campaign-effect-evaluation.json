    "diagnostic_tree": {
      "branches": [
        {
          "branch_id": "comparison-design-qualified",
          "checks": [
            "验证活动组和比较组的形成机制、分配前固定性、交叉曝光和样本流转。",
            "验证结果窗、前置趋势、并行活动和项目要求的最小样本及污染门槛。"
          ],
          "condition": "项目 Context 提供可审计分配或准实验设计，比较组与窗口检查全部通过。",
          "leaves": [
            {
              "conclusion": "可报告随机或规则分配组之间的观测结果差，但本 Skill 的 Claim Policy 仍不授权因果或增量提升断言。",
              "condition": "分配机制经项目确认，活动组和比较组在结果窗内独立，交叉曝光低于项目门槛。",
              "exclusions": [
                "若分配后存在选择性退出、跨组迁移或不对称结果缺失，组间差异不成立。",
                "若实验停止、样本量或多重检验规则未由项目评审，不得补造显著性或置信度。"
              ],
              "leaf_id": "assigned-group-difference"
            },
            {
              "conclusion": "可报告通过前置趋势检查的双重差分算术估计，并明确它仍是设计限定的关联证据。",
              "condition": "活动组与比较组前置趋势在项目容差内，窗口无重叠，且同期冲击检查通过。",
              "exclusions": [
                "若前置趋势不平行或项目未定义容差，双重差分解释不成立。",
                "若同期发布、价格、渠道或其他活动差异化影响组别，不得把估计归于本活动。"
              ],
              "leaf_id": "difference-in-differences-association"
            }
          ]
        },
        {
          "branch_id": "comparison-design-insufficient",
          "checks": [
            "区分只有活动前后窗口、只有曝光用户或比较组污染的证据形状。",
            "量化未匹配、交叉曝光、并行活动和时区错位对可报告范围的影响。"
          ],
          "condition": "缺少可审计分配机制、有效比较组、前置趋势或污染控制中的任一项。",
          "leaves": [
            {
              "conclusion": "只能报告活动窗口相对基准窗口的描述性结果变化和返回维度贡献。",
              "condition": "活动日历与结果 Semantic 可用，但没有有效比较组或分配证据。",
              "exclusions": [
                "季节性、自然趋势、版本发布、价格变化和并行活动未排除时，不得称活动效果。",
                "若活动窗或基准窗未成熟，连描述性变化也必须降级为 Partial。"
              ],
              "leaf_id": "before-after-description"
            },
            {
              "conclusion": "证据被污染或无法对齐，返回 Gap 或 Partial，不输出活动效果结论。",
              "condition": "交叉曝光超过项目上限、分配后入组、结果先于曝光或组别无法稳定去重。",
              "exclusions": [
                "不得删除污染用户后假装仍保持原分配设计，除非项目预先批准该排除规则。",
                "不得用活动名称、日期重叠或用户自选择参与替代分配和曝光证据。"
              ],
              "leaf_id": "contaminated-comparison"
            }
          ]
        }
      ],
      "root_question": "项目是否提供足以形成有效比较的分配、曝光、窗口和污染证据，还是只能做描述性前后变化？"
    },
