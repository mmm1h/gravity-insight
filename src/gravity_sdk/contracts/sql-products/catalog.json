{
  "schema_version": 1,
  "datasource": {
    "id": "gravity_merge2_v1",
    "verification_status": "verified_with_gaps",
    "timezone": "Asia/Shanghai",
    "freshness": "latest safe calendar day",
    "privacy": "aggregate or schema-level output only"
  },
  "products": {
    "payment-summary": {
      "source_event": "$PayEvent",
      "window": "left-closed right-open in Asia/Shanghai",
      "amount": "properties.$pay_amount in cents",
      "order_key": "non-empty $order_id, otherwise user_id + create_time + $pay_reason + $pay_amount",
      "buyer": "distinct user_id",
      "limits": [
        "behavioral payment is not financial net revenue",
        "the product does not provide campaign attribution or causal uplift"
      ]
    },
    "first-scene-coverage": {
      "source": "user property $first_scene",
      "window": "left-closed right-open in Asia/Shanghai",
      "limits": [
        "$first_scene is not an event property",
        "empty or unknown values do not mean that the user had no source"
      ]
    },
    "energy-profile-coverage": {
      "source_properties": [
        "total_usepower_num",
        "total_getpower_num",
        "current_power"
      ],
      "semantics": "coverage of cumulative or snapshot user properties",
      "limits": [
        "the product does not calculate energy consumed within the query window",
        "paid_assets cannot reconstruct per-action energy consumption"
      ]
    },
    "event-coverage": {
      "source": "declared event names in this contract",
      "semantics": "event presence within the query window",
      "limits": [
        "absence in one day does not prove instrumentation failure",
        "event presence does not prove campaign or version impact"
      ]
    }
  },
  "event_coverage": {
    "declared_events": [
      "Login",
      "$AppStart",
      "$MPLaunch",
