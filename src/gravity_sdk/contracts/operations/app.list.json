{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 1,
  "operation": {
    "action": "list",
    "auth_profile": "gravity_authorization",
    "contract_version": 2,
    "description": "当前账号可见 App 列表。",
    "domain": "app",
    "effect": "read",
    "examples": [
      {
        "description": "Minimum input copied from the enabled, contract-verified live probe.",
        "inputs": {
          "page": 1,
          "page_size": 1
        },
        "name": "minimum_read"
      }
    ],
    "input_fields": {
      "page": {
        "default": 1,
        "type": "integer"
      },
      "page_size": {
        "default": 6000,
        "type": "integer"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "page": 1,
        "page_size": 1
      }
    },
    "operation_id": "app.list",
    "pagination": {
      "default_page_size": 6000,
      "kind": "page_info",
      "list_path": "data.list",
      "max_page_size": 6000,
      "page_field": "page",
      "page_info_path": "data.page_info",
      "page_size_field": "page_size",
      "total_page_field": "total_page"
    },
    "path_template": "/turbo_engine/api/v1/user/open_app/list/",
    "privacy_policy": {
      "classification": "internal_business",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password"
      ]
    },
    "provenance": {
      "applied_overrides": [],
      "family": null,
      "platform": null,
      "source_files": [
        "operations/app.list.json"
      ]
    },
    "request": {
      "body_fields": [],
      "defaults": {
        "page": 1,
        "page_size": 6000
      },
      "fixed_body": {},
      "fixed_query": {},
      "path_fields": [],
      "query_fields": [
        "page",
        "page_size"
      ]
    },
    "required_parent": [],
    "resource": "app",
    "response_projection": {
      "data_keys": [
        "list",
        "page_info"
      ],
      "dynamic_item_fields": [],
      "item_keys": [
        "id",
        "name",
        "status",
        "app_id",
        "app_name",
        "package_name",
        "platform",
        "cid",
        "create_time",
        "event_version",
        "industry_id",
        "is_enabled",
        "is_iaa",
        "modify_time",
        "os",
        "wechat_app_id",
        "wechat_origin_id"
      ],
      "known_omitted_item_keys": [
        "remark",
        "sub_package_list"
      ],
      "required_data_keys": [
        "list"
      ]
    },
    "semantic_error_rules": [
      "code",
      "extra.error"
    ],
    "stability": "stable",
    "upstream_method": "GET"
  },
  "source_schema_version": 2,
  "target_manifest": "other.json"
}
