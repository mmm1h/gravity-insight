    "contract_version": 2,
    "description": "单用户事件流；支持事件选择和结构化查询项，输出已登记的用户、设备、事件时间线及汇总字段。上游不返回 page_info，请显式递增 page，直到 event_timeline[*].list 为空。",
    "domain": "analysis",
    "effect": "read",
    "examples": [],
    "input_fields": {
      "app_id": {
        "max_length": 64,
        "required": true,
        "type": "string"
      },
      "client_id": {
        "max_length": 256,
        "required": true,
        "sensitive": true,
        "type": "string"
      },
      "date": {
        "required": false,
        "type": "date"
      },
      "date_list": {
        "item_type": "string",
        "max_items": 2,
        "min_items": 2,
        "required": false,
        "type": "array"
      },
      "desc": {
        "default": true,
        "type": "boolean"
      },
      "event_list": {
        "default": [],
        "item_type": "string",
        "max_items": 2000,
        "type": "array"
      },
      "fields": {
        "default": [],
        "item_type": "string",
        "max_items": 2000,
        "type": "array"
      },
      "group_by": {
        "default": "day",
        "enum": [
          "day",
          "hour",
          "week",
          "month"
        ],
        "type": "string"
      },
      "page": {
        "default": 1,
        "type": "integer"
      },
      "page_size": {
        "default": 20,
        "type": "integer"
      },
      "query_item_list": {
        "default": [],
        "item_type": "object",
        "max_items": 100,
        "type": "array"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_id": "$first_app_id",
        "client_id": "$first_client_id",
        "date": "$today",
        "page": 1,
        "page_size": 1
      }
    },
    "operation_id": "analysis.user_event.list",
    "pagination": {
      "kind": "none",
      "completeness": "unknown",
      "pagination_evidence": "template",
      "list_path": "",
      "page_field": "",
      "page_info_path": "",
      "page_size_field": "",
      "total_page_field": ""
    },
    "path_template": "/report/api/v3/dataanalysis/user/event/list/",
    "privacy_policy": {
      "classification": "user_level",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password",
        "secret",
        "refresh_token",
        "session_token"
      ]
    },
    "provenance": {
      "applied_overrides": [],
