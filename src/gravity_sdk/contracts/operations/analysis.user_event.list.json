        "page",
        "page_size",
        "fields",
        "desc",
        "group_by",
        "event_list",
        "query_item_list"
      ],
      "defaults": {
        "desc": true,
        "event_list": [],
        "fields": [],
        "group_by": "day",
        "page": 1,
