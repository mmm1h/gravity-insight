{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 4,
  "operation": {
    "action": "list",
    "auth_profile": "gravity_authorization",
    "contract_version": 3,
    "description": "指定 App 的推广对象列表；固定使用当前 Analysis/PostBackMap 页面已验证的 origin 与 performance_mode=1 profile，支持前端 5000 条页大小，最小探针从 app.list 解析首个 App。",
    "domain": "promotion",
    "effect": "read",
    "examples": [],
    "input_fields": {
      "app_id": {
        "required": true,
        "type": "string"
      },
      "page": {
        "default": 1,
        "type": "integer"
      },
      "page_size": {
        "default": 20,
        "type": "integer"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_id": "$first_app_id",
        "page": 1,
        "page_size": 1
      }
    },
    "operation_id": "promotion.object.list",
    "pagination": {
      "default_page_size": 20,
      "kind": "page_info",
      "list_path": "data.list",
      "max_page_size": 5000,
      "page_field": "page",
      "page_info_path": "data.page_info",
      "page_size_field": "page_size",
      "total_page_field": "total_page"
    },
    "path_template": "/turbo_engine/api/v1/user/promoted_object/list/",
    "privacy_policy": {
      "classification": "internal_business",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password"
      ]
    },
    "provenance": {
      "applied_overrides": [],
      "family": null,
      "platform": null,
      "source_files": [
        "operations/promotion.object.list.json"
      ]
    },
    "request": {
      "body_fields": [],
      "defaults": {
        "page": 1,
        "page_size": 20
      },
      "fixed_body": {},
      "fixed_query": {
        "origin": "PostBackMap_PostBackMap",
        "performance_mode": 1
      },
      "path_fields": [],
      "query_fields": [
        "app_id",
        "page",
        "page_size"
      ]
    },
    "required_parent": [
      {
        "input_field": null,
        "operation_id": "app.list",
        "output_path": "data.list[].id",
        "selection": "first"
      }
    ],
    "resource": "object",
    "response_projection": {
      "data_keys": [
        "list",
        "page_info"
      ],
      "dynamic_item_fields": [],
      "item_keys": [
        "create_time",
        "modify_time",
        "app_id",
        "turbo_promoted_object_id",
        "turbo_promoted_object_name",
        "state"
      ],
      "known_omitted_item_keys": [
        "remark"
      ],
      "required_data_keys": [
        "list"
      ]
    },
    "semantic_error_rules": [
      "code",
      "extra.error"
    ],
    "stability": "stable",
    "upstream_method": "GET"
  },
  "source_schema_version": 2,
  "target_manifest": "other.json"
}
