{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 7,
  "operation": {
    "action": "list",
    "auth_profile": "gravity_authorization",
    "contract_version": 1,
    "description": "分页列出指定巨量广告主账户的图片素材，供创意组件选择素材标识和尺寸信息。",
    "domain": "material",
    "effect": "read",
    "examples": [],
    "executable": true,
    "input_fields": {
      "advertiser_id": {
        "description": "巨量账户列表已验证 advertiser_id 为整数；网页创意组件将该值原样传给素材接口。",
        "required": true,
        "type": "integer"
      },
      "page": {
        "default": 1,
        "description": "Frontend-observed candidate from route-params.json (confidence=high, presence=observed_always); presence describes frontend calls and is not a server-required declaration.",
        "type": "integer"
      },
      "page_size": {
        "default": 20,
        "description": "每页素材数；网页使用整数，SDK 默认收窄到 20 以控制读取成本。",
        "type": "integer"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "advertiser_id": "$parent:advertiser_id",
        "page": 1,
        "page_size": 1
      }
    },
    "operation_id": "material.bytedance_asset_material.list",
    "pagination": {
      "default_page_size": 20,
      "kind": "page_info",
      "list_path": "data.list",
      "max_page_size": 100,
      "page_field": "page",
      "page_info_path": "data.page_info",
      "page_size_field": "page_size",
      "total_page_field": "total_page"
    },
    "path_template": "/turbo_engine/api/v1/bytedance/asset/material/list/",
    "platform": "bytedance",
