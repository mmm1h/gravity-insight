{
  "schema_version": "gravity.material-asset-contract.v2",
  "effect": "material_file_download",
  "input_boundary": "private_url_from_fresh_registered_operation_response",
  "accepts_caller_url": false,
  "public_source_projection": "url_fields_omitted",
  "initial_host_policy": "contract_allowlist",
  "redirect_policy": "same_host_only",
  "output_policy": "root_bound_relative_atomic_no_clobber",
  "receipt_policy": "value_free_http_references",
  "sources": {
    "local": {
      "operation_id": "material.local.list",
      "list_path": ["data", "list"],
      "reference_fields": ["id", "gravity_material_id", "material_id"],
      "roles": {
        "file": {
          "url_field": "file_url",
          "allowed_sources": [
            {
              "host": "tos-accelerate.gravity-engine.com",
              "path_pattern": "^/[^/]+/video/[^/]+\\.mp4$"
            }
          ],
          "observed_content_type": "video/mp4",
          "extensions": [".mp4"],
          "magic_signatures": [{"offset": 4, "hex": "66747970"}],
          "max_bytes": 1073741824,
          "max_redirects": 3,
          "timeout_seconds": 120
        },
        "thumbnail": {
          "url_field": "thumbnail_url",
          "allowed_sources": [
            {
              "host": "tos-accelerate.gravity-engine.com",
              "path_pattern": "^/[^/]+/image/video_thumbnail_url_[^/]+\\.jpg$"
            }
          ],
          "observed_content_type": "image/jpeg",
          "extensions": [".jpg", ".jpeg"],
          "magic_signatures": [{"offset": 0, "hex": "ffd8ff"}],
          "max_bytes": 16777216,
          "max_redirects": 3,
          "timeout_seconds": 120
        }
      },
      "declared_size_field": "file_size",
      "declared_md5_field": "file_md5"
    },
    "bytedance_project": {
      "operation_id": "material.bytedance.project_material.list",
      "list_path": ["data", "video_material_list"],
      "reference_fields": ["material_id"],
      "roles": {
        "file": {
          "url_field": "file_url",
          "allowed_sources": [
            {
              "host": "v26-cc.oceanengine.com",
              "path_pattern": "^/[^/]+/[^/]+/video/tos/cn/tos-cn-ve-51/[^/]+$"
            }
          ],
          "observed_content_type": "video/mp4",
          "extensions": [".mp4"],
          "magic_signatures": [{"offset": 4, "hex": "66747970"}],
          "max_bytes": 1073741824,
          "max_redirects": 3,
          "timeout_seconds": 120
        },
        "thumbnail": {
          "url_field": "thumbnail_url",
          "allowed_sources": [
            {
              "host": "p26-sign.douyinpic.com",
              "path_pattern": "^/tos-cn-v-[0-9]+/[^/]+~tplv-noop\\.image$"
            }
          ],
          "observed_content_type": "image/jpeg",
          "extensions": [".jpg", ".jpeg"],
          "magic_signatures": [{"offset": 0, "hex": "ffd8ff"}],
          "max_bytes": 16777216,
          "max_redirects": 3,
          "timeout_seconds": 120
        }
      }
    }
  },
  "http_status_categories": {
    "200": "success",
    "same_host_redirect_with_location": "follow",
    "indistinguishable_terminal_4xx": "binary_unavailable",
    "429_or_retryable_terminal_status": "upstream"
  },
  "unavailable_error_code": "MATERIAL_ASSET_BINARY_UNAVAILABLE",
  "unsupported_source_error_code": "MATERIAL_ASSET_SOURCE_UNSUPPORTED",
  "local_failure_category": "local",
  "caller_input_failure_category": "caller"
}
