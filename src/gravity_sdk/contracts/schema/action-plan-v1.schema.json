{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.action-plan.v1",
  "type": "object",
  "required": ["schema_version", "ok", "status", "plan_id", "action_kind", "connector", "confirmation_summary", "preview_fingerprint", "created_at", "expires_at", "policy"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.action-plan.v1"},
    "ok": {"const": true},
    "status": {"const": "previewed"},
    "plan_id": {"type": "string", "pattern": "^act1_[0-9a-f]{32}_[0-9a-f]{32}$"},
    "action_kind": {"enum": ["segment.update_metadata", "dashboard.publish_analysis_artifact"]},
    "connector": {"type": "object"},
    "confirmation_summary": {"type": "object"},
    "preview_fingerprint": {"$ref": "#/$defs/digest"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "policy": {"$ref": "#/$defs/policy"}
  },
  "oneOf": [
    {
      "properties": {
        "action_kind": {"const": "segment.update_metadata"},
        "connector": {"$ref": "#/$defs/segment_connector"},
        "confirmation_summary": {"$ref": "#/$defs/segment_summary"}
      }
    },
    {
      "properties": {
        "action_kind": {"const": "dashboard.publish_analysis_artifact"},
        "connector": {"$ref": "#/$defs/dashboard_connector"},
        "confirmation_summary": {"$ref": "#/$defs/dashboard_summary"}
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "segment_connector": {"type": "object", "required": ["id", "version"], "additionalProperties": false, "properties": {"id": {"const": "gravity.segment-metadata-update"}, "version": {"const": 1}}},
    "dashboard_connector": {"type": "object", "required": ["id", "version"], "additionalProperties": false, "properties": {"id": {"const": "gravity.analysis-dashboard-notes"}, "version": {"const": 1}}},
    "policy": {
      "type": "object",
      "required": ["schema_version", "decision_id", "policy_revision", "decision", "reason_codes", "evaluated_effect", "masked_paths"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "gravity.policy-decision.v1"},
        "decision_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "policy_revision": {"const": "gravity.action-policy.v1"},
        "decision": {"enum": ["allow", "deny", "require_confirmation"]},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
        "evaluated_effect": {"const": "mutation"},
        "masked_paths": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "segment_summary": {
      "type": "object",
      "required": ["target", "expected_changes", "managed_fields", "ownership_basis", "readback_assertions", "limitations"],
      "additionalProperties": false,
      "properties": {
        "target": {"type": "object", "required": ["kind", "segment_id"], "additionalProperties": false, "properties": {"kind": {"const": "segment"}, "segment_id": {"type": "string", "pattern": "^[0-9]{1,64}$"}}},
        "expected_changes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
        "managed_fields": {"const": ["segment_name", "segment_remark"]},
        "ownership_basis": {"enum": ["sdk_source_marker", "upstream_owner"]},
        "readback_assertions": {"const": ["segment_name", "segment_remark", "field_ownership"]},
        "limitations": {"const": ["upstream_revision_unavailable", "external_change_after_last_preimage_read_is_detectable_only_by_readback"]}
      }
    },
    "dashboard_summary": {
      "type": "object",
      "required": ["target", "expected_changes", "managed_fields", "ownership_basis", "readback_assertions", "limitations"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "required": ["kind", "app_id", "space_id", "dashboard_id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "dashboard"},
            "app_id": {"type": "integer", "minimum": 1},
            "space_id": {"type": "integer", "minimum": 1},
            "dashboard_id": {"type": "integer", "minimum": 1}
          }
        },
        "expected_changes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
        "managed_fields": {"const": ["dashboard_notes"]},
        "ownership_basis": {"enum": ["sdk_source_marker", "upstream_owner"]},
        "readback_assertions": {"const": ["dashboard_identity", "note_content_markers", "source_artifact_binding"]},
        "limitations": {"const": ["note_only_dashboard_required", "markdown_notes_artifact_scope_single_column_only"]}
      }
    }
  }
}
