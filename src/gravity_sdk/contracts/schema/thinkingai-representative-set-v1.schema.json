{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.thinkingai-representative-set.v1",
  "type": "object",
  "required": [
    "artifact_kind", "schema_version", "source_snapshot_sha256",
    "source_observation_sha256", "representative_count", "dependency_shapes",
    "representatives", "network_called", "representative_set_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "thinkingai_representative_set"},
    "schema_version": {"const": "gravity.thinkingai-representative-set.v1"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "representative_count": {"const": 5},
    "dependency_shapes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dependency_shape"}
    },
    "representatives": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/representative"}
    },
    "network_called": {"const": false},
    "representative_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "dependency_shape": {
      "enum": [
        "capability_only", "project_semantic", "deterministic_operator",
        "required_context", "blocked_model"
      ]
    },
    "representative": {
      "type": "object",
      "required": [
        "source_id", "skill_uri", "journey_id", "dependency_shape",
        "manifest_sha256", "package_sha256", "archive_sha256", "specification",
        "lifecycle", "readiness", "validation", "declared_blockers",
        "distribution_allowed", "independent_authorship", "source_content_used"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string", "minLength": 1, "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "skill_uri": {
          "type": "string", "minLength": 24, "maxLength": 160,
          "pattern": "^skill://gravity\\.game/[a-z0-9]+(?:-[a-z0-9]+)*@1\\.0\\.0$"
        },
        "journey_id": {
          "type": "string", "minLength": 3, "maxLength": 256,
          "pattern": "^analysis\\.thinkingai\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "dependency_shape": {"$ref": "#/$defs/dependency_shape"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "specification": {"const": "specified"},
        "lifecycle": {"const": "reviewed"},
        "readiness": {"enum": ["blocked", "executable"]},
        "validation": {"const": "validated"},
        "declared_blockers": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
        },
        "distribution_allowed": {"const": true},
        "independent_authorship": {"const": true},
        "source_content_used": {"const": false}
      }
    }
  }
}
