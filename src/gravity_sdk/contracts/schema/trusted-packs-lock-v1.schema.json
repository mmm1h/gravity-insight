{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.trusted-packs-lock.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "source", "runtime_version", "requested", "packs", "lock_digest"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "trusted_packs_lock"},
    "schema_version": {"const": "gravity.trusted-packs-lock.v1"},
    "source": {"type": "object"},
    "runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "requested": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 256}},
    "packs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/pack"}},
    "lock_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack": {
      "type": "object",
      "required": ["pack_id", "descriptor_digest", "distribution", "version", "wheel_sha256", "artifact_path", "artifact_size", "runtime_compatibility", "allowed_groups", "operators", "models"],
      "additionalProperties": false,
      "properties": {
        "pack_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "descriptor_digest": {"$ref": "#/$defs/digest"},
        "distribution": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
        "wheel_sha256": {"$ref": "#/$defs/digest"},
        "artifact_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "artifact_size": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "runtime_compatibility": {"type": "object"},
        "allowed_groups": {"type": "array"},
        "operators": {"type": "array"},
        "models": {"type": "array"}
      }
    }
  }
}
