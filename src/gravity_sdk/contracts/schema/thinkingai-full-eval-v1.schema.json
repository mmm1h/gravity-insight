{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.thinkingai-full-eval.v1",
  "type": "object",
  "required": [
    "artifact_kind", "schema_version", "suite_id", "specification_sha256",
    "representative_eval_sha256", "case_count", "reason_codes_covered", "cases",
    "network_called", "eval_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "thinkingai_full_eval"},
    "schema_version": {"const": "gravity.thinkingai-full-eval.v1"},
    "suite_id": {"const": "thinkingai-full-specification-regression-v1"},
    "specification_sha256": {"$ref": "#/$defs/digest"},
    "representative_eval_sha256": {"$ref": "#/$defs/digest"},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "reason_codes_covered": {"$ref": "#/$defs/reason_array"},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {"$ref": "#/$defs/case"}
    },
    "network_called": {"const": false},
    "eval_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_array": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$", "maxLength": 128}
    },
    "claim_array": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128}
    },
    "case": {
      "type": "object",
      "required": [
        "case_id", "source_id", "scenario", "expected_outcome", "result_status",
        "reason_codes", "allowed_claims", "forbidden_claims", "network_called"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
        "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
        "scenario": {
          "enum": [
            "claim_boundary", "content_leakage_rejection", "dependency_gap",
            "safe_alternative", "source_change_review", "source_removal_history",
            "supported_control", "tamper_rejection"
          ]
        },
        "expected_outcome": {"enum": ["pass", "blocked", "review", "reject"]},
        "result_status": {
          "enum": ["success", "blocked", "safe_alternative", "review_required", "historical", "rejected"]
        },
        "reason_codes": {"$ref": "#/$defs/reason_array"},
        "allowed_claims": {"$ref": "#/$defs/claim_array"},
        "forbidden_claims": {"$ref": "#/$defs/claim_array"},
        "network_called": {"const": false}
      }
    }
  }
}
