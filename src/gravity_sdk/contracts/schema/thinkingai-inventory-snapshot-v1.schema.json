{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.thinkingai-inventory-snapshot.v1",
  "type": "object",
  "required": [
    "artifact_kind", "schema_version", "source_adapter", "source_observation",
    "crawl_scope", "category_counts", "item_count", "items", "network_called",
    "snapshot_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "thinkingai_inventory_snapshot"},
    "schema_version": {"const": "gravity.thinkingai-inventory-snapshot.v1"},
    "source_adapter": {"$ref": "#/$defs/source_adapter"},
    "source_observation": {"$ref": "#/$defs/snapshot_reference"},
    "crawl_scope": {"$ref": "#/$defs/scope"},
    "category_counts": {"$ref": "#/$defs/category_counts"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/item"}
    },
    "network_called": {"const": false},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "source_adapter": {
      "type": "object",
      "required": ["adapter_id", "version"],
      "additionalProperties": false,
      "properties": {
        "adapter_id": {"const": "thinkingai-public-catalog-dom"},
        "version": {"const": 1}
      }
    },
    "snapshot_reference": {
      "type": "object",
      "required": ["observed_at", "observation_sha256"],
      "additionalProperties": false,
      "properties": {
        "observed_at": {"type": "string", "minLength": 20, "maxLength": 32},
        "observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "root_url", "robots_url", "robots_status", "sitemap_url",
        "catalog_language", "detail_route_pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "root_url": {"const": "https://www.thinkingai.cn/skills/"},
        "robots_url": {"const": "https://www.thinkingai.cn/robots.txt"},
        "robots_status": {"const": "allowed_except_backend_and_cj_booth"},
        "sitemap_url": {"const": "https://www.thinkingai.cn/sitemap.xml"},
        "catalog_language": {"const": "zh-CN"},
        "detail_route_pattern": {"const": "https://www.thinkingai.cn/skills/<source-id>/"}
      }
    },
    "category": {
      "enum": [
        "付费分析", "游戏分析", "用户分析", "数据分析", "异常诊断", "舆情分析",
        "数据工程", "数据采集", "运营分析", "Agent", "知识库管理"
      ]
    },
    "category_counts": {
      "type": "object",
      "required": [
        "付费分析", "游戏分析", "用户分析", "数据分析", "异常诊断", "舆情分析",
        "数据工程", "数据采集", "运营分析", "Agent", "知识库管理"
      ],
      "additionalProperties": false,
      "properties": {
        "付费分析": {"type": "integer", "minimum": 0, "maximum": 1000},
        "游戏分析": {"type": "integer", "minimum": 0, "maximum": 1000},
        "用户分析": {"type": "integer", "minimum": 0, "maximum": 1000},
        "数据分析": {"type": "integer", "minimum": 0, "maximum": 1000},
        "异常诊断": {"type": "integer", "minimum": 0, "maximum": 1000},
        "舆情分析": {"type": "integer", "minimum": 0, "maximum": 1000},
        "数据工程": {"type": "integer", "minimum": 0, "maximum": 1000},
        "数据采集": {"type": "integer", "minimum": 0, "maximum": 1000},
        "运营分析": {"type": "integer", "minimum": 0, "maximum": 1000},
        "Agent": {"type": "integer", "minimum": 0, "maximum": 1000},
        "知识库管理": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "source_url": {
      "type": "string",
      "minLength": 40,
      "maxLength": 256,
      "pattern": "^https://www\\.thinkingai\\.cn/skills/[a-z0-9]+(?:-[a-z0-9]+)*/$"
    },
    "taxonomy": {
      "enum": [
        "taxonomy://gravity/monetization@1", "taxonomy://gravity/gameplay@1",
        "taxonomy://gravity/user@1", "taxonomy://gravity/analysis@1",
        "taxonomy://gravity/diagnostics@1", "taxonomy://gravity/community@1",
        "taxonomy://gravity/data-engineering@1", "taxonomy://gravity/data-collection@1",
        "taxonomy://gravity/operations@1", "taxonomy://gravity/agent@1",
        "taxonomy://gravity/knowledge@1"
      ]
    },
    "item": {
      "type": "object",
      "required": [
        "source_id", "source_url", "source_title", "source_categories",
        "gravity_taxonomy_ids", "source_content_sha256", "specification_state",
        "mapping_kind", "future_skill_uri", "alternative_reason_code",
        "license_review", "independent_authorship", "distribution_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_url": {"$ref": "#/$defs/source_url"},
        "source_title": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/category"}
        },
        "gravity_taxonomy_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/taxonomy"}
        },
        "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "specification_state": {"const": "catalogued"},
        "mapping_kind": {"enum": ["future_skill", "out_of_scope_alternative"]},
        "future_skill_uri": {
          "type": ["string", "null"],
          "maxLength": 160,
          "pattern": "^skill://gravity\\.game/[a-z0-9]+(?:-[a-z0-9]+)*@1\\.0\\.0$"
        },
        "alternative_reason_code": {
          "enum": [
            "THINKINGAI_VENDOR_SPECIFIC_OPERATION",
            "AUTOMATIC_TEXT_TO_SQL_OUT_OF_SCOPE",
            "LICENSE_REVIEW_REQUIRED",
            null
          ]
        },
        "license_review": {"enum": ["approved", "blocked", "needs_review"]},
        "independent_authorship": {"enum": ["required", "not_applicable"]},
        "distribution_allowed": {"const": false}
      }
    }
  }
}
