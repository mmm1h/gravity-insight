{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.analysis-playbook-definition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "playbook_id",
    "version",
    "goal",
    "semantic_definition",
    "members",
    "required_inputs",
    "steps",
    "stop_conditions",
    "allowed_claims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "gravity.analysis-playbook-definition.v1"},
    "playbook_id": {"const": "metric-anomaly-localization"},
    "version": {"const": 1},
    "goal": {"type": "string", "minLength": 1},
    "semantic_definition": {"$ref": "#/$defs/ref"},
    "members": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "dimension", "filter", "grain", "join"],
      "properties": {
        "metric": {"$ref": "#/$defs/ref"},
        "dimension": {"$ref": "#/$defs/ref"},
        "filter": {"$ref": "#/$defs/ref"},
        "grain": {"$ref": "#/$defs/ref"},
        "join": {"$ref": "#/$defs/ref"}
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "outcome"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1}
        }
      }
    },
    "allowed_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version"],
      "properties": {
        "definition_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "product",
        "contract",
        "depends_on",
        "input_dependencies",
        "fact_path"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "kind": {"enum": ["query", "local"]},
        "product": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "input_dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "fact_path": {"type": ["string", "null"]}
      }
    }
  }
}
