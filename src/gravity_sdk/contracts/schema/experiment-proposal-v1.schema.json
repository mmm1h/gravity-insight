{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.experiment-proposal.v1",
  "type": "object",
  "required": ["schema_version", "proposal_id", "proposal_digest", "status", "source_analysis", "planning_snapshot_digest", "hypothesis", "target_segment", "primary_metric", "guardrails", "power_analysis", "context_assumptions", "readiness", "reason_codes", "experiment_creation_authorized", "automatic_execution", "created_at", "network_called"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.experiment-proposal.v1"},
    "proposal_id": {"type": "string", "pattern": "^exp1_[0-9a-f]{32}$"},
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["proposal_only", "ready_for_review"]},
    "source_analysis": {"$ref": "#/$defs/source_analysis"},
    "planning_snapshot_digest": {"$ref": "#/$defs/digest"},
    "hypothesis": {"$ref": "#/$defs/hypothesis"},
    "target_segment": {"anyOf": [{"$ref": "#/$defs/segment"}, {"type": "null"}]},
    "primary_metric": {"anyOf": [{"$ref": "#/$defs/metric"}, {"type": "null"}]},
    "guardrails": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}},
    "power_analysis": {"anyOf": [{"$ref": "#/$defs/power_analysis"}, {"type": "null"}]},
    "context_assumptions": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/context_assumption"}},
    "readiness": {"$ref": "#/$defs/readiness"},
    "reason_codes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}},
    "experiment_creation_authorized": {"const": false},
    "automatic_execution": {"const": false},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "network_called": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "window": {"type": "object", "required": ["start", "end", "timezone"], "additionalProperties": false, "properties": {"start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}, "timezone": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "journey": {"type": "object", "required": ["journey_id", "version", "digest"], "additionalProperties": false, "properties": {"journey_id": {"type": "string", "minLength": 3, "maxLength": 256}, "version": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "skill": {"type": "object", "required": ["uri", "version", "package_digest"], "additionalProperties": false, "properties": {"uri": {"type": "string", "minLength": 8, "maxLength": 256}, "version": {"type": "string", "minLength": 1, "maxLength": 64}, "package_digest": {"$ref": "#/$defs/digest"}}},
    "source_analysis": {
      "type": "object",
      "required": ["result_digest", "journey", "skill", "snapshot_digest", "scope_digest", "evidence_level", "source_window", "window_verified"],
      "additionalProperties": false,
      "properties": {
        "result_digest": {"$ref": "#/$defs/digest"},
        "journey": {"$ref": "#/$defs/journey"},
        "skill": {"anyOf": [{"$ref": "#/$defs/skill"}, {"type": "null"}]},
        "snapshot_digest": {"$ref": "#/$defs/digest"},
        "scope_digest": {"$ref": "#/$defs/digest"},
        "evidence_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "source_window": {"$ref": "#/$defs/window"},
        "window_verified": {"type": "boolean"}
      }
    },
    "hypothesis": {"type": "object", "required": ["statement", "direction", "rationale_digest", "role"], "additionalProperties": false, "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 4096}, "direction": {"enum": ["increase", "decrease", "two_sided"]}, "rationale_digest": {"$ref": "#/$defs/digest"}, "role": {"const": "data"}}},
    "segment": {"type": "object", "required": ["uri", "digest", "source"], "additionalProperties": false, "properties": {"uri": {"type": "string", "pattern": "^segment://[A-Za-z0-9._:/@-]{1,240}$"}, "digest": {"$ref": "#/$defs/digest"}, "source": {"enum": ["registered_segment", "action_readback"]}}},
    "metric": {
      "type": "object",
      "required": ["uri", "version", "definition_digest", "binding_digest", "registry_digest", "status", "direction"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "version": {"type": ["integer", "null"], "minimum": 1},
        "definition_digest": {"$ref": "#/$defs/nullable_digest"},
        "binding_digest": {"$ref": "#/$defs/nullable_digest"},
        "registry_digest": {"$ref": "#/$defs/nullable_digest"},
        "status": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "direction": {"enum": ["increase", "decrease", "two_sided"]}
      }
    },
    "context_assumption": {"type": "object", "required": ["assumption_id", "assumption_digest", "requirement_uri", "pack_digest"], "additionalProperties": false, "properties": {"assumption_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}, "assumption_digest": {"$ref": "#/$defs/digest"}, "requirement_uri": {"type": "string", "minLength": 8, "maxLength": 256}, "pack_digest": {"$ref": "#/$defs/digest"}}},
    "power_analysis": {"type": "object", "required": ["schema_version", "status", "operator", "primary_metric_uri", "target_segment_digest", "alpha", "power", "minimum_detectable_effect", "minimum_sample_size_per_arm", "reason_codes", "result_digest"], "additionalProperties": false, "properties": {"schema_version": {"const": "gravity.experiment-power-analysis.v1"}, "status": {"enum": ["complete", "unavailable"]}, "operator": {"anyOf": [{"$ref": "#/$defs/operator"}, {"type": "null"}]}, "primary_metric_uri": {"type": ["string", "null"], "maxLength": 256}, "target_segment_digest": {"$ref": "#/$defs/nullable_digest"}, "alpha": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "power": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "minimum_detectable_effect": {"type": ["number", "null"], "minimum": 0}, "minimum_sample_size_per_arm": {"type": ["integer", "null"], "minimum": 1, "maximum": 2147483647}, "reason_codes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}}, "result_digest": {"$ref": "#/$defs/nullable_digest"}}},
    "operator": {"type": "object", "required": ["uri", "version", "digest", "assumptions_digest"], "additionalProperties": false, "properties": {"uri": {"type": "string", "pattern": "^operator://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"}, "version": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}, "assumptions_digest": {"$ref": "#/$defs/digest"}}},
    "readiness": {"type": "object", "required": ["source_window", "target_segment", "primary_metric", "guardrails", "power_analysis", "context_assumptions"], "additionalProperties": false, "properties": {"source_window": {"enum": ["satisfied", "unresolved"]}, "target_segment": {"enum": ["satisfied", "missing"]}, "primary_metric": {"enum": ["satisfied", "missing", "unresolved"]}, "guardrails": {"enum": ["satisfied", "missing", "unresolved"]}, "power_analysis": {"enum": ["satisfied", "missing", "unresolved"]}, "context_assumptions": {"enum": ["satisfied", "missing", "unresolved"]}}}
  }
}
