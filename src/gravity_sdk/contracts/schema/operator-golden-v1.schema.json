{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.operator-golden.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "operator_uri", "cases"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "operator_golden"},
    "schema_version": {"const": "gravity.operator-golden.v1"},
    "operator_uri": {"type": "string", "pattern": "^operator://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["case_id", "input", "expected"],
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "input": {"type": "object"},
          "expected": {"type": "object"}
        }
      }
    }
  }
}
