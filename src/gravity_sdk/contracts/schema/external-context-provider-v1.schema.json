{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.external-context-provider.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "uri", "version", "provider_id", "owner", "transport", "effects", "auth_scope", "resource_types", "allowed_resource_prefixes", "capabilities", "rpc", "deployment", "source_trust", "role"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "external_context_provider"},
    "schema_version": {"const": "gravity.external-context-provider.v1"},
    "uri": {"type": "string", "pattern": "^context-provider://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$", "maxLength": 256},
    "version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
    "owner": {"type": "string", "minLength": 1, "maxLength": 128},
    "transport": {"enum": ["mcp", "subprocess", "host"]},
    "effects": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "read"}},
    "auth_scope": {"enum": ["project", "team", "user"]},
    "resource_types": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["document", "code", "configuration", "contract", "release", "git_fact", "project_semantic"]}},
    "allowed_resource_prefixes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 5, "maxLength": 512}},
    "capabilities": {
      "type": "object",
      "required": ["operations", "supports_cancellation", "supports_cache", "output_formats", "freshness_model", "entity_time_alignment"],
      "additionalProperties": false,
      "properties": {
        "operations": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["list", "search", "read", "list_changed"]}},
        "supports_cancellation": {"type": "boolean"},
        "supports_cache": {"type": "boolean"},
        "output_formats": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "json"}},
        "freshness_model": {"enum": ["provider_revision", "content_hash", "ttl", "none"]},
        "entity_time_alignment": {"enum": ["full", "partial", "none"]}
      }
    },
    "rpc": {
      "type": "object",
      "required": ["max_concurrency", "max_calls_per_session", "timeout_ms", "cancellation_grace_ms", "max_attempts", "max_output_bytes", "max_output_tokens", "circuit_failure_threshold", "circuit_cooldown_ms"],
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_calls_per_session": {"type": "integer", "minimum": 1, "maximum": 10000},
        "timeout_ms": {"type": "integer", "minimum": 10, "maximum": 120000},
        "cancellation_grace_ms": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_output_bytes": {"type": "integer", "minimum": 256, "maximum": 67108864},
        "max_output_tokens": {"type": "integer", "minimum": 64, "maximum": 16777216},
        "circuit_failure_threshold": {"type": "integer", "minimum": 1, "maximum": 20},
        "circuit_cooldown_ms": {"type": "integer", "minimum": 10, "maximum": 3600000}
      }
    },
    "deployment": {
      "type": "object",
      "required": ["sandbox_owner", "declared_egress_hosts", "inherits_gravity_credentials", "subprocess"],
      "additionalProperties": false,
      "properties": {
        "sandbox_owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "declared_egress_hosts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+(?::[0-9]{1,5})?$", "maxLength": 256}},
        "inherits_gravity_credentials": {"const": false},
        "subprocess": {
          "type": ["object", "null"],
          "required": ["executable", "arguments", "working_directory"],
          "additionalProperties": false,
          "properties": {
            "executable": {"type": "string", "minLength": 1, "maxLength": 2048},
            "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}},
            "working_directory": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        }
      }
    },
    "source_trust": {"enum": ["reviewed", "observed", "untrusted"]},
    "role": {"const": "data"}
  }
}
