{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.skill-hub-index.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "index_version", "skills", "trusted_packs"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "skill_hub_index"},
    "schema_version": {"const": "gravity.skill-hub-index.v1"},
    "index_version": {"const": 1},
    "skills": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/skill"}},
    "trusted_packs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/trusted_pack"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "media_type": {"enum": ["application/vnd.gravity.skill-package.v1+zip", "application/vnd.python.wheel"]}
      }
    },
    "skill": {
      "type": "object",
      "required": ["skill_uri", "manifest", "package", "archive"],
      "additionalProperties": false,
      "properties": {
        "skill_uri": {"type": "string", "pattern": "^skill://[a-z][a-z0-9.-]*/[a-z0-9-]+@[0-9A-Za-z.-]+$", "maxLength": 256},
        "manifest": {"type": "object"},
        "package": {"type": "object"},
        "archive": {"$ref": "#/$defs/archive"}
      }
    },
    "trusted_pack": {
      "type": "object",
      "required": ["pack_id", "descriptor", "descriptor_digest", "archive"],
      "additionalProperties": false,
      "properties": {
        "pack_id": {"type": "string", "pattern": "^trusted-pack://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$", "maxLength": 256},
        "descriptor": {"type": "object"},
        "descriptor_digest": {"$ref": "#/$defs/digest"},
        "archive": {"$ref": "#/$defs/archive"}
      }
    }
  }
}
