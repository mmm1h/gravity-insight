{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.semantic-definition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_id",
    "version",
    "description",
    "source",
    "access_scope",
    "limits",
    "metrics",
    "dimensions",
    "filters",
    "grains",
    "joins",
    "allowed_claims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "gravity.semantic-definition.v1"},
    "definition_id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "operation_id", "operation_contract_version", "fact_path"],
      "properties": {
        "product": {"const": "multidim"},
        "operation_id": {"const": "report.multidim.query"},
        "operation_contract_version": {"type": "integer", "minimum": 1},
        "fact_path": {"type": "string", "pattern": "^/"},
        "request_profile": {"const": "frontend_adreport_current"}
      }
    },
    "access_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "physical_filter"],
      "properties": {
        "kind": {"const": "app_bound"},
        "physical_filter": {"const": "app_id"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "dimensions", "filters", "joins"],
      "properties": {
        "metrics": {"const": 1},
        "dimensions": {"type": "integer", "minimum": 0, "maximum": 8},
        "filters": {"type": "integer", "minimum": 0, "maximum": 8},
        "joins": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
    "grains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grain"}},
    "joins": {"type": "array", "items": {"$ref": "#/$defs/join"}},
    "allowed_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "member": {
      "type": "object",
      "required": ["definition_id", "version", "physical_name"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "physical_name": {"type": "string", "minLength": 1}
      }
    },
    "metric": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition_id", "version", "physical_name", "metadata_operation", "allowed_grains"],
          "properties": {
            "definition_id": {"$ref": "#/$defs/id"},
            "version": {"type": "integer", "minimum": 1},
            "physical_name": {"type": "string", "minLength": 1},
            "metadata_operation": {"const": "report.multidim.metric.list"},
            "allowed_grains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version", "physical_name", "required_join"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "physical_name": {"type": "string", "minLength": 1},
        "required_join": {"$ref": "#/$defs/id"}
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version", "physical_name", "operators", "required_dimension"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "physical_name": {"type": "string", "minLength": 1},
        "operators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "required_dimension": {"$ref": "#/$defs/id"}
      }
    },
    "grain": {"$ref": "#/$defs/member"},
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version", "left_source", "right_member", "cardinality", "realization"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "left_source": {"type": "string", "minLength": 1},
        "right_member": {"$ref": "#/$defs/id"},
        "cardinality": {"enum": ["one_to_one", "many_to_one"]},
        "realization": {"const": "embedded_dimension"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1}
      }
    }
  }
}
