{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.experiment-proposal-request.v1",
  "type": "object",
  "required": ["schema_version", "source_analysis_result", "planning_snapshot", "hypothesis", "source_window", "target_segment", "primary_metric", "guardrails", "power_analysis", "context_assumptions", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.experiment-proposal-request.v1"},
    "source_analysis_result": {"type": "object"},
    "planning_snapshot": {"type": "object"},
    "hypothesis": {"$ref": "#/$defs/hypothesis"},
    "source_window": {"$ref": "#/$defs/window"},
    "target_segment": {"anyOf": [{"$ref": "#/$defs/segment"}, {"type": "null"}]},
    "primary_metric": {"anyOf": [{"$ref": "#/$defs/metric_request"}, {"type": "null"}]},
    "guardrails": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/guardrail_request"}},
    "power_analysis": {"type": ["object", "null"]},
    "context_assumptions": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/context_assumption"}},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "hypothesis": {
      "type": "object",
      "required": ["statement", "direction", "rationale_digest"],
      "additionalProperties": false,
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
        "direction": {"enum": ["increase", "decrease", "two_sided"]},
        "rationale_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "window": {
      "type": "object",
      "required": ["start", "end", "timezone"],
      "additionalProperties": false,
      "properties": {
        "start": {"$ref": "#/$defs/date"},
        "end": {"$ref": "#/$defs/date"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "segment": {
      "type": "object",
      "required": ["uri", "digest", "source"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "pattern": "^segment://[A-Za-z0-9._:/@-]{1,240}$"},
        "digest": {"$ref": "#/$defs/digest"},
        "source": {"enum": ["registered_segment", "action_readback"]}
      }
    },
    "metric_request": {
      "type": "object",
      "required": ["uri", "success_direction"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "success_direction": {"enum": ["increase", "decrease", "two_sided"]}
      }
    },
    "guardrail_request": {
      "type": "object",
      "required": ["uri", "breach_direction"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "breach_direction": {"enum": ["increase", "decrease", "two_sided"]}
      }
    },
    "context_assumption": {
      "type": "object",
      "required": ["assumption_id", "assumption_digest", "requirement_uri", "pack_digest"],
      "additionalProperties": false,
      "properties": {
        "assumption_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "assumption_digest": {"$ref": "#/$defs/digest"},
        "requirement_uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "pack_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
