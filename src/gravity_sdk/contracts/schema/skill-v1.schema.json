{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.skill.v1",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "namespace",
    "skill_id",
    "version",
    "specification",
    "lifecycle",
    "readiness",
    "validation",
    "summary",
    "description",
    "runtime_requires",
    "covers_journeys",
    "capability_dependencies",
    "semantic_dependencies",
    "operator_dependencies",
    "model_dependencies",
    "context_dependencies",
    "routing",
    "requirements",
    "claim_policy",
    "effects",
    "request_budget",
    "output_schema",
    "provenance",
    "guide"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "skill"},
    "schema_version": {"const": "gravity.skill.v1"},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"},
    "skill_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "specification": {"enum": ["untracked", "catalogued", "specified"]},
    "lifecycle": {"enum": ["draft", "reviewed", "stable", "deprecated", "revoked"]},
    "readiness": {"enum": ["blocked", "executable"]},
    "validation": {"enum": ["unvalidated", "validated"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "runtime_requires": {"type": "string", "minLength": 1, "maxLength": 128},
    "covers_journeys": {"$ref": "#/$defs/uri_array"},
    "capability_dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/capability_requirement"}},
    "semantic_dependencies": {"$ref": "#/$defs/uri_array"},
    "operator_dependencies": {"$ref": "#/$defs/uri_array"},
    "model_dependencies": {"$ref": "#/$defs/uri_array"},
    "context_dependencies": {
      "type": "object",
      "required": ["required", "optional"],
      "additionalProperties": false,
      "properties": {
        "required": {"$ref": "#/$defs/uri_array"},
        "optional": {"$ref": "#/$defs/uri_array"}
      }
    },
    "routing": {
      "type": "object",
      "required": ["product_hints", "host_catalog_required", "recognizer_fallback_allowed"],
      "additionalProperties": false,
      "properties": {
        "product_hints": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "host_catalog_required": {"type": "boolean"},
        "recognizer_fallback_allowed": {"type": "boolean"}
      }
    },
    "requirements": {
      "type": "object",
      "required": ["completeness", "data_quality"],
      "additionalProperties": false,
      "properties": {
        "completeness": {"enum": ["complete", "prefix", "unknown"]},
        "data_quality": {"enum": ["pass", "warn", "unknown"]}
      }
    },
    "claim_policy": {
      "type": "object",
      "required": ["allowed", "forbidden", "forbidden_without_context"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"$ref": "#/$defs/claim_array"},
        "forbidden": {"$ref": "#/$defs/claim_array"},
        "forbidden_without_context": {"$ref": "#/$defs/claim_array"}
      }
    },
    "effects": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["read", "write", "external_read", "external_write"]}},
    "request_budget": {
      "type": "object",
      "required": ["known_requests_min", "known_requests_max", "unknown_discovery_max", "runtime_additional_requests"],
      "additionalProperties": false,
      "properties": {
        "known_requests_min": {"type": "integer", "minimum": 0, "maximum": 100000},
        "known_requests_max": {"type": "integer", "minimum": 0, "maximum": 100000},
        "unknown_discovery_max": {"type": "integer", "minimum": 0, "maximum": 100000},
        "runtime_additional_requests": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "output_schema": {"type": "string", "minLength": 1, "maxLength": 256},
    "provenance": {
      "type": "object",
      "required": ["source_kind", "source_ref", "source_revision", "authorship", "license_review"],
      "additionalProperties": false,
      "properties": {
        "source_kind": {"enum": ["built_in", "independent"]},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "authorship": {"enum": ["independently_authored"]},
        "license_review": {"enum": ["approved_internal", "not_required"]}
      }
    },
    "guide": {
      "type": "object",
      "required": ["title", "applicability", "steps", "context_boundary"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "applicability": {"type": "string", "minLength": 1, "maxLength": 512},
        "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "context_boundary": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "capability_requirement": {
      "type": "object",
      "required": ["identity_kind", "selector", "contract_version", "minimum_trust", "completeness", "data_quality"],
      "additionalProperties": false,
      "properties": {
        "identity_kind": {"enum": ["operation", "product", "composite"]},
        "selector": {"type": "string", "minLength": 1, "maxLength": 256},
        "contract_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "minimum_trust": {"enum": ["stable", "degraded"]},
        "completeness": {"enum": ["complete", "prefix", "unknown"]},
        "data_quality": {"enum": ["pass", "warn", "unknown"]}
      }
    },
    "uri_array": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "claim_array": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*$"}}
  }
}
