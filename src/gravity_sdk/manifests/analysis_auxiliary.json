        "redact_keys": [
          "authorization",
          "access_token",
          "token",
          "cookie",
          "password"
        ]
      },
      "request": {
        "body_fields": [],
        "defaults": {},
        "fixed_body": {},
        "fixed_query": {},
        "path_fields": [],
        "query_fields": [
          "report_id",
          "app_id"
        ]
      },
      "required_parent": [
        "analysis.report_config.list",
