{
  "artifact_kind": "operator",
  "schema_version": "gravity.operator.v1",
  "uri": "operator://gravity/sentiment-aggregation@2",
  "version": 2,
  "owner": "gravity-runtime/methods",
  "lifecycle": "active",
  "deterministic": true,
  "method": {
    "method_id": "sentiment-aggregation",
    "revision": 1,
    "description": "Aggregate counts already classified by one project-approved sentiment taxonomy."
  },
  "schemas": {
    "input": {
      "schema_version": "gravity.operator-input.governed-method.v2",
      "resource": "governed-method-input-v2.schema.json"
    },
    "output": {
      "schema_version": "gravity.operator-result.governed-method.v2",
      "resource": "governed-method-output-v2.schema.json"
    }
  },
  "implementation": {
    "kind": "runtime_builtin",
    "group": "gravity.operators"
  },
  "assumptions": [
    {
      "assumption_id": "caller-gated-input",
      "statement": "The caller has already enforced the bound Skill Semantic, completeness, Data Quality, and privacy gates."
    },
    {
      "assumption_id": "returned-facts-only",
      "statement": "The method consumes only explicit returned facts with stable evidence references."
    },
    {
      "assumption_id": "scope-evidence-v2",
      "statement": "Caller supplies evidence-backed scopes and metric allowed axes. Aggregate requires a complete disjoint partition; cumulative requires a complete linear root/equal/subset chain. No source evidence is fetched or inferred by Runtime."
    }
  ],
  "requirements": {
    "minimum_rows_per_window": 1,
    "data_quality": "caller_gated",
    "completeness": "caller_gated"
  },
  "safe_domain": {
    "max_rows_per_window": 1000,
    "max_input_bytes": 1048576,
    "max_output_bytes": 1048576,
    "max_dimension_key_bytes": 256,
    "max_decimal_digits": 38
  },
  "unit_policy": {
    "mode": "same_declared_unit",
    "allowed_additivity": [
      "additive",
      "semi_additive",
      "non_additive"
    ]
  },
  "claim_policy": {
    "allowed": [
      "returned sentiment category count",
      "returned sentiment category share"
    ],
    "forbidden": [
      "causal claim",
      "unreturned population",
      "guaranteed future outcome"
    ],
    "limitations": [
      "Rows are already classified under one approved taxonomy.",
      "Aggregation does not classify text or infer intent.",
      "Rowwise mode never produces totals or cumulative conversion; cross-row claims require verified structural scope evidence."
    ]
  },
  "failure_reasons": [
    "OPERATOR_INPUT_INVALID",
    "OPERATOR_SAMPLE_INSUFFICIENT",
    "OPERATOR_NUMERIC_INVALID",
    "OPERATOR_ADDITIVITY_UNSUPPORTED",
    "OPERATOR_RESOURCE_LIMIT",
    "OPERATOR_OUTPUT_INVALID",
    "OPERATOR_AGGREGATION_UNPROVEN",
    "OPERATOR_FUNNEL_LINEAGE_UNPROVEN",
    "OPERATOR_SCOPE_MISMATCH",
    "OPERATOR_COMPLETENESS_UNSUPPORTED",
    "OPERATOR_UNIT_MISMATCH"
  ],
  "golden_cases": [
    {
      "case_id": "bounded-conformance",
      "resource": "sentiment-aggregation-v2.json"
    }
  ]
}
