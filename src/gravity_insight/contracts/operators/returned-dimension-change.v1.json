{
  "artifact_kind": "operator",
  "schema_version": "gravity.operator.v1",
  "uri": "operator://gravity/returned-dimension-change@1",
  "version": 1,
  "owner": "gravity-runtime/methods",
  "lifecycle": "active",
  "deterministic": true,
  "method": {
    "method_id": "returned-dimension-change",
    "revision": 1,
    "description": "Compare sums of explicit returned dimension rows and cross-check one selected slice without inferring missing rows."
  },
  "schemas": {
    "input": {
      "schema_version": "gravity.operator-input.returned-dimension-change.v1",
      "resource": "returned-dimension-change-input-v1.schema.json"
    },
    "output": {
      "schema_version": "gravity.operator-result.returned-dimension-change.v1",
      "resource": "returned-dimension-change-output-v1.schema.json"
    }
  },
  "implementation": {
    "kind": "runtime_builtin",
    "group": "gravity.operators"
  },
  "assumptions": [
    {
      "assumption_id": "same-semantic-binding",
      "statement": "Both windows use the same project Semantic binding and declared unit."
    },
    {
      "assumption_id": "returned-rows-only",
      "statement": "Only explicit returned rows are compared; unreturned rows are unknown."
    },
    {
      "assumption_id": "selected-slice-cross-check",
      "statement": "The selected slice is present and exactly cross-checked in both windows."
    }
  ],
  "requirements": {
    "minimum_rows_per_window": 1,
    "data_quality": "caller_gated",
    "completeness": "caller_gated"
  },
  "safe_domain": {
    "max_rows_per_window": 1000,
    "max_input_bytes": 1048576,
    "max_output_bytes": 1048576,
    "max_dimension_key_bytes": 256,
    "max_decimal_digits": 38
  },
  "unit_policy": {
    "mode": "same_declared_unit",
    "allowed_additivity": [
      "additive"
    ]
  },
  "claim_policy": {
    "allowed": [
      "returned-row absolute and relative change",
      "returned-key change",
      "selected-slice share of returned-row change"
    ],
    "forbidden": [
      "complete total",
      "causality",
      "unreturned values"
    ],
    "limitations": [
      "Only rows returned for both windows can appear in per-key changes.",
      "A zero denominator produces no relative percentage.",
      "The method reports an observed association, never causal attribution."
    ]
  },
  "failure_reasons": [
    "OPERATOR_INPUT_INVALID",
    "OPERATOR_SAMPLE_INSUFFICIENT",
    "OPERATOR_DIMENSION_INVALID",
    "OPERATOR_NUMERIC_INVALID",
    "OPERATOR_CROSSCHECK_FAILED",
    "OPERATOR_UNIT_MISMATCH",
    "OPERATOR_ADDITIVITY_UNSUPPORTED",
    "OPERATOR_RESOURCE_LIMIT",
    "OPERATOR_OUTPUT_INVALID"
  ],
  "golden_cases": [
    {
      "case_id": "selected-slice-decrease",
      "resource": "returned-dimension-change-v1.json"
    }
  ]
}
