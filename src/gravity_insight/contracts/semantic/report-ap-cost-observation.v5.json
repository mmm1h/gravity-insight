{
  "$schema": "../schema/semantic-compose-definition-v1.schema.json",
  "schema_version": "gravity.semantic-definition.v1",
  "definition_id": "report.ap-cost-observation",
  "version": 5,
  "description": "Observe the production-proven adreport acquisition, cost, payer, and revenue metrics within explicit cost-granularity, date-provenance, and estimation-claim boundaries.",
  "source": {
    "product": "multidim",
    "operation_id": "report.multidim.query",
    "operation_contract_version": 4,
    "fact_path": "/result/query/data/list",
    "request_profile": "frontend_adreport_current"
  },
  "access_scope": {
    "kind": "app_bound",
    "physical_filter": "app_id"
  },
  "limits": {
    "metrics": 1,
    "dimensions": 1,
    "filters": 1,
    "joins": 1
  },
  "metrics": [
    {
      "definition_id": "report.metric.ap-cost",
      "version": 1,
      "physical_name": "ap_cost",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week",
        "report.grain.total"
      ]
    },
    {
      "definition_id": "report.metric.adclick-standard-activate-count",
      "version": 1,
      "physical_name": "adclick_standard_activate_cnt",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.adclick-standard-pay-amount",
      "version": 1,
      "physical_name": "adclick_standard_pay_amount",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.adclick-total-roi",
      "version": 1,
      "physical_name": "adclick_total_roi",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.ap-show",
      "version": 1,
      "physical_name": "ap_show",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.ap-click",
      "version": 1,
      "physical_name": "ap_click",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.ap-click-rate",
      "version": 1,
      "physical_name": "ap_click_rate",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.ap-convert",
      "version": 1,
      "physical_name": "ap_convert",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.ap-activate",
      "version": 1,
      "physical_name": "ap_activate",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.adclick-standard-activate-cost",
      "version": 1,
      "physical_name": "adclick_standard_activate_cost",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.adclick-standard-pay-users",
      "version": 1,
      "physical_name": "adclick_standard_pay_uv",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.adclick-ad-revenue",
      "version": 1,
      "physical_name": "adclick_ad_amount",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    },
    {
      "definition_id": "report.metric.total-revenue",
      "version": 1,
      "physical_name": "total_revenue",
      "metadata_operation": "report.multidim.metric.list",
      "allowed_grains": [
        "report.grain.day",
        "report.grain.week"
      ]
    }
  ],
  "dimensions": [
    {
      "definition_id": "report.dimension.click-company",
      "version": 1,
      "physical_name": "click_company",
      "required_join": "report.join.adreport-click-company"
    }
  ],
  "filters": [
    {
      "definition_id": "report.filter.click-company",
      "version": 1,
      "physical_name": "click_company",
      "operators": [
        "IN"
      ],
      "required_dimension": "report.dimension.click-company"
    }
  ],
  "grains": [
    {
      "definition_id": "report.grain.day",
      "version": 1,
      "physical_name": "day"
    },
    {
      "definition_id": "report.grain.week",
      "version": 1,
      "physical_name": "week"
    },
    {
      "definition_id": "report.grain.total",
      "version": 1,
      "physical_name": "total"
    },
    {
      "definition_id": "report.grain.hour",
      "version": 1,
      "physical_name": "hour"
    }
  ],
  "joins": [
    {
      "definition_id": "report.join.adreport-click-company",
      "version": 1,
      "left_source": "report.adreport",
      "right_member": "report.dimension.click-company",
      "cardinality": "many_to_one",
      "realization": "embedded_dimension"
    }
  ],
  "cost_granularity_and_provenance": {
    "native_cost": {
      "metric": "ap_cost",
      "non_time_dimensions": ["click_company"],
      "date_semantics": {
        "status": "undeclared",
        "basis": null,
        "gap_code": "AP_COST_DATE_SEMANTICS_UNDECLARED",
        "evidence": {
          "operation_id": "report.multidim.metric.list",
          "field": "data.list[].tip",
          "declared_meaning": "total_spend_only"
        }
      },
      "post_registration_user_grouping": {
        "status": "unavailable",
        "gap_code": "POST_REGISTRATION_USER_GROUP_EXACT_COST_UNAVAILABLE"
      },
      "estimation": {
        "native_or_exact_allowed": false,
        "required_label": "estimated",
        "required_disclosures": [
          "method",
          "covered_population",
          "excluded_label_treatment",
          "assumptions"
        ]
      }
    },
    "revenue": {
      "cohort_basis": "activation",
      "evidence": {
        "operation_id": "report.multidim.metric.list",
        "field": "data.list[].tip",
        "declared_meaning": "activation_cohort"
      },
      "metrics": [
        {
          "physical_name": "standard_1day_pay_amount",
          "metric_type": 0,
          "event_timing": "within_activation_day"
        },
        {
          "physical_name": "multi_day_pay_amount",
          "metric_type": 2,
          "event_timing": "post_activation_day_n"
        }
      ]
    },
    "join_evidence": {
      "artifact_path": "../join-keys/registry.v1.json",
      "registry_id": "join-key://gravity/acquisition-user@1",
      "right_side_semantics": "acquisition_attribution_fields",
      "post_registration_user_property_mapping": false
    }
  },
  "allowed_claims": [
    {
      "claim_id": "observed-metric-value",
      "statement": "State returned values only as a point-in-time observation scoped to result.query.fetched_at, the selected App, inclusive date window, grain, grouped dimensions, and explicit filters; identical structured inputs executed later are not guaranteed to return identical values."
    },
    {
      "claim_id": "within-result-comparison",
      "statement": "Compare rows for the selected registered metric only within this same execution when returned dimension and time keys are stated; prior and current executions may be reported only as separately timestamped observations and an arithmetic difference, not as replay-equivalent, stable, settled, or causal results."
    },
    {
      "claim_id": "native-cost-grain-boundary",
      "statement": "Describe ap_cost as native only at the selected upstream time grain and optional click_company dimension; the contract does not declare what real-world date basis ap_cost uses and does not support native cost by post-registration user properties."
    }
  ],
  "forbidden_claims": [
    {
      "claim_id": "allocated-cost-as-native-or-exact",
      "statement": "An allocation-based cost must not be represented as native or exact; it is eligible only when labeled estimated and accompanied by the allocation method, covered population, excluded-label treatment, and assumptions."
    }
  ]
}
