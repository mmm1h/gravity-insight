{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 32,
  "operation": {
    "action": "query",
    "auth_profile": "gravity_authorization",
    "contract_version": 1,
    "description": "按 App 和闭区间读取前端归因表现面板的受控指标组合；返回明细、列说明、提示与合计，服务端“无数据”被规范化为明确空结果。",
    "domain": "attribution",
    "effect": "read",
    "examples": [
      {
        "description": "使用调用方从 App 目录选择的 App 和显式单日窗口。",
        "inputs": {
          "app_id": 1,
          "date_list": [
            "2026-08-15",
            "2026-08-15"
          ],
          "dims_list": [
            "date",
            "ad_platform"
          ],
          "metrics_list": [
            "AppRealRegisterCnt"
          ],
          "statistics_caliber": "user_activated_time"
        },
        "name": "single_day"
      }
    ],
    "executable": true,
    "input_fields": {
      "app_id": {
        "description": "调用方从 App 目录选择的正整数 App 标识。本 route 合同声明 integer；跨 route 的 app_id 声明类型见 docs/reference/sdk.md#app-id-wire-types。SDK 只按本合同声明的类型归一化数字字符串或整数。",
        "required": true,
        "type": "integer"
      },
      "date_list": {
        "description": "闭区间 [start, end]，两个元素均为 YYYY-MM-DD。",
        "item_type": "string",
        "max_items": 2,
        "min_items": 2,
        "required": true,
        "type": "array"
      },
      "dims_list": {
        "description": "前端四个归因表现请求实际使用的维度。",
        "item_enum": [
          "date",
          "ad_platform"
        ],
        "item_type": "string",
        "max_items": 2,
        "min_items": 1,
        "required": true,
        "type": "array"
      },
      "metrics_list": {
        "description": "前端四个归因表现请求实际使用的有限指标集合。",
        "item_enum": [
          "AdClick",
          "AdShow",
          "AppActivateBuried",
          "AppActivateStandard",
          "AppActivateUploaded",
          "AppGamePayAmountReportingStandard",
          "AppGamePayUserCntStandard",
          "AppRealRegisterCnt",
          "AppRegisterStandard"
        ],
        "item_type": "string",
        "max_items": 5,
        "min_items": 1,
        "required": true,
        "type": "array"
      },
      "statistics_caliber": {
        "description": "前端调用点固定选择的统计口径。",
        "enum": [
          "behavior_occurred_time",
          "user_activated_time"
        ],
        "required": true,
        "type": "string"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_id": "$first_app_id",
        "date_list": [
          "$today",
          "$today"
        ],
        "dims_list": [
          "date",
          "ad_platform"
        ],
        "metrics_list": [
          "AppRealRegisterCnt"
        ],
        "statistics_caliber": "user_activated_time"
      }
    },
    "operation_id": "attribution.attribution.query",
    "pagination": {
      "kind": "none",
      "completeness": "unknown",
