{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 0,
  "operation": {
    "action": "list",
    "auth_profile": "gravity_authorization",
    "contract_version": 3,
    "description": "分析页事件目录；只输出事件定义元数据，不输出事件记录。不要用 item.yesterday_count 判断某个事件在指定窗口是否有数据；请用 analysis.event.query（Agent selector: analysis.query.spec:event）查询明确的事件和指标。",
    "domain": "analysis",
    "effect": "read",
    "examples": [],
    "input_fields": {
      "app_id": {
        "description": "App 目录 id。本 route 合同声明 string；跨 route 的 app_id 声明类型见 docs/reference/sdk.md#app-id-wire-types。SDK 只按本合同声明的类型归一化数字字符串或整数。",
        "required": true,
        "type": "string"
      },
      "filters": {
        "default": [],
        "description": "Allowlisted event-definition filters. Valid pairs: name/1; accepted, is_preset, visible or uploaded/1; create_time or modify_time/7; like_name_cname/9. Favourite filters are out of scope.",
        "item_type": "object",
        "item_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator", "values"],
          "properties": {
            "field": {"type": "string", "enum": ["name", "accepted", "is_preset", "visible", "uploaded", "create_time", "modify_time", "like_name_cname"]},
            "operator": {"type": "integer", "enum": [1, 7, 9]},
            "values": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": ["string", "boolean"]}}
          }
        },
        "max_items": 100,
        "type": "array"
      },
      "need_favourite": {
        "default": true,
        "type": "boolean"
      },
      "need_yesterday_count": {
        "default": 0,
        "enum": [0, 1],
        "description": "Whether Gravity should calculate yesterday_count. Defaults to 0 because the count is expensive and is not a substitute for an event query.",
        "type": "integer"
      },
      "order_by_field": {
        "default": "modify_time",
        "enum": ["modify_time", "name", "cname", "yesterday_count"],
        "type": "string"
      },
      "order_by_op": {
        "default": "desc",
        "enum": ["desc", "asc"],
        "type": "string"
      },
      "page": {
        "default": 1,
        "type": "integer"
      },
      "page_size": {
        "default": 100,
        "type": "integer"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_id": "$first_app_id",
        "page": 1,
        "page_size": 1
      }
    },
    "operation_id": "analysis.event.list",
    "pagination": {
      "default_page_size": 100,
      "kind": "page_info",
      "completeness": "complete",
      "pagination_evidence": "production",
      "list_path": "data.list",
      "max_page_size": 2000,
      "page_field": "page",
      "page_info_path": "data.page_info",
      "page_size_field": "page_size",
      "total_page_field": "total_page"
    },
    "path_template": "/turbo_engine/api/v2/event/event_list/",
    "privacy_policy": {
      "classification": "configuration",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password"
      ]
    },
    "provenance": {
      "applied_overrides": [],
      "family": null,
      "platform": null,
      "source_files": [
        "operations/analysis.event.list.json"
      ]
    },
    "request": {
      "body_fields": [],
      "defaults": {
        "filters": [],
        "need_favourite": true,
        "need_yesterday_count": 0,
        "order_by_field": "modify_time",
        "order_by_op": "desc",
        "page": 1,
        "page_size": 100
      },
      "fixed_body": {},
      "fixed_query": {},
      "path_fields": [],
      "query_fields": [
        "app_id",
        "page",
        "page_size",
        "need_favourite",
        "filters",
        "order_by_field",
        "order_by_op",
        "need_yesterday_count"
      ]
    },
    "required_parent": [
      {
        "input_field": null,
        "operation_id": "app.list",
        "output_path": "data.list[].id",
        "selection": "first"
      }
    ],
    "resource": "event",
    "response_projection": {
      "data_keys": [
        "list",
        "page_info"
      ],
      "dynamic_item_fields": [],
      "item_keys": [
        "accepted",
        "app_id",
        "cname",
        "create_time",
        "id",
        "is_favourite",
        "is_preset",
        "lookup",
        "modify_time",
        "name",
        "remark",
        "trigger_opportunity",
        "uploaded",
        "visible",
        "yesterday_count"
      ],
      "unreliable_item_keys": {
        "yesterday_count": {
          "reason": "Tenant-wide observed 0 on every listed event while attribution.attribution.query on the same day returned positive AppRealRegisterCnt; do not treat this field as event volume.",
          "use_instead": "analysis.event.query for an explicit event and metric (Agent selector: analysis.query.spec:event)"
        }
      },
      "required_data_keys": [
        "list"
      ]
    },
    "semantic_error_rules": [
      "code",
      "extra.error"
    ],
    "stability": "stable",
    "upstream_method": "GET"
  },
  "source_schema_version": 2,
  "target_manifest": "analysis.json"
}
