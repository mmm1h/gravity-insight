{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 11,
  "operation": {
    "action": "query",
    "auth_profile": "gravity_authorization",
    "contract_version": 2,
    "description": "平台素材安全聚合报表。当前 Business chunk 明确巨量/腾讯/磁力/B站指标映射；受控 codec 固定 material/total 聚合、平台与 App filters，并将 stat_list 收紧为空以禁止 designer_id 人员分组。素材 URL 与内部形状未知的 image_set 不向消费方投影。",
    "domain": "material",
    "effect": "read",
    "examples": [],
    "input_fields": {
      "app_list": {
        "item_type": "string",
        "max_items": 100,
        "min_items": 1,
        "required": true,
        "type": "array"
      },
      "date_list": {
        "required": true,
        "type": "array"
      },
      "page": {
        "default": 1,
        "type": "integer"
      },
      "page_size": {
        "default": 10,
        "type": "integer"
      },
      "platform": {
        "enum": [
          "bytedance",
          "tencent",
          "kuaishou",
          "bilibili"
        ],
        "required": true,
        "type": "string"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_list": [
          "$first_app_id"
        ],
        "date_list": [
          "$today",
          "$today"
        ],
        "page": 1,
        "page_size": 1,
        "platform": "bytedance"
      }
    },
    "operation_id": "material.report.query",
    "pagination": {
      "default_page_size": 10,
      "kind": "page_info",
      "completeness": "complete",
      "pagination_evidence": "production",
      "list_path": "data.list",
      "max_page_size": 10,
      "page_field": "page",
      "page_info_path": "data.page_info",
      "page_size_field": "page_size",
      "total_page_field": "total_page"
    },
    "path_template": "/report/api/v3/datareport/material_get/",
    "privacy_policy": {
      "classification": "material",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password"
      ]
    },
    "provenance": {
      "applied_overrides": [],
      "family": null,
      "platform": null,
      "source_files": [
        "operations/material.report.query.json"
      ]
    },
    "request": {
      "body_fields": [
        "platform",
        "page",
        "page_size",
        "date_list",
        "app_list"
      ],
      "defaults": {
        "page": 1,
        "page_size": 10
      },
      "fixed_body": {},
      "fixed_query": {},
      "path_fields": [],
      "query_fields": []
    },
    "required_parent": [
      {
        "input_field": null,
        "operation_id": "app.list",
        "output_path": "data.list[].id",
        "selection": "caller_select"
      }
    ],
    "resource": "report",
    "response_projection": {
      "data_keys": [
        "list",
        "page_info"
      ],
      "dynamic_item_fields": [],
      "item_keys": [
        "file_name",
        "gravity_material_id",
        "material_id",
        "stat_cost",
        "ctr",
        "convert_rate",
        "cost",
        "conversions_rate",
        "charge",
        "action_ratio",
        "conversion_ratio",
        "click_rate",
        "AppRealRegisterCnt",
        "AppGamePayUserCntStandardAtv",
        "album_id",
        "album_name",
        "capture_user_id",
        "capture_user_name",
        "create_time",
        "creative_user_id",
        "creative_user_name",
        "d3_action_user_id",
        "d3_action_user_name",
        "d3_render_user_id",
        "d3_render_user_name",
        "designer_id",
        "designer_image_id",
        "designer_image_name",
        "designer_name",
        "dub_user_id",
        "dub_user_name",
        "file_md5",
        "file_type",
        "folder_id",
        "folder_name",
        "is_favorite",
        "make_time",
        "other_user_id",
        "other_user_name",
        "performer_user_id",
        "performer_user_name",
        "transcribe_user_id",
        "transcribe_user_name"
      ],
      "known_omitted_item_keys": [
        "file_url",
        "image_set",
        "thumbnail_url"
      ],
      "opaque_json_item_keys": [
        "capture_user_id",
        "d3_action_user_id",
        "d3_render_user_id",
        "dub_user_id",
        "other_user_id",
        "performer_user_id",
        "transcribe_user_id"
      ],
      "unreliable_item_keys": {
        "gravity_material_id": {
          "reason": "Live bytedance material.report.query rows return gravity_material_id=0 while file_name is unique and material.bytedance.list material_id is a 19-char identifier.",
          "use_instead": "material.report.query material_id, or material.bytedance.list material_id"
        }
      },
      "known_omitted_data_keys": [
        "total",
        "update_at"
      ],
      "required_data_keys": [
        "list"
      ]
    },
    "semantic_error_rules": [
      "code",
      "extra.error"
    ],
    "stability": "stable",
    "upstream_method": "POST"
  },
  "source_schema_version": 2,
  "target_manifest": "candidates.json"
}
