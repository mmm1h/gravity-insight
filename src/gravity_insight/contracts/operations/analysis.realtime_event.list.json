      "pagination_evidence": "production",
      "list_path": "",
      "page_field": "",
      "page_info_path": "",
      "page_size_field": "",
      "total_page_field": ""
    },
    "path_template": "/turbo_engine/api/v2/event/realtime_event/list/",
    "platform": null,
    "privacy_policy": {
      "classification": "internal_business",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password",
