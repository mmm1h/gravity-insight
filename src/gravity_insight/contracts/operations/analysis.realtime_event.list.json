{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 24,
  "operation": {
    "action": "list",
    "auth_profile": "gravity_authorization",
    "contract_version": 2,
    "description": "Read bounded realtime diagnostics for one explicit Asia/Shanghai window of at most24 hours. Registered ordinary filters use AND. At most one EQUALS property filter with one metadata-typed scalar is accepted; LIST/DICT comparison semantics remain unverified. Existing identifiers are preserved. SDK/version are nullable. Only explicitly selected, metadata/type/privacy-validated scalar properties are projected; raw properties/IP/UA stay omitted. Native responses have at most1000 rows, no page_info and unknown content completeness; empty does not prove ingestion absence.",
    "domain": "analysis",
    "effect": "read",
    "examples": [
      {
        "description": "Frontend same-day window with the first non-empty filter shape.",
        "inputs": {
          "app_id": 1,
          "filters": {
            "event_type": "profile"
          },
          "page": 1,
          "page_size": 50,
          "request_time": [
            "2026-08-18 00:00:00",
            "2026-08-18 23:59:59"
          ]
        },
        "name": "same_day_profile"
      }
    ],
    "executable": true,
    "input_fields": {
      "app_id": {
        "description": "App identifier selected by the caller. This route declares integer.",
        "required": true,
        "type": "integer"
      },
      "filters": {
        "description": "Closed registered AND filters; one scalar property EQUALS condition at most. Values are redacted from request echoes.",
        "required": true,
        "type": "object",
        "sensitive": true
      },
      "page": {
        "default": 1,
        "description": "Must be1. Native paging is unproven; never traverse pages.",
        "required": true,
        "type": "integer"
      },
      "page_size": {
        "default": 50,
        "description": "Observed frontend page size. The non-empty sample sent 50 and received 1000 items with no page_info.",
        "required": true,
        "type": "integer"
      },
      "request_time": {
        "description": "Two ordered Asia/Shanghai local datetimes YYYY-MM-DD HH:MM:SS, at most24 hours apart.",
        "item_type": "string",
        "required": true,
        "type": "array"
      },
      "property_fields": {
        "type": "array",
        "item_type": "string",
        "required": false,
        "default": [],
        "description": "At most20 distinct explicit nonidentifying scalar property names from same-App metadata. Local projection only; never sent upstream."
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_id": "$first_app_id",
        "filters": {
          "event_type": "profile"
        },
        "page": 1,
        "page_size": 50,
        "request_time": [
          "2026-08-18 00:00:00",
          "2026-08-18 23:59:59"
        ]
      }
    },
    "operation_id": "analysis.realtime_event.list",
    "pagination": {
      "kind": "none",
