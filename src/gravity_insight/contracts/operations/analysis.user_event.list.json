{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 19,
  "operation": {
    "action": "list",
    "auth_profile": "gravity_authorization",
    "contract_version": 5,
    "description": "单用户事件流；上游逐条事件以属性显示名为键，SDK 按已登记 name→cname 唯一映射，以所选字段名输出事件属性；显示名跨事件重名时须在 event_list 列出精确事件，尝试事件级映射。在部分返回行缺失或没有唯一显示名的所选字段见 field_coverage：missing_counts/missing_fields 只描述已映射字段，未投影字段只列入 unmapped_fields，不能将其解释为缺失数 0。支付调用 SKU 在精确事件级映射后仍 unmapped 或 absent 时即不可用；成功支付事件的商品字段只可作为成功侧证据，不得反填调用行。保留事件英文名作为精确事件身份，不把显示名称当作事件身份。上游每页最多返回 50 条；无 page_info、已登记稳定排序或游标。结果元数据 user_event_scope 区分请求条件轨迹与未应用 query_item_list 条件的 summary；存在条件时两者不可核对，筛后匹配总数不可用。仅同过滤语义的 summary 可作返回投影计数检查；总数相等、稳定 summary 或递增 page 至空终止均不能认证事件内容闭合，完整性保持 unknown。保留同时间戳的全部发生，不去重、不将缺失补零；可用受支持的互不重叠单日/精确事件子范围作有界对照，不据此推定稳定排序、原生原因或投影以外的完整性。",
    "domain": "analysis",
    "effect": "read",
    "examples": [],
    "input_fields": {
      "app_id": {
        "max_length": 64,
        "required": true,
        "type": "string"
      },
      "client_id": {
        "max_length": 256,
        "required": true,
        "sensitive": true,
        "type": "string"
      },
      "date": {
        "required": false,
        "type": "date"
      },
      "date_list": {
        "item_type": "string",
        "max_items": 2,
        "min_items": 2,
        "required": false,
        "type": "array"
      },
      "desc": {
        "default": true,
        "type": "boolean"
      },
      "event_list": {
        "default": [],
        "item_type": "string",
        "max_items": 2000,
        "type": "array"
      },
      "fields": {
        "default": [],
        "item_type": "string",
        "max_items": 2000,
        "type": "array"
      },
      "group_by": {
        "default": "day",
        "enum": [
          "day",
          "hour",
          "week",
          "month"
        ],
        "type": "string"
      },
      "page": {
        "default": 1,
        "type": "integer"
      },
      "page_size": {
        "default": 20,
        "type": "integer"
      },
      "query_item_list": {
        "default": [],
        "item_type": "object",
        "item_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_name"
          ],
          "properties": {
            "event_name": {
              "type": "string",
              "minLength": 1,
              "description": "Exact event name selected from analysis.event.list."
            },
            "event_label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "pattern": "^[^\\u0000]*$"
            },
            "conditions": {
              "type": "array",
              "default": [],
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operator",
                  "field",
                  "type"
                ],
                "properties": {
                  "operator": {
                    "type": "string",
                    "enum": [
                      "CONTAINS",
                      "EQUALS",
                      "GREATER",
                      "GREATER_EQUALS",
                      "GT",
                      "GTE",
                      "IN",
                      "INDEX_POSITION",
                      "LESS",
                      "LESS_EQUALS",
                      "LT",
                      "LTE",
                      "NOT_CONTAINS",
                      "NOT_EQUALS",
                      "NOT_IN",
                      "NOT_PATTERN",
                      "PATTERN",
                      "RANGE_IN",
                      "RELATIVE_DAY",
                      "RELATIVE_HOUR",
                      "RELATIVE_MINUTE",
                      "RELATIVE_MONTH",
                      "RELATIVE_WEEK",
                      "WITHOUT_VAL",
                      "WITH_VAL"
                    ]
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Property name selected from analysis.event_property.list or analysis.user_property.list for this App and event."
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "cash",
                      "default",
                      "default_event",
                      "default_order",
                      "default_user",
                      "event",
                      "order",
                      "user",
                      "user_property",
                      "user_re_attribute",
                      "user_segment"
                    ]
                  },
                  "value": {
                    "type": "array",
                    "default": [],
                    "maxItems": 200,
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 4096
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "by_list_index": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "list_index_val": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": -10000,
                    "maximum": 10000,
                    "not": {
                      "const": 0
                    }
                  },
                  "segment_type": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      null,
                      "",
                      "DYNAMIC_MATCHING",
                      "FIXED_VERSION",
                      "LATEST"
                    ]
                  },
                  "version_id": {
                    "type": [
                      "string",
                      "integer",
                      "null"
                    ]
                  },
                  "dim_using_table_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256
                  }
                }
              }
            },
            "cond_logic": {
              "type": "string",
              "enum": [
                "AND",
                "OR"
              ],
              "default": "AND"
            }
          }
        },
        "max_items": 100,
        "type": "array"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_id": "$first_app_id",
        "client_id": "$first_client_id",
        "date": "$today",
        "page": 1,
        "page_size": 1
      }
    },
    "operation_id": "analysis.user_event.list",
    "pagination": {
      "kind": "none",
      "completeness": "unknown",
      "pagination_evidence": "template",
      "list_path": "",
      "page_field": "",
      "page_info_path": "",
      "page_size_field": "",
      "total_page_field": ""
    },
    "path_template": "/report/api/v3/dataanalysis/user/event/list/",
    "privacy_policy": {
      "classification": "user_level",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password",
        "secret",
        "refresh_token",
        "session_token"
      ]
    },
    "provenance": {
      "applied_overrides": [],
      "family": null,
      "platform": null,
      "source_files": [
        "operations/analysis.user_event.list.json"
      ]
    },
    "request": {
      "body_fields": [
        "app_id",
        "client_id",
        "date",
        "date_list",
        "page",
        "page_size",
        "fields",
        "desc",
        "group_by",
        "event_list",
        "query_item_list"
      ],
      "defaults": {
        "desc": true,
        "event_list": [],
        "fields": [],
        "group_by": "day",
        "page": 1,
        "page_size": 20,
        "query_item_list": []
      },
      "fixed_body": {},
      "fixed_query": {},
      "path_fields": [],
      "query_fields": []
    },
    "required_parent": [
      {
        "input_field": null,
        "operation_id": "analysis.user_detail.list",
        "output_path": "data.list[].ClientID",
        "selection": "first"
      }
    ],
    "resource": "user_event",
    "response_projection": {
      "data_dynamic_item_fields": {
        "device": [
          "fields"
        ],
        "event_timeline": [
          "fields"
        ],
        "re_attribute_records": [
          "fields"
        ],
        "user": [
          "fields"
        ]
      },
      "data_item_keys": {
        "field_coverage": [
          "scope",
          "row_count",
          "status",
          "missing_fields",
          "missing_counts",
          "unmapped_fields"
        ],
        "device": [
          "Android_Version",
          "Api_Version",
          "Aspect_Ratio",
          "OS",
          "Phone_Brand",
          "Phone_Model",
          "Rom",
          "Rom_version",
          "AndroidId",
          "Caid1",
          "Caid2",
          "DeviceId",
          "Idfa",
          "Idfv",
          "Imei",
          "Oaid"
        ],
        "re_attribute_records": [
          "ReAttributeAdAid",
          "ReAttributeAdCid",
          "ReAttributeAdGid",
          "ReAttributeAdPlatform",
          "ReAttributeAdvertiserID",
          "ReAttributeCSite",
          "ReAttributeChannel",
          "ReAttributeCreateTime",
          "ReAttributeTurboPromotedObjectID",
          "ReAttributeRetargetingCount",
          "ReAttributeAdClickTime"
        ],
        "user": [
          "ClientID",
          "user_id",
          "device_id",
          "CreateTime",
