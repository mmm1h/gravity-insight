        "filters": [],
        "only_dim_prop": false,
        "order_by_field": "modify_time",
        "order_by_op": "desc",
        "page": 1,
        "page_size": 100
      },
      "fixed_body": {},
      "fixed_query": {},
      "path_fields": [],
      "query_fields": [
        "app_id",
        "page",
        "page_size",
        "filters",
