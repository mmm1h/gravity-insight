{
  "$schema": "../schema/operation-v2.schema.json",
  "manifest_order": 2,
  "operation": {
    "action": "list",
    "auth_profile": "gravity_authorization",
    "contract_version": 3,
    "description": "分析页事件属性目录；静态包确认无需事件名即可分页读取。",
    "domain": "analysis",
    "effect": "read",
    "examples": [],
    "input_fields": {
      "app_id": {
        "required": true,
        "type": "string"
      },
      "filters": {
        "default": [],
        "description": "Allowlisted property-definition filters. Valid pairs: name/1; data_type/6; prop_type, is_common, is_preset, uploaded or visible/1; create_time or modify_time/7; like_name_cname/9. Favourite filters are out of scope.",
        "item_type": "object",
        "item_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator", "values"],
          "properties": {
            "field": {"type": "string", "enum": ["name", "data_type", "prop_type", "is_common", "is_preset", "uploaded", "visible", "create_time", "modify_time", "like_name_cname"]},
            "operator": {"type": "integer", "enum": [1, 6, 7, 9]},
            "values": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": ["string", "integer", "boolean"]}}
          }
        },
        "max_items": 100,
        "type": "array"
      },
      "only_dim_prop": {
        "default": false,
        "description": "Return only properties associated with a dimension table.",
        "type": "boolean"
      },
      "order_by_field": {
        "default": "modify_time",
        "enum": ["modify_time", "name", "cname"],
        "type": "string"
      },
      "order_by_op": {
        "default": "desc",
        "enum": ["desc", "asc"],
        "type": "string"
      },
      "page": {
        "default": 1,
        "type": "integer"
      },
      "page_size": {
        "default": 100,
        "type": "integer"
      }
    },
    "live_probe": {
      "enabled": true,
      "inputs": {
        "app_id": "$first_app_id",
        "page": 1,
        "page_size": 1
      }
    },
    "operation_id": "analysis.event_property.list",
    "pagination": {
      "default_page_size": 100,
      "kind": "page_info",
      "completeness": "unknown",
      "pagination_evidence": "template",
      "list_path": "data.list",
      "max_page_size": 2000,
      "page_field": "page",
      "page_info_path": "data.page_info",
      "page_size_field": "page_size",
      "total_page_field": "total_page"
    },
    "path_template": "/turbo_engine/api/v2/event/event_property_list/",
    "privacy_policy": {
      "classification": "configuration",
      "redact_fields": [
        "authorization",
        "access_token",
        "token",
        "cookie",
        "password"
      ]
