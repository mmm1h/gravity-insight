      "end_time": {"type": "datetime", "required": true, "description": "入库窗结束，Asia/Shanghai YYYY-MM-DD HH:MM:SS。"},
      "time_slot": {"type": "integer", "required": true, "enum": [2], "default": 2, "description": "前端固定 time_slot=2。"}
    },
