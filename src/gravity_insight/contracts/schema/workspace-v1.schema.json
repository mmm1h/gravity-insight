{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravity-sdk.local/contracts/schema/workspace-v1.schema.json",
  "title": "Gravity workspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "apps",
    "defaults",
    "datasources",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "apps": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "timezone",
        "time_window"
      ],
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "time_window": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "datasources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/datasource"
      }
    },
    "products": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/product"
      }
    },
    "recipes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/recipe"
      }
    },
    "plan_recipes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/plan_recipe"
      }
    },
    "semantic_context": {
      "$ref": "#/$defs/semantic_context"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "datasource": {
      "type": "object",
      "required": [
        "id",
        "verification_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "pending_review",
            "verified",
            "verified_with_gaps",
            "blocked"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "kind",
        "datasource",
        "apps",
        "forbidden_claims",
        "sql",
        "output_fields",
        "privacy",
        "max_rows"
      ],
      "properties": {
        "kind": {
          "const": "custom-sql"
        },
        "datasource": {
          "type": "string",
          "minLength": 1
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          }
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "output_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "output_semantics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "privacy": {
          "const": "aggregate"
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,8}$"
        },
        "promotion_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "bindings",
        "parameters",
        "required_parameters",
        "input",
        "output_fields",
        "contract_fingerprint"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "$ref": "#/$defs/recipe_bindings"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input_path"
          }
        },
        "required_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "input": {
          "type": "object"
        },
        "output_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contract_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "recipe_bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_ref": {
          "$ref": "#/$defs/name"
        },
        "app_input": {
          "$ref": "#/$defs/input_path"
        },
        "report_ref": {
          "type": "string",
          "minLength": 1
        },
        "report_input": {
          "$ref": "#/$defs/input_path"
        }
      },
      "anyOf": [
        {
          "required": ["app_ref", "app_input"]
        },
        {
          "required": ["report_ref", "report_input"]
        }
      ],
      "dependentRequired": {
        "app_ref": ["app_input"],
        "app_input": ["app_ref"],
        "report_ref": ["report_input"],
        "report_input": ["report_ref"]
      }
    },
    "plan_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "plan"],
      "properties": {
        "description": {"type": "string"},
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/plan_recipe_parameter"}
        },
        "plan": {
          "type": "object",
          "required": ["schema_version", "nodes"],
          "properties": {
            "schema_version": {"const": "gravity.plan.v1"},
            "nodes": {"type": "array", "minItems": 1}
          }
        }
      }
    },
    "plan_recipe_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "bindings"],
      "if": {"required": ["format"]},
      "then": {"properties": {"type": {"const": "string"}}},
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean"]},
        "format": {"enum": ["date", "date-time"]},
        "required": {"type": "boolean"},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/nodes/[0-9]+/request/.+"
          }
        }
      }
    },
    "semantic_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": {"const": "gravity.semantic-context.v1"},
        "instructions": {"type": "string", "pattern": "\\S"},
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/semantic_term"}
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/semantic_exclusion"}
        },
        "verified_queries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/verified_query"}
        }
      },
      "anyOf": [
        {"required": ["instructions"]},
        {"required": ["terms"]},
        {"required": ["exclusions"]},
        {"required": ["verified_queries"]}
      ]
    },
    "semantic_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phrases", "target"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "phrases": {"$ref": "#/$defs/semantic_phrases"},
        "description": {"type": "string"},
        "target": {"$ref": "#/$defs/semantic_target"}
      }
    },
    "semantic_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "reason", "target"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "when": {"$ref": "#/$defs/semantic_phrases"},
        "reason": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/semantic_target"}
      }
    },
    "semantic_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "product",
            "operation",
            "event",
            "event_property",
            "user_property",
            "metric",
            "custom_metric"
          ]
        },
        "ref": {"type": "string", "minLength": 1},
        "app": {"$ref": "#/$defs/name"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"enum": ["event", "event_property", "user_property"]}
            }
          },
          "then": {"required": ["app"]},
          "else": {"not": {"required": ["app"]}}
        }
      ]
    },
    "verified_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "question", "operation", "input"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "question": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "operation": {"type": "string", "minLength": 1},
        "input": {"type": "object"},
        "all_pages": {"type": "boolean", "default": false}
      }
    },
    "semantic_phrases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "input_path": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.(?:[A-Za-z_][A-Za-z0-9_]*|[0-9]+))*$"
    }
  }
}
