{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.capability-validation-run.v2",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "started_at",
    "finished_at",
    "app_scope_sha256",
    "request_budget",
    "prior_requests",
    "production_requests_sent",
    "production_requests_total",
    "runtime_request_counter",
    "attempts",
    "candidate_operations",
    "validations_recorded",
    "validation_store_count",
    "outcome_counts",
    "trust_counts",
    "outcomes",
    "network_called",
    "privacy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.capability-validation-run.v2"},
    "status": {"const": "complete"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "app_scope_sha256": {"$ref": "#/$defs/digest"},
    "request_budget": {"type": "integer", "minimum": 1, "maximum": 500},
    "prior_requests": {"type": "integer", "minimum": 0, "maximum": 500},
    "production_requests_sent": {"type": "integer", "minimum": 0, "maximum": 500},
    "production_requests_total": {"type": "integer", "minimum": 0, "maximum": 500},
    "runtime_request_counter": {"type": "integer", "minimum": 0},
    "attempts": {"const": 1},
    "candidate_operations": {"type": "integer", "minimum": 0},
    "validations_recorded": {"type": "integer", "minimum": 0},
    "validation_store_count": {"type": "integer", "minimum": 0},
    "outcome_counts": {"$ref": "#/$defs/counts"},
    "trust_counts": {"$ref": "#/$defs/trust_counts"},
    "outcomes": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/outcome"}
    },
    "network_called": {"type": "boolean"},
    "privacy": {
      "type": "object",
      "required": [
        "credentials_persisted",
        "request_values_persisted",
        "response_values_persisted",
        "raw_rows_persisted"
      ],
      "additionalProperties": false,
      "properties": {
        "credentials_persisted": {"const": false},
        "request_values_persisted": {"const": false},
        "response_values_persisted": {"const": false},
        "raw_rows_persisted": {"const": false}
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "trust_counts": {
      "type": "object",
      "required": [
        "stable", "complete", "data_quality_pass", "provider_matched", "total"
      ],
      "additionalProperties": false,
      "properties": {
        "stable": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0},
        "data_quality_pass": {"type": "integer", "minimum": 0},
        "provider_matched": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "identity_kind",
        "selector",
        "effect",
        "attempted",
        "category",
        "request_count",
        "validation_recorded",
        "reason_codes"
      ],
      "additionalProperties": false,
      "properties": {
        "identity_kind": {"enum": ["operation", "product", "composite"]},
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "effect": {"type": "string", "minLength": 1, "maxLength": 64},
        "attempted": {"type": "boolean"},
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "request_count": {"type": "integer", "minimum": 0, "maximum": 500},
        "validation_recorded": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}
        },
        "result_status": {"type": ["string", "null"], "maxLength": 128},
        "result_nonempty": {"type": "boolean"},
        "receipt_ids": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
        },
        "schema_fingerprint": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "response_drift": {"$ref": "#/$defs/response_drift"},
        "error_detail": {"$ref": "#/$defs/error_detail"}
      }
    },
    "response_drift": {
      "oneOf": [
        {"$ref": "#/$defs/response_drift/$defs/additive_v1"},
        {"$ref": "#/$defs/response_drift/$defs/breaking_v2"}
      ],
      "$defs": {
        "additive_v1": {
          "type": "object",
          "required": ["schema_version", "direction", "classification", "fields"],
          "additionalProperties": false,
          "properties": {
            "schema_version": {"const": "gravity.response-drift.v1"},
            "direction": {"const": "response"},
            "classification": {"const": "additive"},
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["path", "observed_type"],
                "additionalProperties": false,
                "properties": {
                  "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/.*$"},
                  "observed_type": {
                    "enum": ["null", "boolean", "integer", "number", "string", "object", "array"]
                  }
                }
              }
            }
          }
        },
        "breaking_v2": {
          "type": "object",
          "required": ["schema_version", "direction", "classification", "fields"],
          "additionalProperties": false,
          "properties": {
            "schema_version": {"const": "gravity.response-drift.v2"},
            "direction": {"const": "response"},
            "classification": {"const": "breaking"},
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  {"$ref": "#/$defs/response_drift/$defs/additive_v2_field"},
                  {"$ref": "#/$defs/response_drift/$defs/breaking_v2_field"}
                ]
              },
              "not": {
                "items": {"$ref": "#/$defs/response_drift/$defs/additive_v2_field"}
              }
            }
          }
        },
        "additive_v2_field": {
          "type": "object",
          "required": ["classification", "path", "observed_type"],
          "additionalProperties": false,
          "properties": {
            "classification": {"const": "additive"},
            "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/.*$"},
            "observed_type": {
              "enum": ["null", "boolean", "integer", "number", "string", "object", "array"]
            }
          }
        },
        "breaking_v2_field": {
          "type": "object",
          "required": ["classification", "path", "expected_type", "observed_type"],
          "additionalProperties": false,
          "properties": {
            "classification": {"const": "breaking"},
            "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/.*$"},
            "expected_type": {
              "enum": ["null", "boolean", "integer", "number", "string", "object", "array", "json", "json_scalar", "object_or_array"]
            },
            "observed_type": {
              "enum": ["null", "boolean", "integer", "number", "string", "object", "array", "missing", "non_json"]
            }
          }
        }
      }
    },
    "error_detail": {
      "type": "object",
      "required": ["code", "category"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
        "category": {"enum": ["caller", "upstream", "local", "unknown"]}
      }
    }
  }
}
