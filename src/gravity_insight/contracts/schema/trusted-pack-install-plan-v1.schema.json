{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.trusted-pack-install-plan.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "installation_owner", "activation", "lock_digest", "actions", "plan_digest", "network_called"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "trusted_pack_install_plan"},
    "schema_version": {"const": "gravity.trusted-pack-install-plan.v1"},
    "installation_owner": {"const": "external_installer"},
    "activation": {"const": "runtime_restart_required"},
    "lock_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["action_id", "effect", "pack_id", "distribution", "version", "wheel_sha256", "descriptor_digest", "wheel_path", "allowed_groups"],
        "additionalProperties": false,
        "properties": {
          "action_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
          "effect": {"const": "install_exact_wheel"},
          "pack_id": {"type": "string", "minLength": 8, "maxLength": 256},
          "distribution": {"type": "string", "minLength": 1, "maxLength": 128},
          "version": {"type": "string", "minLength": 1, "maxLength": 32},
          "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "descriptor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "wheel_path": {"type": "string", "minLength": 1, "maxLength": 2048},
          "allowed_groups": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["gravity.operators", "gravity.models"]}}
        }
      }
    },
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network_called": {"const": false}
  }
}
