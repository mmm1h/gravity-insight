{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.semantic-definition.v1",
  "description": "Compose Definition: a versioned physical member catalog compiled to governed Multidim requests. Not a Business Definition or Business Source; select this schema by filename, not the shared $id/schema_version.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["definition_id", "version"],
        "properties": {
          "definition_id": {"const": "report.ap-cost-observation"},
          "version": {"minimum": 5}
        }
      },
      "then": {"required": ["cost_granularity_and_provenance", "forbidden_claims"]}
    }
  ],
  "required": [
    "schema_version",
    "definition_id",
    "version",
    "description",
    "source",
    "access_scope",
    "limits",
    "metrics",
    "dimensions",
    "filters",
    "grains",
    "joins",
    "allowed_claims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "gravity.semantic-definition.v1"},
    "definition_id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "operation_id", "operation_contract_version", "fact_path"],
      "properties": {
        "product": {"const": "multidim"},
        "operation_id": {"const": "report.multidim.query"},
        "operation_contract_version": {"type": "integer", "minimum": 1},
        "fact_path": {"type": "string", "pattern": "^/"},
        "request_profile": {"const": "frontend_adreport_current"}
      }
    },
    "access_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "physical_filter"],
      "properties": {
        "kind": {"const": "app_bound"},
        "physical_filter": {"const": "app_id"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "dimensions", "filters", "joins"],
      "properties": {
        "metrics": {"const": 1},
        "dimensions": {"type": "integer", "minimum": 0, "maximum": 8},
        "filters": {"type": "integer", "minimum": 0, "maximum": 8},
        "joins": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
    "grains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grain"}},
    "joins": {"type": "array", "items": {"$ref": "#/$defs/join"}},
    "allowed_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "cost_granularity_and_provenance": {"$ref": "#/$defs/cost_granularity_and_provenance"},
    "forbidden_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "cost_granularity_and_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_cost", "revenue", "join_evidence"],
      "properties": {
        "native_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "non_time_dimensions", "date_semantics", "post_registration_user_grouping", "estimation"],
          "properties": {
            "metric": {"const": "ap_cost"},
            "non_time_dimensions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "date_semantics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "basis", "gap_code", "evidence"],
              "properties": {
                "status": {"const": "undeclared"},
                "basis": {"type": "null"},
                "gap_code": {"$ref": "#/$defs/gap_code"},
                "evidence": {"$ref": "#/$defs/metric_metadata_evidence"}
              }
            },
            "post_registration_user_grouping": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "gap_code"],
              "properties": {
                "status": {"const": "unavailable"},
                "gap_code": {"$ref": "#/$defs/gap_code"}
              }
            },
            "estimation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["native_or_exact_allowed", "required_label", "required_disclosures"],
              "properties": {
                "native_or_exact_allowed": {"const": false},
                "required_label": {"const": "estimated"},
                "required_disclosures": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["method", "covered_population", "excluded_label_treatment", "assumptions"]
                  }
                }
              }
            }
          }
        },
        "revenue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cohort_basis", "evidence", "metrics"],
          "properties": {
            "cohort_basis": {"const": "activation"},
            "evidence": {"$ref": "#/$defs/metric_metadata_evidence"},
            "metrics": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["physical_name", "metric_type", "event_timing"],
                "properties": {
                  "physical_name": {"enum": ["standard_1day_pay_amount", "multi_day_pay_amount"]},
                  "metric_type": {"enum": [0, 2]},
                  "event_timing": {"enum": ["within_activation_day", "post_activation_day_n"]}
                }
              }
            }
          }
        },
        "join_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_path", "registry_id", "right_side_semantics", "post_registration_user_property_mapping"],
          "properties": {
            "artifact_path": {"const": "../join-keys/registry.v1.json"},
            "registry_id": {"const": "join-key://gravity/acquisition-user@1"},
            "right_side_semantics": {"const": "acquisition_attribution_fields"},
            "post_registration_user_property_mapping": {"const": false}
          }
        }
      }
    },
    "gap_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "metric_metadata_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "field", "declared_meaning"],
      "properties": {
        "operation_id": {"const": "report.multidim.metric.list"},
        "field": {"const": "data.list[].tip"},
        "declared_meaning": {"enum": ["total_spend_only", "activation_cohort"]}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "member": {
      "type": "object",
      "required": ["definition_id", "version", "physical_name"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "physical_name": {"type": "string", "minLength": 1}
      }
    },
    "metric": {
      "allOf": [
        {"$ref": "#/$defs/member"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition_id", "version", "physical_name", "metadata_operation", "allowed_grains"],
          "properties": {
            "definition_id": {"$ref": "#/$defs/id"},
            "version": {"type": "integer", "minimum": 1},
            "physical_name": {"type": "string", "minLength": 1},
            "metadata_operation": {"const": "report.multidim.metric.list"},
            "allowed_grains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version", "physical_name", "required_join"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "physical_name": {"type": "string", "minLength": 1},
        "required_join": {"$ref": "#/$defs/id"}
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version", "physical_name", "operators", "required_dimension"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "physical_name": {"type": "string", "minLength": 1},
        "operators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "required_dimension": {"$ref": "#/$defs/id"}
      }
    },
    "grain": {"$ref": "#/$defs/member"},
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "version", "left_source", "right_member", "cardinality", "realization"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "left_source": {"type": "string", "minLength": 1},
        "right_member": {"$ref": "#/$defs/id"},
        "cardinality": {"enum": ["one_to_one", "many_to_one"]},
        "realization": {"const": "embedded_dimension"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1}
      }
    }
  }
}
