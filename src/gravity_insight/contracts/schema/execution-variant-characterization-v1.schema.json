{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.execution-variant-characterization.v1",
  "type": "object",
  "required": [
    "schema_version", "characterization_id", "product", "variants", "corpus",
    "dimensions", "equivalent", "fixed", "mismatches", "rollback", "current_trust",
    "selection_status", "automatic_selection", "network_called", "artifact_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.execution-variant-characterization.v1"},
    "characterization_id": {
      "type": "string", "minLength": 1, "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "product": {"$ref": "#/$defs/product"},
    "variants": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/variant_reference"}
    },
    "corpus": {
      "type": "object",
      "required": ["corpus_id", "corpus_sha256", "case_count", "case_ids", "cases"],
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "type": "string", "minLength": 1, "maxLength": 160,
          "pattern": "^[A-Za-z0-9._:@/-]+$"
        },
        "corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "case_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "case_ids": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 96}
        },
        "cases": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/case"}
        }
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "input_semantics", "output_semantics", "completeness", "data_quality",
        "allowed_claims", "privacy", "freshness", "request_count",
        "journey_regression"
      ],
      "additionalProperties": false,
      "properties": {
        "input_semantics": {"enum": ["equivalent", "mismatch"]},
        "output_semantics": {"enum": ["equivalent", "mismatch"]},
        "completeness": {"enum": ["equivalent", "mismatch"]},
        "data_quality": {"enum": ["equivalent", "mismatch"]},
        "allowed_claims": {"enum": ["equivalent", "mismatch"]},
        "privacy": {"enum": ["equivalent", "mismatch"]},
        "freshness": {"enum": ["equivalent", "mismatch"]},
        "request_count": {"enum": ["equivalent", "mismatch"]},
        "journey_regression": {"enum": ["equivalent", "mismatch"]}
      }
    },
    "equivalent": {"type": "boolean"},
    "fixed": {"const": true},
    "mismatches": {
      "type": "array", "maxItems": 64,
      "items": {"$ref": "#/$defs/mismatch"}
    },
    "rollback": {"$ref": "#/$defs/rollback"},
    "current_trust": {
      "type": "object",
      "required": ["trust_status", "contract_digest", "reason_codes"],
      "additionalProperties": false,
      "properties": {
        "trust_status": {
          "enum": ["not_evaluated", "stable", "unknown", "degraded", "blocked", "quarantined"]
        },
        "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reason_codes": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
        }
      }
    },
    "selection_status": {"const": "disabled_until_r14_d"},
    "automatic_selection": {"const": false},
    "network_called": {"const": false},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": ["identity_kind", "selector", "contract_version", "contract_digest"],
      "additionalProperties": false,
      "properties": {
        "identity_kind": {"const": "product"},
        "selector": {"type": "string", "minLength": 1, "maxLength": 160},
        "contract_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "variant_reference": {
      "type": "object",
      "required": ["variant_uri", "descriptor_sha256"],
      "additionalProperties": false,
      "properties": {
        "variant_uri": {
          "type": "string",
          "pattern": "^gravity\\.execution-variant/[a-z0-9-]+/[a-z0-9-]+@[1-9][0-9]*$"
        },
        "descriptor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "input_sha256", "output_sha256", "completeness_sha256",
        "data_quality_sha256", "allowed_claims_sha256", "privacy_sha256",
        "freshness_sha256", "request_count", "journey_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "completeness_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "data_quality_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "allowed_claims_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "privacy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "freshness_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "request_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "journey_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "case": {
      "type": "object",
      "required": ["case_id", "baseline", "candidate"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "baseline": {"$ref": "#/$defs/evidence"},
        "candidate": {"$ref": "#/$defs/evidence"}
      }
    },
    "mismatch": {
      "type": "object",
      "required": ["case_id", "dimension", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "dimension": {
          "enum": [
            "input_semantics", "output_semantics", "completeness", "data_quality",
            "allowed_claims", "privacy", "freshness", "request_count",
            "journey_regression"
          ]
        },
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
      }
    },
    "rollback": {
      "type": "object",
      "required": ["canonical_variant_uri", "strategy", "capability_preserved"],
      "additionalProperties": false,
      "properties": {
        "canonical_variant_uri": {
          "const": "gravity.execution-variant/analysis-query-event/direct@1"
        },
        "strategy": {"const": "pin_canonical_direct"},
        "capability_preserved": {"const": true}
      }
    }
  }
}
