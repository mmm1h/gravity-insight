{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.task-context-pack.v1",
  "title": "Gravity Task Context Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "input", "history_policy", "matched_entries",
    "minimal_references", "reading_order", "impact_scope", "risk_assessment", "focused_gate",
    "full_gate", "size_comparison", "unresolved"
  ],
  "properties": {
    "schema_version": {"const": "gravity.task-context-pack.v1"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": {"enum": ["issue", "journey", "skill", "selector", "changed_files"]},
        "values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "history_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_excluded", "excluded_prefixes"],
      "properties": {
        "default_excluded": {"const": true},
        "excluded_prefixes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "matched_entries": {"type": "array", "items": {"type": "string"}},
    "minimal_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "reading_order": {"type": "array", "items": {"type": "string"}},
    "impact_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_definition_id", "profile", "seed_modules", "direct_dependencies", "direct_dependents", "transitive_dependents", "impacted_test_files"],
      "properties": {
        "graph_definition_id": {"type": "string"},
        "profile": {"const": "canonical"},
        "seed_modules": {"type": "array", "items": {"type": "string"}},
        "direct_dependencies": {"type": "array", "items": {"type": "string"}},
        "direct_dependents": {"type": "array", "items": {"type": "string"}},
        "transitive_dependents": {"$ref": "#/$defs/bounded_set"},
        "impacted_test_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risk_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "review_mode", "validation_profile", "matched_rules", "selected_commands", "selection_policy"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "review_mode": {"enum": ["self_review", "independent_review", "adversarial_review"]},
        "validation_profile": {"enum": ["focused", "surface_consumer", "integrated_canary"]},
        "matched_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "level", "rule"],
            "properties": {
              "subject": {"type": "string", "minLength": 1},
              "level": {"enum": ["low", "medium", "high"]},
              "rule": {"type": "string", "minLength": 1}
            }
          }
        },
        "selected_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "selection_policy": {"const": "highest_match_wins; unclassified paths fail closed to high"}
      }
    },
    "focused_gate": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "full_gate": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "size_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_bytes", "pack_estimated_tokens", "canonical_architecture_bytes", "canonical_architecture_estimated_tokens", "ratio_to_canonical_architecture"],
      "properties": {
        "pack_bytes": {"type": "integer", "minimum": 0},
        "pack_estimated_tokens": {"type": "integer", "minimum": 0},
        "canonical_architecture_bytes": {"type": "integer", "minimum": 0},
        "canonical_architecture_estimated_tokens": {"type": "integer", "minimum": 0},
        "ratio_to_canonical_architecture": {"type": "number", "minimum": 0}
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "layer", "reasons", "bytes", "estimated_tokens"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "layer": {"enum": ["L0", "L1", "L2", "L3"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "bytes": {"type": "integer", "minimum": 0},
        "estimated_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "bounded_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sha256", "preview", "truncated"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preview": {"type": "array", "items": {"type": "string"}},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
