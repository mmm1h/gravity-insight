{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.execution-snapshot.v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "runtime",
    "journey",
    "skill",
    "project_overlay",
    "capabilities",
    "semantics",
    "operators",
    "models",
    "context_packs",
    "contracts",
    "snapshot_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.execution-snapshot.v1"},
    "status": {"enum": ["resolved", "blocked"]},
    "runtime": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "journey": {"$ref": "#/$defs/journey"},
    "skill": {"anyOf": [{"$ref": "#/$defs/skill"}, {"type": "null"}]},
    "project_overlay": {"anyOf": [{"$ref": "#/$defs/overlay"}, {"type": "null"}]},
    "capabilities": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/capability"}},
    "semantics": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/semantic"}},
    "operators": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/operator"}},
    "models": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/model"}},
    "context_packs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/context_pack"}},
    "contracts": {
      "type": "object",
      "required": ["input_schema_version", "analysis_result_schema_version", "execution_mode", "execution_owner"],
      "additionalProperties": false,
      "properties": {
        "input_schema_version": {"type": ["string", "null"], "maxLength": 256},
        "analysis_result_schema_version": {"const": "gravity.analysis-result.v1"},
        "execution_mode": {"enum": ["operation", "product", "composite", "plan", "unavailable"]},
        "execution_owner": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "snapshot_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "status": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
    "journey": {
      "type": "object",
      "required": ["journey_id", "version", "digest"],
      "additionalProperties": false,
      "properties": {
        "journey_id": {"type": "string", "minLength": 3, "maxLength": 256},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "skill": {
      "type": "object",
      "required": ["uri", "version", "manifest_digest", "package_digest", "resolution", "team_lock_digest", "hub_source_digest", "hub_source_reference", "trusted_pack_lock_digest", "trusted_pack_state_digest", "trusted_pack_verification_digest", "lifecycle", "readiness", "validation"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 16, "maxLength": 256},
        "version": {"type": "string", "minLength": 5, "maxLength": 64},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "resolution": {"const": "locked"},
        "team_lock_digest": {"$ref": "#/$defs/nullable_digest"},
        "hub_source_digest": {"$ref": "#/$defs/nullable_digest"},
        "hub_source_reference": {"anyOf": [{"$ref": "#/$defs/hub_source"}, {"type": "null"}]},
        "trusted_pack_lock_digest": {"$ref": "#/$defs/nullable_digest"},
        "trusted_pack_state_digest": {"$ref": "#/$defs/nullable_digest"},
        "trusted_pack_verification_digest": {"$ref": "#/$defs/nullable_digest"},
        "lifecycle": {"enum": ["draft", "reviewed", "stable", "deprecated", "revoked"]},
        "readiness": {"enum": ["blocked", "executable"]},
        "validation": {"enum": ["unvalidated", "validated"]}
      }
    },
    "hub_source": {
      "type": "object",
      "required": ["source_id", "transport", "source_descriptor_digest", "source_revision", "index_digest"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "transport": {"enum": ["git", "static_https"]},
        "source_descriptor_digest": {"$ref": "#/$defs/digest"},
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "index_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "overlay": {
      "type": "object",
      "required": ["uri", "version", "digest", "source_revision"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 20, "maxLength": 256},
        "version": {"type": "string", "minLength": 5, "maxLength": 64},
        "digest": {"$ref": "#/$defs/digest"},
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "capability": {
      "type": "object",
      "required": ["identity_kind", "selector", "contract_version", "contract_digest", "trust_digest", "status"],
      "additionalProperties": false,
      "properties": {
        "identity_kind": {"enum": ["operation", "product", "composite"]},
        "selector": {"type": "string", "minLength": 1, "maxLength": 256},
        "contract_version": {"type": ["string", "null"], "maxLength": 64},
        "contract_digest": {"$ref": "#/$defs/nullable_digest"},
        "trust_digest": {"$ref": "#/$defs/nullable_digest"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "semantic": {
      "type": "object",
      "required": ["uri", "version", "definition_digest", "binding_digest", "source_digest", "registry_digest", "status"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "version": {"type": ["integer", "null"], "minimum": 1},
        "definition_digest": {"$ref": "#/$defs/nullable_digest"},
        "binding_digest": {"$ref": "#/$defs/nullable_digest"},
        "source_digest": {"$ref": "#/$defs/nullable_digest"},
        "registry_digest": {"$ref": "#/$defs/nullable_digest"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "operator": {
      "type": "object",
      "required": ["uri", "version", "digest", "assumptions_digest", "status"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "version": {"type": ["integer", "null"], "minimum": 1},
        "digest": {"$ref": "#/$defs/nullable_digest"},
        "assumptions_digest": {"$ref": "#/$defs/nullable_digest"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "model": {
      "type": "object",
      "required": ["uri", "version", "digest", "status"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "version": {"type": ["integer", "null"], "minimum": 1},
        "digest": {"$ref": "#/$defs/nullable_digest"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "context_pack": {
      "type": "object",
      "required": ["requirement_uri", "requirement_digest", "provider_uri", "provider_digest", "source_revision", "pack_digest", "status"],
      "additionalProperties": false,
      "properties": {
        "requirement_uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "requirement_digest": {"$ref": "#/$defs/nullable_digest"},
        "provider_uri": {"type": ["string", "null"], "maxLength": 256},
        "provider_digest": {"$ref": "#/$defs/nullable_digest"},
        "source_revision": {"type": ["string", "null"], "maxLength": 256},
        "pack_digest": {"$ref": "#/$defs/nullable_digest"},
        "status": {"$ref": "#/$defs/status"}
      }
    }
  }
}
