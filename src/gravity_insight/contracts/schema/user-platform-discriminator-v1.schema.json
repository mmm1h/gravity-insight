{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.user-platform-discriminator-registry.v1",
  "type": "object",
  "required": ["$schema", "artifact_kind", "schema_version", "registry_id", "bindings"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "../schema/user-platform-discriminator-v1.schema.json"},
    "artifact_kind": {"const": "user_platform_discriminator_registry"},
    "schema_version": {"const": "gravity.user-platform-discriminator-registry.v1"},
    "registry_id": {"const": "user-platform-discriminator://gravity/acquisition-user@1"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "field_reference": {
      "type": "object",
      "required": ["operation_id", "path"],
      "additionalProperties": false,
      "properties": {
        "operation_id": {"const": "analysis.user_detail.list"},
        "path": {"const": "data.list[].AdPlatform"}
      }
    },
    "observation": {
      "type": "object",
      "required": ["field", "selected_row_count", "observed_values"],
      "additionalProperties": false,
      "properties": {
        "field": {"enum": ["bytedanceMid1", "bytedanceMid3"]},
        "selected_row_count": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "observed_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "source", "sampled_on", "revalidate_after", "request_count",
        "source_row_count", "observations", "limitation_codes"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^issue://[a-z0-9.-]+/[a-z0-9.-]+/[1-9][0-9]*(#[a-z0-9.-]+)?$",
          "maxLength": 256
        },
        "sampled_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "revalidate_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "request_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "source_row_count": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/observation"}
        },
        "limitation_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 96}
        }
      }
    },
    "binding": {
      "type": "object",
      "required": ["binding_id", "platform", "status", "field", "accepted_value", "evidence"],
      "additionalProperties": false,
      "properties": {
        "binding_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 160},
        "platform": {"enum": ["bytedance", "kuaishou"]},
        "status": {"const": "proven"},
        "field": {"$ref": "#/$defs/field_reference"},
        "accepted_value": {"enum": ["bytedance", "kuaishou"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
