{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.outcome-evaluation-handoff-request.v1",
  "type": "object",
  "required": ["schema_version", "proposal", "observation", "evidence_window", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.outcome-evaluation-handoff-request.v1"},
    "proposal": {"type": "object"},
    "observation": {"$ref": "#/$defs/observation"},
    "evidence_window": {"$ref": "#/$defs/window"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "window": {"type": "object", "required": ["start", "end", "timezone"], "additionalProperties": false, "properties": {"start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}, "timezone": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "observation": {
      "type": "object",
      "required": ["schema_version", "experiment_ref", "proposal_id", "proposal_digest", "status", "started_at", "ended_at", "assignment_digest", "evidence_digest"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "gravity.experiment-observation.v1"},
        "experiment_ref": {"type": "string", "pattern": "^experiment://[A-Za-z0-9._:/@-]{1,240}$"},
        "proposal_id": {"type": "string", "pattern": "^exp1_[0-9a-f]{32}$"},
        "proposal_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["completed", "incomplete", "cancelled"]},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "ended_at": {"$ref": "#/$defs/timestamp"},
        "assignment_digest": {"$ref": "#/$defs/nullable_digest"},
        "evidence_digest": {"$ref": "#/$defs/nullable_digest"}
      }
    }
  }
}
