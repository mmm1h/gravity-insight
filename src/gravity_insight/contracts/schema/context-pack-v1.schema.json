{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.context-pack.v1",
  "type": "object",
  "required": ["schema_version", "status", "provider", "requirement", "skill_id", "journey_id", "subject_entities", "resolved_entities", "requested_time", "authority_policy", "items", "alignment", "required_status", "conflicts", "gaps", "claims", "budget", "pack_digest", "network_called"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.context-pack.v1"},
    "status": {"enum": ["available", "partial", "blocked"]},
    "provider": {
      "type": "object",
      "required": ["uri", "digest", "source_revision"],
      "additionalProperties": false,
      "properties": {
        "uri": {"type": "string", "pattern": "^context-provider://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"},
        "digest": {"$ref": "#/$defs/digest"},
        "source_revision": {"$ref": "#/$defs/revision"}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["requirement_id", "digest"],
      "additionalProperties": false,
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^context://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "skill_id": {"type": "string", "minLength": 8, "maxLength": 256},
    "journey_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "subject_entities": {"$ref": "#/$defs/string_array"},
    "resolved_entities": {"$ref": "#/$defs/string_array"},
    "requested_time": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/time_window"}
    },
    "authority_policy": {"$ref": "#/$defs/authority_policy"},
    "items": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
    "alignment": {
      "type": "object",
      "required": ["matched", "excluded", "superseded"],
      "additionalProperties": false,
      "properties": {
        "matched": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 2048}},
        "excluded": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/excluded"}},
        "superseded": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/superseded"}}
      }
    },
    "required_status": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/status"}},
    "conflicts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/conflict"}},
    "gaps": {"type": "array", "maxItems": 384, "items": {"$ref": "#/$defs/gap"}},
    "claims": {
      "type": "object",
      "required": ["confirmed_claims_allowed", "optional_context_complete", "authority_ceiling"],
      "additionalProperties": false,
      "properties": {
        "confirmed_claims_allowed": {"type": "boolean"},
        "optional_context_complete": {"type": "boolean"},
        "authority_ceiling": {"enum": ["project_authoritative", "canonical", "supporting", "declared_intent", "unverified", "none"]}
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_files", "max_file_bytes", "max_total_bytes", "max_total_lines", "used_files", "used_bytes", "used_lines"],
      "additionalProperties": false,
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_total_lines": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "used_files": {"type": "integer", "minimum": 0, "maximum": 256},
        "used_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "used_lines": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "pack_digest": {"$ref": "#/$defs/digest"},
    "network_called": {"const": false},
    "provider_rpc_called": {"type": "boolean"},
    "provider_internal_io_controlled": {"const": false},
    "provider_internal_network": {"const": "not_observable"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "string_array": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "time_window": {
      "type": "object",
      "required": ["start", "end", "timezone"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "string", "maxLength": 10},
        "end": {"type": "string", "maxLength": 10},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "authority_policy": {
      "type": "object",
      "required": ["required", "allow_supporting", "allow_unverified"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["project_authoritative", "canonical", "supporting"]}},
        "allow_supporting": {"type": "boolean"},
        "allow_declared_intent": {"type": "boolean"},
        "allow_unverified": {"type": "boolean"}
      }
    },
    "status": {
      "type": "object",
      "required": ["item_id", "status", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["available", "stale", "missing", "denied", "conflicting", "unsupported"]},
        "reason_code": {"anyOf": [{"$ref": "#/$defs/reason"}, {"type": "null"}]}
      }
    },
    "gap": {
      "type": "object",
      "required": ["item_id", "required", "status", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"$ref": "#/$defs/identifier"},
        "required": {"type": "boolean"},
        "status": {"enum": ["stale", "missing", "denied", "conflicting", "unsupported"]},
        "reason_code": {"$ref": "#/$defs/reason"}
      }
    },
    "excluded": {
      "type": "object",
      "required": ["item_id", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"$ref": "#/$defs/identifier"},
        "reason_code": {"$ref": "#/$defs/reason"}
      }
    },
    "superseded": {
      "type": "object",
      "required": ["item_id", "uri", "superseded_by", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"$ref": "#/$defs/identifier"},
        "uri": {"type": "string", "minLength": 8, "maxLength": 2048},
        "superseded_by": {"type": "string", "minLength": 8, "maxLength": 2048},
        "reason_code": {"const": "CONTEXT_SUPERSEDED"}
      }
    },
    "conflict": {
      "type": "object",
      "required": ["fact_id", "item_ids", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "fact_id": {"$ref": "#/$defs/identifier"},
        "item_ids": {"type": "array", "minItems": 2, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "reason_code": {"$ref": "#/$defs/reason"}
      }
    }
  }
}
