{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.operator-result.governed-method.v1",
  "type": "object",
  "required": [
    "schema_version",
    "method",
    "verdict",
    "metrics",
    "ranked_rows",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gravity.operator-result.governed-method.v1"
    },
    "method": {
      "enum": [
        "campaign-outcome-evaluation",
        "churn-segment-profile",
        "funnel-diagnosis",
        "ltv-payback-period",
        "metric-decomposition",
        "price-elasticity",
        "retention-curve",
        "scenario-projection",
        "sentiment-aggregation"
      ]
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "ranked_rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/result_row"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "result_row": {
      "type": "object",
      "required": [
        "key",
        "value",
        "contribution",
        "rank",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "evidence": {
          "type": "object",
          "required": [
            "step_id",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "step_id": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "pattern": "^/.+$"
            }
          }
        }
      }
    }
  }
}
