{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.thinkingai-full-specification.v1",
  "type": "object",
  "required": [
    "artifact_kind", "schema_version", "source_snapshot_sha256",
    "source_observation_sha256", "representative_set_sha256", "coverage_count",
    "specified_count", "skill_specification_count", "safe_alternative_count",
    "executable_count", "blocked_count", "validated_count", "unvalidated_count",
    "items", "network_called", "specification_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "thinkingai_full_specification"},
    "schema_version": {"const": "gravity.thinkingai-full-specification.v1"},
    "source_snapshot_sha256": {"$ref": "#/$defs/digest"},
    "source_observation_sha256": {"$ref": "#/$defs/digest"},
    "representative_set_sha256": {"$ref": "#/$defs/digest"},
    "coverage_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "specified_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "skill_specification_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "safe_alternative_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "executable_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "blocked_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "validated_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "unvalidated_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/item"}
    },
    "network_called": {"const": false},
    "specification_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "uri": {"type": "string", "minLength": 1, "maxLength": 512},
    "reason_array": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$", "maxLength": 128}
    },
    "text_array": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "skill": {
      "type": "object",
      "required": [
        "skill_uri", "manifest_sha256", "package_sha256", "archive_sha256",
        "artifact_path", "specification", "lifecycle", "readiness", "validation",
        "dependency_contract_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "skill_uri": {"type": "string", "pattern": "^skill://gravity\\.game/[a-z0-9-]+@1\\.0\\.0$"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "package_sha256": {"$ref": "#/$defs/digest"},
        "archive_sha256": {"$ref": "#/$defs/digest"},
        "artifact_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "specification": {"const": "specified"},
        "lifecycle": {"enum": ["reviewed", "stable", "deprecated", "revoked"]},
        "readiness": {"enum": ["blocked", "executable"]},
        "validation": {"enum": ["unvalidated", "validated"]},
        "dependency_contract_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "alternative": {
      "type": "object",
      "required": ["alternative_kind", "alternative_ref", "guidance", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "alternative_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "alternative_ref": {"type": "string", "pattern": "^alternative://gravity/.+@1$", "maxLength": 256},
        "guidance": {"$ref": "#/$defs/text"},
        "reason_code": {
          "enum": ["AUTOMATIC_TEXT_TO_SQL_OUT_OF_SCOPE", "THINKINGAI_VENDOR_SPECIFIC_OPERATION"]
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "source_id", "source_content_sha256", "gravity_taxonomy_ids",
        "mapping_kind", "license_review", "specification", "blocker_reason_codes",
        "next_evidence", "distribution_allowed", "independent_authorship",
        "source_content_used", "skill", "alternative"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
        "source_content_sha256": {"$ref": "#/$defs/digest"},
        "gravity_taxonomy_ids": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/uri"}
        },
        "mapping_kind": {"enum": ["skill_specification", "safe_alternative"]},
        "license_review": {"enum": ["approved", "blocked"]},
        "specification": {"const": "specified"},
        "blocker_reason_codes": {"$ref": "#/$defs/reason_array"},
        "next_evidence": {"$ref": "#/$defs/text_array"},
        "distribution_allowed": {"type": "boolean"},
        "independent_authorship": {"type": "boolean"},
        "source_content_used": {"const": false},
        "skill": {"oneOf": [{"$ref": "#/$defs/skill"}, {"type": "null"}]},
        "alternative": {"oneOf": [{"$ref": "#/$defs/alternative"}, {"type": "null"}]}
      }
    }
  }
}
