{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.policy-decision.v1",
  "type": "object",
  "required": ["schema_version", "decision_id", "policy_revision", "decision", "reason_codes", "evaluated_effect", "masked_paths"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.policy-decision.v1"},
    "decision_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "policy_revision": {"const": "gravity.action-policy.v1"},
    "decision": {"enum": ["allow", "deny", "require_confirmation"]},
    "reason_codes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "evaluated_effect": {"const": "mutation"},
    "masked_paths": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
