{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.external-context-bindings.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "providers", "requirements"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "external_context_bindings"},
    "schema_version": {"const": "gravity.external-context-bindings.v1"},
    "providers": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object"}},
    "requirements": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/requirement"}}
  },
  "$defs": {
    "string_array": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "requirement": {
      "type": "object",
      "required": ["artifact_kind", "schema_version", "requirement_id", "provider_uri", "skill_uri", "journey_id", "subject_entities", "required_windows", "timezone", "authority_policy", "allowed_sensitivity", "freshness_policy", "budget", "resources"],
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {"const": "external_context_requirement"},
        "schema_version": {"const": "gravity.external-context-requirement.v1"},
        "requirement_id": {"type": "string", "pattern": "^context://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$", "maxLength": 256},
        "provider_uri": {"type": "string", "pattern": "^context-provider://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$", "maxLength": 256},
        "skill_uri": {"type": "string", "pattern": "^skill://[a-z][a-z0-9.-]*/[a-z0-9]+(-[a-z0-9]+)*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$", "maxLength": 256},
        "journey_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 256},
        "subject_entities": {"$ref": "#/$defs/string_array"},
        "required_windows": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
        "authority_policy": {
          "type": "object",
          "required": ["required", "allow_supporting", "allow_unverified"],
          "additionalProperties": false,
          "properties": {
            "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["project_authoritative", "canonical", "supporting"]}},
            "allow_supporting": {"type": "boolean"},
            "allow_declared_intent": {"type": "boolean"},
            "allow_unverified": {"type": "boolean"}
          }
        },
        "allowed_sensitivity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}},
        "freshness_policy": {
          "type": "object",
          "required": ["as_of", "max_age_days"],
          "additionalProperties": false,
          "properties": {
            "as_of": {"type": ["string", "null"], "maxLength": 10},
            "max_age_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 36500}
          }
        },
        "budget": {
          "type": "object",
          "required": ["max_files", "max_file_bytes", "max_total_bytes", "max_total_lines"],
          "additionalProperties": false,
          "properties": {
            "max_files": {"type": "integer", "minimum": 1, "maximum": 256},
            "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
            "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
            "max_total_lines": {"type": "integer", "minimum": 1, "maximum": 1000000}
          }
        },
        "resources": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/resource"}}
      }
    },
    "resource": {
      "type": "object",
      "required": ["item_id", "resource_uri", "required"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
        "resource_uri": {"type": "string", "minLength": 8, "maxLength": 2048},
        "required": {"type": "boolean"}
      }
    }
  }
}
