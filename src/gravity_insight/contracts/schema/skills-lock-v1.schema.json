{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.skills-lock.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "source", "runtime_version", "requested", "skills", "lock_digest"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "skills_lock"},
    "schema_version": {"const": "gravity.skills-lock.v1"},
    "source": {"$ref": "#/$defs/source"},
    "runtime_version": {"$ref": "#/$defs/version"},
    "requested": {"$ref": "#/$defs/identities"},
    "skills": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/skill"}},
    "lock_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "identities": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 256}},
    "source": {
      "type": "object",
      "required": ["source_id", "transport", "source_descriptor_digest", "source_revision", "index_digest"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "transport": {"enum": ["git", "static_https"]},
        "source_descriptor_digest": {"$ref": "#/$defs/digest"},
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "index_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "skill": {
      "type": "object",
      "required": ["skill_uri", "manifest_digest", "package_digest", "archive_sha256", "artifact_path", "artifact_size", "runtime_requires", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "skill_uri": {"type": "string", "minLength": 8, "maxLength": 256},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "archive_sha256": {"$ref": "#/$defs/digest"},
        "artifact_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "artifact_size": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "runtime_requires": {"type": "string", "minLength": 1, "maxLength": 64},
        "dependencies": {"type": "object"}
      }
    }
  }
}
