{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.external-context-provider.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "uri", "version", "provider_id", "owner", "transport", "effects", "auth_scope", "resource_types", "allowed_resource_prefixes", "capabilities", "rpc", "deployment", "source_trust", "authority_ceiling", "role"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "external_context_provider"},
    "schema_version": {"const": "gravity.external-context-provider.v1"},
    "uri": {"type": "string", "pattern": "^context-provider://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$", "maxLength": 256},
    "version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
    "owner": {"type": "string", "minLength": 1, "maxLength": 128},
    "transport": {"enum": ["mcp", "subprocess", "host"]},
    "effects": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "read"}},
    "auth_scope": {"enum": ["project", "team", "user"]},
    "resource_types": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["document", "code", "configuration", "contract", "release", "git_fact", "project_semantic"]}},
    "allowed_resource_prefixes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 5, "maxLength": 512}},
    "capabilities": {
      "type": "object",
      "required": ["operations", "supports_cancellation", "supports_cache", "output_formats", "freshness_model", "entity_time_alignment"],
      "additionalProperties": false,
      "properties": {
        "operations": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["list", "search", "read", "list_changed"]}},
        "supports_cancellation": {"type": "boolean"},
        "supports_cache": {"type": "boolean"},
        "output_formats": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "json"}},
        "freshness_model": {"enum": ["provider_revision", "content_hash", "ttl", "none"]},
        "entity_time_alignment": {"enum": ["full", "partial", "none"]}
      }
    },
    "rpc": {
      "type": "object",
      "required": ["max_concurrency", "max_calls_per_session", "timeout_ms", "cancellation_grace_ms", "max_attempts", "max_output_bytes", "max_output_tokens", "circuit_failure_threshold", "circuit_cooldown_ms"],
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_calls_per_session": {"type": "integer", "minimum": 1, "maximum": 10000},
        "timeout_ms": {"type": "integer", "minimum": 10, "maximum": 120000},
        "cancellation_grace_ms": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_output_bytes": {"type": "integer", "minimum": 256, "maximum": 67108864},
        "max_output_tokens": {"type": "integer", "minimum": 64, "maximum": 16777216},
        "circuit_failure_threshold": {"type": "integer", "minimum": 1, "maximum": 20},
        "circuit_cooldown_ms": {"type": "integer", "minimum": 10, "maximum": 3600000}
      }
    },
    "deployment": {
      "type": "object",
      "required": ["sandbox_owner", "declared_egress_hosts", "inherits_gravity_credentials", "subprocess"],
      "additionalProperties": false,
      "properties": {
        "sandbox_owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "declared_egress_hosts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+(?::[0-9]{1,5})?$", "maxLength": 256}},
        "inherits_gravity_credentials": {"const": false},
        "subprocess": {
          "type": ["object", "null"],
          "required": ["executable", "arguments", "working_directory"],
          "additionalProperties": false,
          "properties": {
            "executable": {"type": "string", "minLength": 1, "maxLength": 2048},
            "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}},
            "working_directory": {"type": "string", "minLength": 1, "maxLength": 2048},
            "protocol": {"enum": ["provider_rpc", "command"]},
            "command": {
              "type": ["object", "null"],
              "required": ["routes", "guidance"],
              "additionalProperties": false,
              "properties": {
                "routes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {"$ref": "#/$defs/command_route"}
                },
                "guidance": {"$ref": "#/$defs/command_guidance_set"}
              }
            }
          },
          "oneOf": [
            {
              "type": "object",
              "required": ["protocol", "command"],
              "properties": {"protocol": {"const": "command"}, "command": {"type": "object"}}
            },
            {
              "type": "object",
              "properties": {"protocol": {"const": "provider_rpc"}, "command": {"type": "null"}}
            },
            {"type": "null"}
          ]
        }
      }
    },
    "source_trust": {"enum": ["reviewed", "observed", "untrusted"]},
    "authority_ceiling": {"enum": ["project_authoritative", "canonical", "supporting", "declared_intent", "unverified"]},
    "role": {"const": "data"}
  },
  "$defs": {
    "command_argument": {
      "oneOf": [
        {
          "type": "object",
          "required": ["literal"],
          "additionalProperties": false,
          "properties": {
            "literal": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        },
        {
          "type": "object",
          "required": ["uri_path_segment"],
          "additionalProperties": false,
          "properties": {
            "uri_path_segment": {"type": "integer", "minimum": 0, "maximum": 7}
          }
        },
        {
          "type": "object",
          "required": ["uri_path_segments", "separator"],
          "additionalProperties": false,
          "properties": {
            "uri_path_segments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0, "maximum": 7}
            },
            "separator": {"enum": ["/", ":", "-"]}
          }
        }
      ]
    },
    "command_resource": {
      "type": "object",
      "required": ["item_id", "fact_id", "title", "resource_type", "entity_refs", "valid_time", "effective_range", "sensitivity", "citation_path"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
        "fact_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "resource_type": {"enum": ["document", "code", "configuration", "contract", "release", "git_fact", "project_semantic"]},
        "entity_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
        "valid_time": {
          "type": "object",
          "required": ["start", "end", "timezone"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": ["string", "null"], "maxLength": 10},
            "end": {"type": ["string", "null"], "maxLength": 10},
            "timezone": {"type": "string", "minLength": 1, "maxLength": 64}
          }
        },
        "effective_range": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": ["string", "null"], "maxLength": 10},
            "end": {"type": ["string", "null"], "maxLength": 10}
          }
        },
        "sensitivity": {"enum": ["public", "internal", "confidential"]},
        "citation_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "content_pointer": {"type": "string", "pattern": "^(/([^/~]|~[01])*)*$", "maxLength": 512}
      }
    },
    "command_failure_rule": {
      "type": "object",
      "required": ["kind", "exit_codes", "json_pointer", "equals"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "resource_unavailable"},
        "exit_codes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 255}},
        "json_pointer": {"type": "string", "pattern": "^/([^/~]|~[01])+(?:/([^/~]|~[01])*)*$", "maxLength": 512},
        "equals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": ["string", "integer", "boolean"]}
        }
      }
    },
    "command_freshness": {
      "type": "object",
      "required": ["timestamp_pointer", "max_age_seconds"],
      "additionalProperties": false,
      "properties": {
        "timestamp_pointer": {"type": "string", "pattern": "^/([^/~]|~[01])+(?:/([^/~]|~[01])*)*$", "maxLength": 512},
        "max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}
      }
    },
    "command_route": {
      "type": "object",
      "required": ["route_id", "resource_prefix", "path_segment_count", "arguments", "resource", "failure_rules", "freshness"],
      "additionalProperties": false,
      "properties": {
        "route_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 64},
        "resource_prefix": {"type": "string", "minLength": 5, "maxLength": 512},
        "path_segment_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "arguments": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/command_argument"}},
        "resource": {"$ref": "#/$defs/command_resource"},
        "failure_rules": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/command_failure_rule"}},
        "freshness": {"anyOf": [{"$ref": "#/$defs/command_freshness"}, {"type": "null"}]}
      }
    },
    "command_guidance": {
      "type": "object",
      "required": ["missing", "message", "user_actions"],
      "additionalProperties": false,
      "properties": {
        "missing": {"type": "string", "minLength": 1, "maxLength": 256},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "user_actions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "command_guidance_set": {
      "type": "object",
      "required": ["source_unavailable", "resource_unavailable", "content_stale"],
      "additionalProperties": false,
      "properties": {
        "source_unavailable": {"$ref": "#/$defs/command_guidance"},
        "resource_unavailable": {"$ref": "#/$defs/command_guidance"},
        "content_stale": {"$ref": "#/$defs/command_guidance"}
      }
    }
  }
}
