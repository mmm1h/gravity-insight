{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.context-requirement.v1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "requirement_id", "provider_uri", "skill_uri", "journey_id", "subject_entities", "required_windows", "authority_policy", "allowed_sensitivity", "freshness_policy", "budget", "items"],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "context_requirement"},
    "schema_version": {"const": "gravity.context-requirement.v1"},
    "requirement_id": {"type": "string", "pattern": "^context://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$", "maxLength": 256},
    "provider_uri": {"type": "string", "pattern": "^context-provider://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"},
    "skill_uri": {"type": "string", "minLength": 8, "maxLength": 256},
    "journey_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "subject_entities": {"$ref": "#/$defs/string_array"},
    "required_windows": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "authority_policy": {
      "type": "object",
      "required": ["required", "allow_supporting", "allow_unverified"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["canonical", "supporting"]}},
        "allow_supporting": {"type": "boolean"},
        "allow_unverified": {"type": "boolean"}
      }
    },
    "allowed_sensitivity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}},
    "freshness_policy": {"type": "object", "required": ["as_of", "max_age_days"], "additionalProperties": false, "properties": {"as_of": {"type": ["string", "null"], "maxLength": 10}, "max_age_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 36500}}},
    "budget": {
      "type": "object",
      "required": ["max_files", "max_file_bytes", "max_total_bytes", "max_total_lines"],
      "additionalProperties": false,
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_total_lines": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "items": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "string_array": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "date": {"type": ["string", "null"], "maxLength": 10},
    "date_range": {"type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": {"start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}}},
    "time_range": {"type": "object", "required": ["start", "end", "timezone"], "additionalProperties": false, "properties": {"start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}, "timezone": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "item": {
      "type": "object",
      "required": ["item_id", "fact_id", "required", "path", "title", "resource_type", "entity_refs", "valid_time", "effective_range", "authority", "sensitivity", "supersedes", "max_age_days"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
        "fact_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 128},
        "required": {"type": "boolean"},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "resource_type": {"enum": ["document", "code", "configuration", "contract", "release", "project_semantic"]},
        "entity_refs": {"$ref": "#/$defs/string_array"},
        "valid_time": {"$ref": "#/$defs/time_range"},
        "effective_range": {"$ref": "#/$defs/date_range"},
        "authority": {"enum": ["canonical", "supporting", "unverified"]},
        "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
        "supersedes": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 2048}},
        "max_age_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 36500}
      }
    }
  }
}
