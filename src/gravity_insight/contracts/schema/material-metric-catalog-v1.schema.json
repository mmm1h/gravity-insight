{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravity.local/schemas/material-metric-catalog-v1.schema.json",
  "title": "Gravity Material Metric Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "source",
    "platforms",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "gravity.material-metric-catalog.v1"},
    "catalog_id": {"const": "gravity.material-metrics"},
    "catalog_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "platforms": {
      "type": "array",
      "prefixItems": [
        {"const": "aggregate"},
        {"const": "bytedance"},
        {"const": "tencent"},
        {"const": "kuaishou"},
        {"const": "gravity"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "name", "cname", "tip"],
        "properties": {
          "platform": {
            "enum": ["aggregate", "bytedance", "tencent", "kuaishou", "gravity"]
          },
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "cname": {"type": "string", "minLength": 1, "maxLength": 256},
          "tip": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
