{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.operator-input.governed-method.v2",
  "type": "object",
  "required": [
    "schema_version",
    "method",
    "rows",
    "parameters",
    "unit",
    "additivity",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gravity.operator-input.governed-method.v2"
    },
    "method": {
      "enum": [
        "campaign-outcome-evaluation",
        "funnel-diagnosis",
        "metric-decomposition",
        "scenario-projection",
        "sentiment-aggregation"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "additivity": {
      "enum": [
        "additive",
        "semi_additive",
        "non_additive"
      ]
    },
    "mode": {
      "enum": [
        "rowwise",
        "aggregate",
        "cumulative"
      ],
      "description": "Explicit: cumulative only for funnel-diagnosis; aggregate only for the other four methods."
    },
    "aggregation": {
      "type": "object",
      "required": [
        "axis",
        "allowed_axes",
        "disjointness"
      ],
      "additionalProperties": false,
      "properties": {
        "axis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "allowed_axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "disjointness": {
          "type": "object",
          "required": [
            "kind",
            "members",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "disjoint_partition"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^\\S(?:.*\\S)?$"
              }
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      },
      "description": "Required only in aggregate mode. Evidence attests all row keys partition the population on axis for every value scope. allowed_axes comes from the bound metric contract, not the numeric values."
    },
    "topology": {
      "enum": [
        "linear",
        "independent"
      ]
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "key",
        "values",
        "evidence",
        "scopes"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scope"
          },
          "description": "Exact roles: current/reference for campaign and decomposition; baseline/projected for scenario; entered/reached for funnel; count for sentiment."
        },
        "lineage": {
          "type": "object",
          "required": [
            "predecessor",
            "relation",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "predecessor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^\\S(?:.*\\S)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "relation": {
              "enum": [
                "root",
                "equal",
                "subset"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "step_id",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "^/.+$",
          "maxLength": 2048
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "unit",
        "population",
        "window",
        "completeness",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "population": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "window": {
          "type": "object",
          "required": [
            "start",
            "end",
            "timezone",
            "grain"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "grain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        },
        "completeness": {
          "enum": [
            "complete",
            "prefix",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "description": "Population identifies the common parent scope; partition members identify rows. Window dates are inclusive. Evidence must bind the facts, units, population and window; Runtime checks consistency offline, not source truth."
    }
  }
}
