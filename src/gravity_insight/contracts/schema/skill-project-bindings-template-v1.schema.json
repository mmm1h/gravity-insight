{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.skill-project-bindings-template.v1",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "skill_uri",
    "project_placeholders",
    "semantic_dependencies",
    "semantic_source_template",
    "context_dependencies",
    "overlay_template",
    "remedies"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "skill_project_bindings_template"},
    "schema_version": {"const": "gravity.skill-project-bindings-template.v1"},
    "skill_uri": {"type": "string", "pattern": "^skill://.+$", "maxLength": 256},
    "project_placeholders": {"$ref": "#/$defs/project_placeholders"},
    "semantic_dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/semantic"}
    },
    "semantic_source_template": {"$ref": "#/$defs/semantic_source"},
    "context_dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/context"}
    },
    "overlay_template": {"$ref": "#/$defs/overlay"},
    "remedies": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/remedy"}
    }
  },
  "$defs": {
    "template_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "string_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/template_string"}
    },
    "project_placeholders": {
      "type": "object",
      "required": [
        "project_id",
        "owner",
        "app_alias",
        "journey_id",
        "semantic_source_path"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {"$ref": "#/$defs/template_string"},
        "owner": {"$ref": "#/$defs/template_string"},
        "app_alias": {"$ref": "#/$defs/template_string"},
        "journey_id": {"$ref": "#/$defs/template_string"},
        "semantic_source_path": {"$ref": "#/$defs/template_string"}
      }
    },
    "semantic": {
      "type": "object",
      "required": [
        "uri",
        "required_fields",
        "definition_template",
        "binding_template"
      ],
      "additionalProperties": false,
      "properties": {
        "uri": {"$ref": "#/$defs/semantic_uri"},
        "required_fields": {"$ref": "#/$defs/string_array"},
        "definition_template": {"$ref": "#/$defs/semantic_definition"},
        "binding_template": {"$ref": "#/$defs/semantic_binding"}
      }
    },
    "semantic_uri": {
      "type": "string",
      "pattern": "^(metric|dimension|entity|cohort|event|sku|activity|release|schema)://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$",
      "maxLength": 256
    },
    "semantic_definition": {
      "type": "object",
      "required": [
        "artifact_kind",
        "schema_version",
        "uri",
        "kind",
        "version",
        "owner",
        "authority",
        "display_name",
        "description",
        "effective_range",
        "unit",
        "aggregation",
        "time",
        "entity_uri",
        "formula",
        "binding_required",
        "claim_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {"const": "semantic_definition"},
        "schema_version": {"const": "gravity.semantic-definition.v1"},
        "uri": {"$ref": "#/$defs/semantic_uri"},
        "kind": {
          "enum": [
            "metric",
            "dimension",
            "entity",
            "cohort",
            "event",
            "sku",
            "activity",
            "release",
            "schema"
          ]
        },
        "version": {"type": "integer", "minimum": 1},
        "owner": {"$ref": "#/$defs/template_string"},
        "authority": {"const": "project"},
        "display_name": {"$ref": "#/$defs/template_string"},
        "description": {"$ref": "#/$defs/template_string"},
        "effective_range": {"$ref": "#/$defs/date_range_template"},
        "unit": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/unit_template"}
          ]
        },
        "aggregation": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/aggregation_template"}
          ]
        },
        "time": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/time_template"}
          ]
        },
        "entity_uri": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/template_string"}
          ]
        },
        "formula": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/formula_template"}
          ]
        },
        "binding_required": {"const": true},
        "claim_policy": {
          "type": "object",
          "required": ["allowed", "forbidden"],
          "additionalProperties": false,
          "properties": {
            "allowed": {"$ref": "#/$defs/string_array"},
            "forbidden": {"$ref": "#/$defs/string_array"}
          }
        }
      }
    },
    "date_range_template": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/template_string"}
          ]
        },
        "end": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/template_string"}
          ]
        }
      }
    },
    "unit_template": {
      "type": "object",
      "required": ["kind", "symbol", "currency", "scale"],
      "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "#/$defs/template_string"},
        "symbol": {"$ref": "#/$defs/template_string"},
        "currency": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/template_string"}
          ]
        },
        "scale": {
          "anyOf": [
            {"type": "integer"},
            {"$ref": "#/$defs/template_string"}
          ]
        }
      }
    },
    "aggregation_template": {
      "type": "object",
      "required": ["method", "additivity"],
      "additionalProperties": false,
      "properties": {
        "method": {"$ref": "#/$defs/template_string"},
        "additivity": {"$ref": "#/$defs/template_string"}
      }
    },
    "time_template": {
      "type": "object",
      "required": ["grains", "timezone", "attribution_window"],
      "additionalProperties": false,
      "properties": {
        "grains": {"$ref": "#/$defs/string_array"},
        "timezone": {"$ref": "#/$defs/template_string"},
        "attribution_window": {
          "anyOf": [
            {"type": "null"},
            {"type": "object"}
          ]
        }
      }
    },
    "formula_template": {
      "type": "object",
      "required": ["operator", "dependencies", "parameters"],
      "additionalProperties": false,
      "properties": {
        "operator": {"$ref": "#/$defs/template_string"},
        "dependencies": {"type": "array", "maxItems": 64},
        "parameters": {"type": "array", "maxItems": 32}
      }
    },
    "semantic_binding": {
      "type": "object",
      "required": [
        "artifact_kind",
        "schema_version",
        "binding_uri",
        "semantic_uri",
        "project_id",
        "owner",
        "app_alias",
        "effective_range",
        "provider",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {"const": "semantic_binding"},
        "schema_version": {"const": "gravity.semantic-binding.v1"},
        "binding_uri": {"$ref": "#/$defs/template_string"},
        "semantic_uri": {"$ref": "#/$defs/semantic_uri"},
        "project_id": {"$ref": "#/$defs/template_string"},
        "owner": {"$ref": "#/$defs/template_string"},
        "app_alias": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/template_string"}
          ]
        },
        "effective_range": {"$ref": "#/$defs/date_range_template"},
        "provider": {"$ref": "#/$defs/provider_template"},
        "parameters": {"type": "object"}
      }
    },
    "provider_template": {
      "type": "object",
      "required": ["kind", "definition", "members"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "semantic_compose"},
        "definition": {"$ref": "#/$defs/reference_template"},
        "members": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "metric": {"$ref": "#/$defs/optional_reference_template"},
            "dimension": {"$ref": "#/$defs/optional_reference_template"},
            "filter": {"$ref": "#/$defs/optional_reference_template"},
            "grain": {"$ref": "#/$defs/optional_reference_template"},
            "join": {"$ref": "#/$defs/optional_reference_template"}
          }
        }
      }
    },
    "optional_reference_template": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/reference_template"}
      ]
    },
    "reference_template": {
      "type": "object",
      "required": ["definition_id", "version"],
      "additionalProperties": false,
      "properties": {
        "definition_id": {"$ref": "#/$defs/template_string"},
        "version": {
          "anyOf": [
            {"type": "integer"},
            {"$ref": "#/$defs/template_string"}
          ]
        }
      }
    },
    "semantic_source": {
      "type": "object",
      "required": [
        "artifact_kind",
        "schema_version",
        "source_id",
        "source_kind",
        "project_id",
        "owner",
        "definitions",
        "bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {"const": "semantic_source"},
        "schema_version": {"const": "gravity.semantic-source.v1"},
        "source_id": {"$ref": "#/$defs/template_string"},
        "source_kind": {"const": "project_json"},
        "project_id": {"$ref": "#/$defs/template_string"},
        "owner": {"$ref": "#/$defs/template_string"},
        "definitions": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/semantic_definition"}
        },
        "bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/semantic_binding"}
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["uri", "required", "required_fields", "requirement_template"],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^context://.+@[1-9][0-9]*$",
          "maxLength": 256
        },
        "required": {"type": "boolean"},
        "required_fields": {"$ref": "#/$defs/string_array"},
        "requirement_template": {"$ref": "#/$defs/context_requirement"}
      }
    },
    "context_requirement": {
      "type": "object",
      "required": [
        "artifact_kind",
        "schema_version",
        "requirement_id",
        "provider_uri",
        "skill_uri",
        "journey_id",
        "subject_entities",
        "required_windows",
        "authority_policy",
        "allowed_sensitivity",
        "freshness_policy",
        "budget",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {"const": "context_requirement"},
        "schema_version": {"const": "gravity.context-requirement.v1"},
        "requirement_id": {
          "type": "string",
          "pattern": "^context://.+@[1-9][0-9]*$",
          "maxLength": 256
        },
        "provider_uri": {"const": "context-provider://gravity/project-repo@1"},
        "skill_uri": {"type": "string", "pattern": "^skill://.+$", "maxLength": 256},
        "journey_id": {"$ref": "#/$defs/template_string"},
        "subject_entities": {"$ref": "#/$defs/string_array"},
        "required_windows": {"$ref": "#/$defs/string_array"},
        "authority_policy": {"$ref": "#/$defs/authority_policy_template"},
        "allowed_sensitivity": {"$ref": "#/$defs/string_array"},
        "freshness_policy": {"$ref": "#/$defs/freshness_template"},
        "budget": {"$ref": "#/$defs/budget_template"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/context_item_template"}
        }
      }
    },
    "authority_policy_template": {
      "type": "object",
      "required": [
        "required",
        "allow_supporting",
        "allow_declared_intent",
        "allow_unverified"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {"$ref": "#/$defs/string_array"},
        "allow_supporting": {"type": "boolean"},
        "allow_declared_intent": {"type": "boolean"},
        "allow_unverified": {"type": "boolean"}
      }
    },
    "freshness_template": {
      "type": "object",
      "required": ["as_of", "max_age_days"],
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/template_string"}
          ]
        },
        "max_age_days": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer"},
            {"$ref": "#/$defs/template_string"}
          ]
        }
      }
    },
    "budget_template": {
      "type": "object",
      "required": [
        "max_files",
        "max_file_bytes",
        "max_total_bytes",
        "max_total_lines"
      ],
      "additionalProperties": false,
      "properties": {
        "max_files": {"$ref": "#/$defs/integer_template"},
        "max_file_bytes": {"$ref": "#/$defs/integer_template"},
        "max_total_bytes": {"$ref": "#/$defs/integer_template"},
        "max_total_lines": {"$ref": "#/$defs/integer_template"}
      }
    },
    "integer_template": {
      "anyOf": [
        {"type": "integer"},
        {"$ref": "#/$defs/template_string"}
      ]
    },
    "context_item_template": {
      "type": "object",
      "required": [
        "item_id",
        "fact_id",
        "required",
        "path",
        "title",
        "resource_type",
        "entity_refs",
        "valid_time",
        "effective_range",
        "authority",
        "sensitivity",
        "supersedes",
        "max_age_days"
      ],
      "additionalProperties": false,
      "properties": {
        "item_id": {"$ref": "#/$defs/template_string"},
        "fact_id": {"$ref": "#/$defs/template_string"},
        "required": {"type": "boolean"},
        "path": {"$ref": "#/$defs/template_string"},
        "title": {"$ref": "#/$defs/template_string"},
        "resource_type": {"$ref": "#/$defs/template_string"},
        "entity_refs": {"$ref": "#/$defs/string_array"},
        "valid_time": {
          "type": "object",
          "required": ["start", "end", "timezone"],
          "additionalProperties": false,
          "properties": {
            "start": {
              "anyOf": [
                {"type": "null"},
                {"$ref": "#/$defs/template_string"}
              ]
            },
            "end": {
              "anyOf": [
                {"type": "null"},
                {"$ref": "#/$defs/template_string"}
              ]
            },
            "timezone": {"$ref": "#/$defs/template_string"}
          }
        },
        "effective_range": {"$ref": "#/$defs/date_range_template"},
        "authority": {"$ref": "#/$defs/template_string"},
        "sensitivity": {"$ref": "#/$defs/template_string"},
        "supersedes": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/template_string"}
        },
        "max_age_days": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer"},
            {"$ref": "#/$defs/template_string"}
          ]
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": [
        "artifact_kind",
        "schema_version",
        "overlay_uri",
        "version",
        "project_id",
        "owner",
        "extends",
        "journey_id",
        "semantic_sources",
        "semantic_scope",
        "context_requirements",
        "default_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {"const": "project_skill_overlay"},
        "schema_version": {"const": "gravity.project-skill-overlay.v1"},
        "overlay_uri": {"$ref": "#/$defs/template_string"},
        "version": {"$ref": "#/$defs/template_string"},
        "project_id": {"$ref": "#/$defs/template_string"},
        "owner": {"$ref": "#/$defs/template_string"},
        "extends": {
          "type": "object",
          "required": ["skill_uri"],
          "additionalProperties": false,
          "properties": {
            "skill_uri": {
              "type": "string",
              "pattern": "^skill://.+$",
              "maxLength": 256
            }
          }
        },
        "journey_id": {"$ref": "#/$defs/template_string"},
        "semantic_sources": {"$ref": "#/$defs/string_array"},
        "semantic_scope": {"$ref": "#/$defs/scope_template"},
        "context_requirements": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/context_requirement"}
        },
        "default_scope": {"$ref": "#/$defs/scope_template"}
      }
    },
    "scope_template": {
      "type": "object",
      "required": ["app_alias"],
      "additionalProperties": false,
      "properties": {
        "app_alias": {"$ref": "#/$defs/template_string"}
      }
    },
    "remedy": {
      "type": "object",
      "required": ["dependency_uri", "reason_code", "next_action"],
      "additionalProperties": false,
      "properties": {
        "dependency_uri": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "next_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
