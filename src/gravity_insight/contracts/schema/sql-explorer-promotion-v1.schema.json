{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.sql-explorer-promotion.v1",
  "type": "object",
  "required": [
    "schema_version", "status", "source", "review", "product",
    "consumer_contract", "installation", "trust", "network_called",
    "promotion_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.sql-explorer-promotion.v1"},
    "status": {"const": "installed"},
    "source": {"type": "object"},
    "review": {
      "type": "object",
      "required": ["decision", "evidence_sha256"],
      "additionalProperties": false,
      "properties": {
        "decision": {"const": "approved"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "product": {
      "type": "object",
      "required": ["name", "contract_version", "definition", "definition_sha256"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "contract_version": {"type": "string", "pattern": "^[1-9][0-9]{0,8}$"},
        "definition": {"type": "object"},
        "definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "consumer_contract": {"type": "object"},
    "installation": {"type": "object"},
    "trust": {"type": "object"},
    "network_called": {"const": false},
    "promotion_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
