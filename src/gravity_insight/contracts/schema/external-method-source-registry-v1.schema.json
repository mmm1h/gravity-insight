{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.external-method-source-registry.v1",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "registry_id",
    "agent_default_visible",
    "catalog_language",
    "source_owner",
    "legal_purpose",
    "observed_at",
    "source_version",
    "item_count",
    "items",
    "registry_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "external_method_source_registry"},
    "schema_version": {"const": "gravity.external-method-source-registry.v1"},
    "registry_id": {"const": "source-registry://gravity/external-methods@1"},
    "agent_default_visible": {"const": false},
    "catalog_language": {"const": "zh-CN"},
    "source_owner": {
      "type": "object",
      "required": ["legal_name", "public_product_name", "catalog_root_url"],
      "additionalProperties": false,
      "properties": {
        "legal_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "public_product_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "catalog_root_url": {"type": "string", "pattern": "^https://.+$", "maxLength": 2048}
      }
    },
    "legal_purpose": {"type": "string", "minLength": 1, "maxLength": 512},
    "observed_at": {"type": "string", "minLength": 20, "maxLength": 64},
    "source_version": {"$ref": "#/$defs/digest"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/item"}
    },
    "registry_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "item": {
      "type": "object",
      "required": [
        "opaque_id",
        "source_locator",
        "source_url",
        "source_title",
        "source_categories",
        "content_sha256",
        "mapping_kind",
        "future_skill_uri",
        "reason_code",
        "license_review",
        "independent_authorship",
        "authorship_evidence",
        "source_distribution_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "opaque_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "source_locator": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_url": {"type": "string", "pattern": "^https://.+$", "maxLength": 2048},
        "source_title": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_categories": {"$ref": "#/$defs/string_array"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "mapping_kind": {"enum": ["future_skill", "out_of_scope_alternative"]},
        "future_skill_uri": {
          "type": ["string", "null"],
          "pattern": "^skill://[a-z][a-z0-9.-]*/[a-z0-9-]+@[0-9A-Za-z.-]+$",
          "maxLength": 256
        },
        "reason_code": {"type": ["string", "null"], "maxLength": 128},
        "license_review": {"enum": ["approved", "blocked"]},
        "independent_authorship": {"enum": ["required", "not_applicable"]},
        "authorship_evidence": {"enum": ["independent_rewrite_reviewed", "not_applicable"]},
        "source_distribution_allowed": {"const": false}
      }
    }
  }
}
