{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.prepared-analysis-plan-summary.v1",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "status",
    "pap_id",
    "source_kind",
    "plan_schema_version",
    "node_count",
    "max_workers",
    "created_at",
    "expires_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.prepared-analysis-plan-summary.v1"},
    "ok": {"const": true},
    "status": {"const": "prepared"},
    "pap_id": {"type": "string", "pattern": "^pap1_[0-9a-f]{32}_[0-9a-f]{32}$"},
    "source_kind": {"const": "host_plan"},
    "plan_schema_version": {"const": "gravity.plan.v1"},
    "node_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "max_workers": {"type": "integer", "minimum": 1, "maximum": 24},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
