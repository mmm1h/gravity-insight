{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.thinkingai-inventory-diff.v1",
  "type": "object",
  "required": [
    "artifact_kind", "schema_version", "source_adapter", "previous_snapshot",
    "current_snapshot", "counts", "changes", "network_called", "diff_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "thinkingai_inventory_diff"},
    "schema_version": {"const": "gravity.thinkingai-inventory-diff.v1"},
    "source_adapter": {"$ref": "#/$defs/source_adapter"},
    "previous_snapshot": {"$ref": "#/$defs/nullable_snapshot_reference"},
    "current_snapshot": {"$ref": "#/$defs/snapshot_reference"},
    "counts": {
      "type": "object",
      "required": ["added", "changed", "removed", "redirect", "unchanged", "total"],
      "additionalProperties": false,
      "properties": {
        "added": {"type": "integer", "minimum": 0, "maximum": 2000},
        "changed": {"type": "integer", "minimum": 0, "maximum": 2000},
        "removed": {"type": "integer", "minimum": 0, "maximum": 2000},
        "redirect": {"type": "integer", "minimum": 0, "maximum": 2000},
        "unchanged": {"type": "integer", "minimum": 0, "maximum": 2000},
        "total": {"type": "integer", "minimum": 0, "maximum": 2000}
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/change"}
    },
    "network_called": {"const": false},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "source_adapter": {
      "type": "object",
      "required": ["adapter_id", "version"],
      "additionalProperties": false,
      "properties": {
        "adapter_id": {"const": "thinkingai-public-catalog-dom"},
        "version": {"const": 1}
      }
    },
    "snapshot_reference": {
      "type": "object",
      "required": ["observed_at", "snapshot_sha256"],
      "additionalProperties": false,
      "properties": {
        "observed_at": {"type": "string", "minLength": 20, "maxLength": 32},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nullable_snapshot_reference": {
      "type": "object",
      "required": ["observed_at", "snapshot_sha256"],
      "additionalProperties": false,
      "properties": {
        "observed_at": {"type": ["string", "null"], "minLength": 20, "maxLength": 32},
        "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nullable_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "nullable_url": {
      "type": ["string", "null"],
      "maxLength": 256,
      "pattern": "^https://www\\.thinkingai\\.cn/skills/[a-z0-9]+(?:-[a-z0-9]+)*/$"
    },
    "changed_field": {
      "enum": [
        "source_url", "source_title", "source_categories", "gravity_taxonomy_ids",
        "source_content_sha256", "specification_state", "mapping_kind",
        "future_skill_uri", "alternative_reason_code", "license_review",
        "independent_authorship", "distribution_allowed"
      ]
    },
    "change": {
      "type": "object",
      "required": [
        "source_id", "state", "changed_fields", "previous_item_sha256",
        "current_item_sha256", "previous_url", "current_url"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "state": {"enum": ["added", "changed", "removed", "redirect", "unchanged"]},
        "changed_fields": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/changed_field"}
        },
        "previous_item_sha256": {"$ref": "#/$defs/nullable_digest"},
        "current_item_sha256": {"$ref": "#/$defs/nullable_digest"},
        "previous_url": {"$ref": "#/$defs/nullable_url"},
        "current_url": {"$ref": "#/$defs/nullable_url"}
      }
    }
  }
}
