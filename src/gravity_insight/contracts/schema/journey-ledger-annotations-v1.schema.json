{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.journey-ledger-annotations.v1",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_commit",
    "purpose",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gravity.journey-ledger-annotations.v1"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "notes": {
      "type": "object",
      "minProperties": 1,

      "additionalProperties": {
        "type": "string",
        "maxLength": 65536
      }
    }
  }
}
