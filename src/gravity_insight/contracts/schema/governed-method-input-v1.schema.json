{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.operator-input.governed-method.v1",
  "type": "object",
  "required": [
    "schema_version",
    "method",
    "rows",
    "parameters",
    "unit",
    "additivity"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gravity.operator-input.governed-method.v1"
    },
    "method": {
      "enum": [
        "campaign-outcome-evaluation",
        "churn-segment-profile",
        "funnel-diagnosis",
        "ltv-payback-period",
        "metric-decomposition",
        "price-elasticity",
        "retention-curve",
        "scenario-projection",
        "sentiment-aggregation"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "additivity": {
      "enum": [
        "additive",
        "semi_additive",
        "non_additive"
      ]
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "key",
        "values",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "step_id",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "^/.+$",
          "maxLength": 2048
        }
      }
    }
  }
}
