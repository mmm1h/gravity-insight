{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.account-admission.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_ref", "principal", "permission_scope", "data_scope", "validated_at", "expires_at", "evidence_references", "capabilities"],
  "properties": {
    "schema_version": {"const": "gravity.account-admission.v1"},
    "generation_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "principal": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permission_scope": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_scope": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validated_at": {"type": "string", "maxLength": 32},
    "expires_at": {"type": "string", "maxLength": 32},
    "evidence_references": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"}},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["identity_kind", "selector"],
        "properties": {"identity_kind": {"enum": ["operation", "product", "composite"]},
          "selector": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"}}}}
  }
}
