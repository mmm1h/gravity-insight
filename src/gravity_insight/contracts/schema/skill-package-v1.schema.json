{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.skill-package.v1",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "skill_uri",
    "namespace",
    "skill_id",
    "version",
    "manifest_digest",
    "package_digest",
    "resource_root",
    "files",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "skill_package"},
    "schema_version": {"const": "gravity.skill-package.v1"},
    "skill_uri": {"type": "string", "minLength": 1, "maxLength": 256},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
    "skill_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource_root": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._/-]+$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "role", "media_type", "size_bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._/-]+$"},
          "role": {"enum": ["manifest", "guide", "provenance", "schema", "claims", "examples", "asset"]},
          "media_type": {"enum": ["application/json", "text/markdown"]},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "provenance": {"type": "object"}
  }
}
