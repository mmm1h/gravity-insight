{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.execution-variant.v1",
  "type": "object",
  "required": [
    "schema_version", "variant_uri", "product", "implementation",
    "semantics", "trust_requirement", "rollback", "automatic_selection",
    "network_called", "descriptor_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.execution-variant.v1"},
    "variant_uri": {
      "type": "string",
      "pattern": "^gravity\\.execution-variant/[a-z0-9-]+/[a-z0-9-]+@[1-9][0-9]*$"
    },
    "product": {"$ref": "#/$defs/product"},
    "implementation": {
      "type": "object",
      "required": ["topology", "owner", "entrypoint", "fixed"],
      "additionalProperties": false,
      "properties": {
        "topology": {"enum": ["direct_product", "plan_adapter"]},
        "owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "entrypoint": {
          "type": "string", "minLength": 1, "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.]+$"
        },
        "fixed": {"const": true}
      }
    },
    "semantics": {
      "type": "object",
      "required": [
        "input_schema_version", "output_schema_version", "result_projection",
        "completeness_source", "data_quality_source", "allowed_claims",
        "privacy_classification", "freshness", "request_count", "journey_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "input_schema_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "output_schema_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "result_projection": {"type": "string", "minLength": 1, "maxLength": 128},
        "completeness_source": {"const": "product_capability_and_result"},
        "data_quality_source": {"const": "product_capability_and_result"},
        "allowed_claims": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "privacy_classification": {"type": "string", "minLength": 1, "maxLength": 64},
        "freshness": {"const": "same_upstream_response"},
        "request_count": {"const": "same_compiled_operation_and_pagination"},
        "journey_ids": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "trust_requirement": {
      "type": "object",
      "required": ["identity_kind", "selector", "minimum_trust"],
      "additionalProperties": false,
      "properties": {
        "identity_kind": {"const": "product"},
        "selector": {"type": "string", "minLength": 1, "maxLength": 160},
        "minimum_trust": {"const": "stable"}
      }
    },
    "rollback": {"$ref": "#/$defs/rollback"},
    "automatic_selection": {"const": false},
    "network_called": {"const": false},
    "descriptor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": ["identity_kind", "selector", "contract_version", "contract_digest"],
      "additionalProperties": false,
      "properties": {
        "identity_kind": {"const": "product"},
        "selector": {"type": "string", "minLength": 1, "maxLength": 160},
        "contract_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "rollback": {
      "type": "object",
      "required": ["canonical_variant_uri", "strategy", "capability_preserved"],
      "additionalProperties": false,
      "properties": {
        "canonical_variant_uri": {
          "const": "gravity.execution-variant/analysis-query-event/direct@1"
        },
        "strategy": {"const": "pin_canonical_direct"},
        "capability_preserved": {"const": true}
      }
    }
  }
}
