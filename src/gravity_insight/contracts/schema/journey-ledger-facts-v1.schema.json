{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.journey-ledger-facts.v1",
  "type": "object",
  "required": [
    "schema_version",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gravity.journey-ledger-facts.v1"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "display_name",
          "ledger_status",
          "surfaces",
          "request_budget"
        ],
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n]+$"
          },
          "ledger_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n]+$"
          },
          "surfaces": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n]+$"
          },
          "request_budget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  }
}
