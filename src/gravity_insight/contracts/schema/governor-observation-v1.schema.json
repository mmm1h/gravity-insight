{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.governor-observation.v1",
  "type": "object",
  "required": [
    "schema_version", "sequence", "host_key", "operation_class", "profile",
    "method", "outcome", "status_class", "http_status", "request_count",
    "latency_ms", "latency_capped", "rate_limit_delay_ms",
    "rate_limit_delay_capped", "attempt", "attempt_budget", "retry_attempt",
    "budgets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.governor-observation.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "host_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation_class": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "profile": {"enum": ["insight", "sql", "login", "artifact", "probe", "census", "runtime_http"]},
    "method": {"enum": ["GET", "POST"]},
    "outcome": {"enum": ["response", "transport_error"]},
    "status_class": {"enum": ["success", "redirect", "client_error", "rate_limited", "server_error", "transport_error", "unknown"]},
    "http_status": {"type": ["integer", "null"], "minimum": 0, "maximum": 999},
    "request_count": {"const": 1},
    "latency_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
    "latency_capped": {"type": "boolean"},
    "rate_limit_delay_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
    "rate_limit_delay_capped": {"type": "boolean"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 5},
    "attempt_budget": {"type": "integer", "minimum": 1, "maximum": 5},
    "retry_attempt": {"type": "boolean"},
    "budgets": {
      "type": "object",
      "required": ["business_limit", "sql_limit", "timeout_ms"],
      "additionalProperties": false,
      "properties": {
        "business_limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 64},
        "sql_limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 16},
        "timeout_ms": {"type": ["integer", "null"], "minimum": 1, "maximum": 3600000}
      }
    }
  }
}
