{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.sql-explorer-promotion-request.v1",
  "type": "object",
  "required": ["schema_version", "source", "approval"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "gravity.sql-explorer-promotion-request.v1"},
    "source": {"type": "object"},
    "approval": {
      "type": "object",
      "required": [
        "decision", "review_evidence_sha256", "product_name",
        "contract_version", "registered_product"
      ],
      "additionalProperties": false,
      "properties": {
        "decision": {"const": "approved"},
        "review_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "product_name": {
          "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "contract_version": {
          "type": "string", "pattern": "^[1-9][0-9]{0,8}$"
        },
        "registered_product": {"$ref": "#/$defs/product"}
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": [
        "kind", "datasource", "apps", "forbidden_claims", "sql",
        "output_fields", "output_semantics", "privacy", "max_rows"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "custom-sql"},
        "datasource": {"type": "string", "minLength": 1, "maxLength": 160},
        "apps": {
          "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": {
            "anyOf": [
              {"type": "integer", "minimum": 1},
              {"type": "string", "minLength": 1, "maxLength": 160}
            ]
          }
        },
        "forbidden_claims": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "sql": {"type": "string", "minLength": 1, "maxLength": 65536},
        "output_fields": {
          "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
        },
        "output_semantics": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "privacy": {"const": "aggregate"},
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    }
  }
}
