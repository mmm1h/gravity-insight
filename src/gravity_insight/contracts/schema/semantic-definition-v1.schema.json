{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gravity.semantic-definition.v1",
  "type": "object",
  "required": [
    "artifact_kind", "schema_version", "uri", "kind", "version", "owner",
    "authority", "display_name", "description", "effective_range", "unit",
    "aggregation", "time", "entity_uri", "formula", "binding_required",
    "claim_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "semantic_definition"},
    "schema_version": {"const": "gravity.semantic-definition.v1"},
    "uri": {"type": "string", "minLength": 8, "maxLength": 256, "pattern": "^[a-z]+://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"},
    "kind": {"enum": ["metric", "dimension", "entity", "cohort", "event", "sku", "activity", "release", "schema"]},
    "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "owner": {"type": "string", "minLength": 1, "maxLength": 128},
    "authority": {"enum": ["runtime", "organization", "project"]},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "effective_range": {"$ref": "#/$defs/effective_range"},
    "unit": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/unit"}]},
    "aggregation": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/aggregation"}]},
    "time": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
    "entity_uri": {
      "type": ["string", "null"],
      "maxLength": 256,
      "pattern": "^entity://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"
    },
    "formula": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/formula"}]},
    "binding_required": {"type": "boolean"},
    "claim_policy": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"$ref": "#/$defs/string_array"},
        "forbidden": {"$ref": "#/$defs/string_array"}
      }
    }
  },
  "$defs": {
    "effective_range": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": ["string", "null"], "maxLength": 10},
        "end": {"type": ["string", "null"], "maxLength": 10}
      }
    },
    "unit": {
      "type": "object",
      "required": ["kind", "symbol", "currency", "scale"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["count", "currency", "ratio", "duration", "identifier", "categorical", "timestamp", "custom"]},
        "symbol": {"type": "string", "minLength": 1, "maxLength": 64},
        "currency": {"type": ["string", "null"], "maxLength": 8},
        "scale": {"type": "integer", "minimum": 0, "maximum": 12}
      }
    },
    "aggregation": {
      "type": "object",
      "required": ["method", "additivity"],
      "additionalProperties": false,
      "properties": {
        "method": {"enum": ["sum", "count", "average", "distinct", "minimum", "maximum", "ratio", "none"]},
        "additivity": {"enum": ["additive", "non_additive", "semi_additive", "unknown"]}
      }
    },
    "time": {
      "type": "object",
      "required": ["grains", "timezone", "attribution_window"],
      "additionalProperties": false,
      "properties": {
        "grains": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["total", "hour", "day", "week", "month", "cohort"]}},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
        "attribution_window": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["unit", "value"],
              "additionalProperties": false,
              "properties": {
                "unit": {"enum": ["hour", "day"]},
                "value": {"type": "integer", "minimum": 1, "maximum": 3650}
              }
            }
          ]
        }
      }
    },
    "formula": {
      "type": "object",
      "required": ["operator", "dependencies", "parameters"],
      "additionalProperties": false,
      "properties": {
        "operator": {"enum": ["source", "sum", "difference", "ratio"]},
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "^metric://[a-z0-9.-]+/[a-z0-9./-]+@[1-9][0-9]*$"
          }
        },
        "parameters": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "string_array": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
