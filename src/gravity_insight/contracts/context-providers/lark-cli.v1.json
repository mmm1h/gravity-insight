            "arguments": [
              {"literal": "base"},
              {"literal": "+record-list"},
              {"literal": "--base-token"},
              {"uri_path_segment": 0},
              {"literal": "--table-id"},
              {"uri_path_segment": 1},
              {"literal": "--limit"},
              {"literal": "200"},
              {"literal": "--offset"},
              {"literal": "0"},
              {"literal": "--format"},
              {"literal": "json"},
              {"literal": "--as"},
              {"literal": "user"}
            ],
            "resource": {
              "item_id": "schedule-records-page-0",
              "fact_id": "fact.schedule-records-page-0",
              "title": "Schedule Base records page 0",
              "resource_type": "document",
              "entity_refs": ["entity://gravity/project@1"],
              "valid_time": {"start": null, "end": null, "timezone": "Asia/Shanghai"},
              "effective_range": {"start": null, "end": null},
              "sensitivity": "internal",
              "citation_path": "lark-cli/base/record-list"
            },
            "failure_rules": [],
            "freshness": null
          },
          {
            "route_id": "tracking-document",
            "resource_prefix": "lark-cli://docs/documents/",
            "path_segment_count": 1,
            "arguments": [
              {"literal": "docs"},
              {"literal": "+fetch"},
              {"literal": "--doc"},
              {"uri_path_segment": 0},
              {"literal": "--detail"},
              {"literal": "simple"},
              {"literal": "--doc-format"},
              {"literal": "xml"},
              {"literal": "--format"},
              {"literal": "json"},
              {"literal": "--as"},
              {"literal": "user"}
            ],
            "resource": {
              "item_id": "tracking-document",
              "fact_id": "fact.tracking-document",
              "title": "Tracking specification document",
              "resource_type": "project_semantic",
              "entity_refs": ["entity://gravity/project@1"],
              "valid_time": {"start": null, "end": null, "timezone": "Asia/Shanghai"},
              "effective_range": {"start": null, "end": null},
              "sensitivity": "internal",
              "citation_path": "lark-cli/docs/fetch"
            },
            "failure_rules": [],
            "freshness": null
          }
        ],
        "guidance": {
          "source_unavailable": {
            "missing": "lark-cli executable, login, or network access",
            "message": "The external command source is currently unavailable; no empty-data claim was produced.",
            "user_actions": [
              "Install lark-cli and run `lark-cli doctor`.",
              "Run `lark-cli auth status --json --verify`; if needed, use `lark-cli auth login` with the domain or exact scope reported by lark-cli."
            ]
          },
          "resource_unavailable": {
            "missing": "the requested Base table or document",
            "message": "The requested external resource is missing or inaccessible; no empty-data claim was produced.",
            "user_actions": [
