    "max_calls_per_session": 32,
    "timeout_ms": 30000,
    "cancellation_grace_ms": 1000,
    "max_attempts": 1,
    "max_output_bytes": 1048576,
    "max_output_tokens": 1048576,
    "circuit_failure_threshold": 2,
    "circuit_cooldown_ms": 30000
  },
  "deployment": {
    "sandbox_owner": "gravity-runtime/context-command",
    "declared_egress_hosts": ["open.feishu.cn:443"],
