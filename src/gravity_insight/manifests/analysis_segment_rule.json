            "Manual",
            "Routine"
          ],
          "type": "string"
        },
        "user_event_rules": {
          "default": {
            "cond_logic": "AND",
            "groups": []
          },
          "max_depth": 12,
          "type": "object"
        },
        "user_property_rules": {
          "default": {
            "cond_logic": "AND",
            "groups": []
          },
          "max_depth": 10,
          "type": "object"
        }
      },
      "live_probe": {
